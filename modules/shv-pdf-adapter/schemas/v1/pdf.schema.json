{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ExtractInput": {
      "type": "object",
      "properties": {
        "source_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "path",
            "bytes",
            "digest"
          ],
          "additionalProperties": false
        },
        "decoder_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "decoder": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "digest"
          ],
          "additionalProperties": false
        },
        "profile": {
          "const": "amd-69290-table8.v1"
        }
      },
      "required": [
        "source_root",
        "source",
        "decoder_root",
        "decoder",
        "profile"
      ],
      "additionalProperties": false
    },
    "Extraction": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "symphony.shv.pdf-extraction.v1"
        },
        "profile": {
          "const": "amd-69290-table8.v1"
        },
        "source": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "path",
            "bytes",
            "digest"
          ],
          "additionalProperties": false
        },
        "decoder": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "digest"
          ],
          "additionalProperties": false
        },
        "page_index": {
          "const": 12
        },
        "page_count": {
          "const": 16
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072
        },
        "text_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rows": {
          "type": "array",
          "minItems": 28,
          "maxItems": 28,
          "items": {
            "type": "object",
            "properties": {
              "opn": {
                "type": "string",
                "pattern": "^100-[0-9]{9}$"
              },
              "model": {
                "type": "string",
                "pattern": "^[0-9A-Z]{4,8}$"
              },
              "source_metric_text": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$"
              }
            },
            "required": [
              "opn",
              "model",
              "source_metric_text"
            ],
            "additionalProperties": false
          }
        },
        "namespace": {
          "const": "AMD.OPN"
        },
        "namespace_equivalence": {
          "const": "not_asserted"
        },
        "documentary_lineages": {
          "const": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocol",
        "profile",
        "source",
        "decoder",
        "page_index",
        "page_count",
        "text",
        "text_digest",
        "rows",
        "namespace",
        "namespace_equivalence",
        "documentary_lineages",
        "digest"
      ],
      "additionalProperties": false
    },
    "VerificationInput": {
      "type": "object",
      "properties": {
        "request": {
          "type": "object",
          "properties": {
            "source_root": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "source": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]{1,128}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1048576
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "id",
                "path",
                "bytes",
                "digest"
              ],
              "additionalProperties": false
            },
            "decoder_root": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "decoder": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "digest"
              ],
              "additionalProperties": false
            },
            "profile": {
              "const": "amd-69290-table8.v1"
            }
          },
          "required": [
            "source_root",
            "source",
            "decoder_root",
            "decoder",
            "profile"
          ],
          "additionalProperties": false
        },
        "artifact": {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "symphony.shv.pdf-extraction.v1"
            },
            "profile": {
              "const": "amd-69290-table8.v1"
            },
            "source": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]{1,128}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1048576
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "id",
                "path",
                "bytes",
                "digest"
              ],
              "additionalProperties": false
            },
            "decoder": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "digest"
              ],
              "additionalProperties": false
            },
            "page_index": {
              "const": 12
            },
            "page_count": {
              "const": 16
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 131072
            },
            "text_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "opn": {
                    "type": "string",
                    "pattern": "^100-[0-9]{9}$"
                  },
                  "model": {
                    "type": "string",
                    "pattern": "^[0-9A-Z]{4,8}$"
                  },
                  "source_metric_text": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+$"
                  }
                },
                "required": [
                  "opn",
                  "model",
                  "source_metric_text"
                ],
                "additionalProperties": false
              }
            },
            "namespace": {
              "const": "AMD.OPN"
            },
            "namespace_equivalence": {
              "const": "not_asserted"
            },
            "documentary_lineages": {
              "const": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "protocol",
            "profile",
            "source",
            "decoder",
            "page_index",
            "page_count",
            "text",
            "text_digest",
            "rows",
            "namespace",
            "namespace_equivalence",
            "documentary_lineages",
            "digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request",
        "artifact"
      ],
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 32
        },
        "properties": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "labels",
        "properties"
      ],
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "properties": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "label",
        "properties"
      ],
      "additionalProperties": false
    },
    "Graph": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "symphony.graph.exchange.v1"
        },
        "owner": {
          "type": "object",
          "properties": {
            "engine_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "engine_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "artifact_protocol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "artifact_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "engine_id",
            "engine_version",
            "artifact_protocol",
            "artifact_digest"
          ],
          "additionalProperties": false
        },
        "owner_artifact": {
          "type": "object",
          "required": [
            "protocol",
            "digest"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 1024
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 2048
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocol",
        "owner",
        "owner_artifact",
        "nodes",
        "edges",
        "digest"
      ],
      "additionalProperties": false
    },
    "GraphProjectInput": {
      "$ref": "#/$defs/ExtractInput"
    },
    "GraphValidateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "graph"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/ExtractInput"
        },
        "graph": {
          "$ref": "#/$defs/Graph"
        }
      }
    },
    "PDFGraphValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "graph_digest",
        "derivation_digest",
        "replayed",
        "documentary_lineages",
        "digest"
      ],
      "properties": {
        "protocol": {
          "const": "symphony.shv.pdf-graph-validation.v1"
        },
        "graph_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "derivation_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "replayed": {
          "const": true
        },
        "documentary_lineages": {
          "const": 1
        }
      }
    }
  }
}
