{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "symphony.sbv.node-stream.v1",
  "description": "One NDJSON record; complete requires ordered source-bound preorder value nodes and full logical closure.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "begin"
        },
        "protocol": {
          "const": "symphony.sbv.node-stream.v1"
        },
        "reference": {
          "type": "object",
          "properties": {
            "manifest_path": {
              "type": "string",
              "minLength": 2,
              "maxLength": 4096,
              "pattern": "^/",
              "description": "Absolute clean component-wise no-follow path; native validation rejects controls, symlinks and unsafe components."
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "manifest_path",
            "manifest_sha256",
            "content_sha256"
          ],
          "additionalProperties": false
        },
        "logical_protocol": {
          "const": "symphony.sbv.result.v1"
        },
        "order": {
          "const": "canonical_preorder_values.v1"
        },
        "source_authorship": {
          "const": "not_verified"
        },
        "expected_value_nodes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "description": "Canonical uint64 decimal; checked range at native and control boundary."
        }
      },
      "required": [
        "event",
        "protocol",
        "reference",
        "logical_protocol",
        "order",
        "source_authorship",
        "expected_value_nodes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "node"
        },
        "node_id": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "description": "Canonical uint64 decimal; checked range at native and control boundary."
        },
        "parent_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 20,
              "description": "Canonical uint64 decimal; checked range at native and control boundary."
            },
            {
              "type": "null"
            }
          ]
        },
        "edge": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "object",
            "array",
            "scalar"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "maxProperties": 0
            },
            {
              "type": "array",
              "maxItems": 0
            },
            {
              "type": "string",
              "maxLength": 65536
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "description": "Canonical uint64 decimal; checked range at native and control boundary."
        }
      },
      "required": [
        "event",
        "node_id",
        "parent_id",
        "edge",
        "kind",
        "value",
        "children"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "end"
        },
        "status": {
          "const": "complete"
        },
        "nodes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "description": "Canonical uint64 decimal; checked range at native and control boundary."
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "event",
        "status",
        "nodes",
        "content_sha256",
        "manifest_sha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "end"
        },
        "status": {
          "const": "error"
        },
        "nodes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "description": "Canonical uint64 decimal; checked range at native and control boundary."
        },
        "code": {
          "enum": [
            "export_integrity_failed",
            "export_read_failed",
            "export_cancelled"
          ]
        }
      },
      "required": [
        "event",
        "status",
        "nodes",
        "code"
      ],
      "additionalProperties": false
    }
  ]
}
