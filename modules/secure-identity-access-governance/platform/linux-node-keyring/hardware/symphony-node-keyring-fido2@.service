[Unit]
Description=Verify the FIDO2-enrolled Symphony keyring volume for UID %i
BindsTo=var-lib-symphony-nodevault.mount
After=var-lib-symphony-nodevault.mount
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/symphony/libexec/symphony/ssiag-node-keyring/0.1.1-dev/symphony-node-keyring-fido2 %i
TimeoutStartSec=15
NoNewPrivileges=yes
