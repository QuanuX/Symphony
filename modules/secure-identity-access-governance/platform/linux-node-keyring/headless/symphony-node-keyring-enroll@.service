[Unit]
Description=Initialize an empty Symphony node keyring for service UID %i
After=local-fs.target
RequiresMountsFor=/etc/credstore.encrypted

[Service]
Type=oneshot
User=%i
UMask=0077
LoadCredentialEncrypted=vault-unlock:/etc/credstore.encrypted/symphony-node-keyring-%i.cred
RuntimeDirectory=symphony-node-keyring-%i
RuntimeDirectoryMode=0700
ExecStart=/opt/symphony/libexec/symphony/ssiag-node-keyring/0.1.1-dev/symphony-node-keyring-session enroll %i
TimeoutStartSec=25s
TimeoutStopSec=10s
KillMode=mixed
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
