#!/usr/bin/python3 -I
"""Select an exact staged generation in an existing node-owned binding."""

import contextlib
import fcntl
import os
import re
import stat
import sys
import uuid


UUID = rb"[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}"
FORMAT = re.compile(
    rb"SYMPHONY-NODE-KEYRING-1\nuid=([1-9][0-9]{0,9})\nbus_socket=(/[^\x00\r\n\t]{1,106})\n"
    rb"collection=(/org/freedesktop/secrets/collection/[a-zA-Z0-9_]+)\ntops=" + UUID +
    rb"\nreference=" + UUID + rb"\ngeneration=(?P<generation>" + UUID +
    rb")\nmaximum_bytes=([1-9][0-9]{0,3})\n"
)
SAFE = os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
LIMIT = 2048


def directory_fd(path):
    parts = path.split("/")
    if not path.startswith("/") or len(os.fsencode(path)) > 4096 or any(x in ("", ".", "..") for x in parts[1:]):
        raise ValueError
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | SAFE)
    try:
        for part in parts[1:-1]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | SAFE, dir_fd=fd)
            os.close(fd)
            fd = child
            info = os.fstat(fd)
            if info.st_uid or info.st_mode & 0o022:
                raise ValueError
        return fd, parts[-1]
    except BaseException:
        os.close(fd)
        raise


def attributes(fd):
    # Refuse files with nonstandard ACLs, capabilities, immutable content
    # digests, or other attributes that a simple atomic replacement would lose.
    names = os.listxattr(fd)
    if any(name != "security.selinux" for name in names):
        raise ValueError
    return {name: os.getxattr(fd, name) for name in names}


def activate(path, expected, replacement):
    if os.getuid() or os.geteuid() or not all(re.fullmatch(UUID, x) for x in (expected, replacement)):
        return "REFUSED", 1
    directory, name = directory_fd(path)
    with contextlib.ExitStack() as cleanup:
        cleanup.callback(os.close, directory)
        # A file lock on the old inode would stop protecting writers on rename.
        # Lock the stable parent directory for all activations of its bindings.
        fcntl.flock(directory, fcntl.LOCK_EX)
        original = os.open(name, os.O_RDONLY | SAFE, dir_fd=directory)
        cleanup.callback(os.close, original)
        info = os.fstat(original)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1 or
                info.st_mode & 0o7022 or not 0 < info.st_size <= LIMIT):
            return "REFUSED", 1
        raw = os.pread(original, LIMIT + 1, 0)
        fields = FORMAT.fullmatch(raw)
        if (len(raw) != info.st_size or not fields or int(fields[1]) >= 2**32 - 1 or
                len(fields[3]) > 512 or int(fields[5]) > 4096):
            return "REFUSED", 1
        if fields["generation"] == replacement:
            try:
                os.fsync(original)
                os.fsync(directory)
            except OSError:
                return "UNCERTAIN", 2
            return "ALREADY_ACTIVE " + replacement.decode(), 0
        if fields["generation"] != expected:
            return "STALE", 3
        original_attributes = attributes(original)
        begin, end = fields.span("generation")
        updated = raw[:begin] + replacement + raw[end:]
        temporary = ".symphony-keyring-" + uuid.uuid4().hex + ".tmp"
        staged = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_RDWR | SAFE, 0o600, dir_fd=directory)
        cleanup.callback(os.close, staged)
        renamed = False
        try:
            os.fchown(staged, info.st_uid, info.st_gid)
            os.fchmod(staged, stat.S_IMODE(info.st_mode))
            if attributes(staged) != original_attributes:
                return "REFUSED", 1
            if os.write(staged, updated) != len(updated):
                return "REFUSED", 1
            os.fsync(staged)
            current = os.stat(name, dir_fd=directory, follow_symlinks=False)
            if not os.path.samestat(current, info) or current.st_ctime_ns != info.st_ctime_ns:
                return "STALE", 3
            os.replace(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
            renamed = True
            try:
                os.fsync(directory)
            except OSError:
                return "UNCERTAIN", 2
            return "ACTIVE " + replacement.decode(), 0
        finally:
            if not renamed:
                os.unlink(temporary, dir_fd=directory)


def main():
    if len(sys.argv) != 4:
        print("usage: symphony-node-keyring-activate ABSOLUTE_BINDING EXPECTED_GENERATION NEW_GENERATION", file=sys.stderr)
        return 1
    try:
        message, code = activate(sys.argv[1], sys.argv[2].encode("ascii"), sys.argv[3].encode("ascii"))
    except (OSError, ValueError):
        message, code = "REFUSED", 1
    print(message)
    return code


if __name__ == "__main__":
    sys.exit(main())
