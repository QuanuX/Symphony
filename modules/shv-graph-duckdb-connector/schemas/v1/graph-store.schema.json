{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "symphony.shv.graph-store.schema.v1",
  "$defs": {
    "Node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 32
        },
        "properties": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "labels",
        "properties"
      ],
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "properties": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "label",
        "properties"
      ],
      "additionalProperties": false
    },
    "Graph": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "symphony.graph.exchange.v1"
        },
        "owner": {
          "type": "object",
          "properties": {
            "engine_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "engine_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "artifact_protocol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "artifact_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "engine_id",
            "engine_version",
            "artifact_protocol",
            "artifact_digest"
          ],
          "additionalProperties": false
        },
        "owner_artifact": {
          "type": "object",
          "required": [
            "protocol",
            "digest"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 1024
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 2048
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocol",
        "owner",
        "owner_artifact",
        "nodes",
        "edges",
        "digest"
      ],
      "additionalProperties": false
    },
    "InspectInput": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "RoundtripInput": {
      "type": "object",
      "properties": {
        "graph": {
          "$ref": "#/$defs/Graph"
        }
      },
      "required": [
        "graph"
      ],
      "additionalProperties": false
    },
    "QueryInput": {
      "type": "object",
      "properties": {
        "tops_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "nodes",
            "edges"
          ]
        },
        "filters": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "from": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "to": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "additionalProperties": false
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      },
      "required": [
        "tops_id",
        "namespace",
        "snapshot_digest",
        "kind",
        "filters",
        "cursor",
        "limit"
      ],
      "additionalProperties": false
    },
    "AdapterResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "symphony.graph.adapter-result.v1"
            },
            "backend": {
              "const": "portable-reference"
            },
            "operation": {
              "const": "roundtrip"
            },
            "graph": {
              "$ref": "#/$defs/Graph"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "protocol",
            "backend",
            "operation",
            "graph",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "symphony.graph.adapter-result.v1"
            },
            "backend": {
              "const": "portable-reference"
            },
            "operation": {
              "const": "query"
            },
            "graph_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "kind": {
              "enum": [
                "nodes",
                "edges"
              ]
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "maxItems": 2048
            },
            "rows": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/Node"
                  },
                  {
                    "$ref": "#/$defs/Edge"
                  }
                ]
              },
              "maxItems": 2048
            },
            "missing_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "maxItems": 2048
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "protocol",
            "backend",
            "operation",
            "graph_digest",
            "kind",
            "ids",
            "rows",
            "missing_ids",
            "digest"
          ],
          "additionalProperties": false
        }
      ]
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z.+-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "featureId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^ssfv:[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "operationId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^engop:[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_operation_id",
        "operation_name",
        "availability",
        "feature_ids",
        "administrative_interactions",
        "administration_disposition",
        "input_protocol",
        "output_protocol",
        "mutability",
        "idempotency",
        "expected_state_required",
        "authorization_requirement",
        "recovery_operation_id",
        "direct_invocation",
        "thermal_path"
      ],
      "properties": {
        "engine_operation_id": {
          "$ref": "#/$defs/operationId"
        },
        "operation_name": {
          "$ref": "#/$defs/token"
        },
        "availability": {
          "enum": [
            "implemented",
            "reserved",
            "disabled"
          ]
        },
        "feature_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/featureId"
          }
        },
        "administrative_interactions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/interaction"
          }
        },
        "administration_disposition": {
          "enum": [
            "unreviewed",
            "qxctl_required",
            "lifecycle_only",
            "runtime_only",
            "system_orchestrated",
            "prohibited",
            "not_applicable"
          ]
        },
        "input_protocol": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/token"
            }
          ]
        },
        "output_protocol": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/token"
            }
          ]
        },
        "mutability": {
          "enum": [
            "read_only",
            "evidence_only",
            "proposal_only",
            "permission_backed_mutation",
            "prohibited"
          ]
        },
        "idempotency": {
          "enum": [
            "not_applicable",
            "idempotent",
            "idempotent_with_invocation_id",
            "non_idempotent"
          ]
        },
        "expected_state_required": {
          "type": "boolean"
        },
        "authorization_requirement": {
          "enum": [
            "none",
            "target_host_permission",
            "ssiag"
          ]
        },
        "recovery_operation_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/operationId"
            }
          ]
        },
        "direct_invocation": {
          "enum": [
            "supported",
            "diagnostic_only",
            "prohibited"
          ]
        },
        "thermal_path": {
          "enum": [
            "freezing",
            "warm",
            "hot"
          ]
        }
      }
    },
    "interaction": {
      "enum": [
        "discover",
        "inspect",
        "query",
        "validate",
        "configure",
        "propose",
        "invoke",
        "apply",
        "lifecycle",
        "recover"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_bytes",
        "response_bytes",
        "json_depth",
        "json_values",
        "path_bytes",
        "snapshot_files",
        "snapshot_file_bytes",
        "deadline_ahead_ms"
      ],
      "properties": {
        "request_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "json_depth": {
          "type": "integer",
          "minimum": 1
        },
        "json_values": {
          "type": "integer",
          "minimum": 1
        },
        "path_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_files": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "deadline_ahead_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Descriptor": {
      "title": "Symphony knowledge engine descriptor v2",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "format_version",
        "module_id",
        "engine_id",
        "vector_id",
        "engine_version",
        "process_protocols",
        "contract_versions",
        "operations",
        "limits",
        "supported_scopes",
        "language",
        "thermal_path",
        "canonical_apply_enabled",
        "session_mutation_enabled",
        "network_listener",
        "descriptor_digest"
      ],
      "properties": {
        "protocol": {
          "const": "symphony.knowledge.engine-descriptor.v2"
        },
        "format_version": {
          "const": 2
        },
        "module_id": {
          "$ref": "#/$defs/token"
        },
        "engine_id": {
          "$ref": "#/$defs/token"
        },
        "vector_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/token"
            }
          ]
        },
        "engine_version": {
          "$ref": "#/$defs/version"
        },
        "process_protocols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "contract_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "supported_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "user",
              "system",
              "tops"
            ]
          }
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9+.#_-]+$"
        },
        "thermal_path": {
          "enum": [
            "freezing",
            "warm",
            "hot"
          ]
        },
        "canonical_apply_enabled": {
          "type": "boolean"
        },
        "session_mutation_enabled": {
          "type": "boolean"
        },
        "network_listener": {
          "type": "boolean"
        },
        "descriptor_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "Installation": {
      "type": "object",
      "properties": {
        "Role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "ModuleID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "EngineID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "Version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "Prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "ReceiptPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "ReceiptDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "ReceiptProtocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "ExecutablePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "ExecutableDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "Role",
        "ModuleID",
        "EngineID",
        "Version",
        "Prefix",
        "ReceiptPath",
        "ReceiptDigest",
        "ReceiptProtocol",
        "ExecutablePath",
        "ExecutableDigest"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "symphony.shv.graph-store-snapshot.v1"
        },
        "backend": {
          "const": "duckdb"
        },
        "mapping_version": {
          "const": "1"
        },
        "tops_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "graph": {
          "$ref": "#/$defs/Graph"
        },
        "connector": {
          "$ref": "#/$defs/Installation"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocol",
        "backend",
        "mapping_version",
        "tops_id",
        "namespace",
        "graph",
        "connector",
        "digest"
      ],
      "additionalProperties": false
    },
    "Intent": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "symphony.shv.graph-store-intent.v1"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocol",
        "operation_id",
        "snapshot",
        "digest"
      ],
      "additionalProperties": false
    },
    "PrepareInput": {
      "type": "object",
      "properties": {
        "tops_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "graph": {
          "$ref": "#/$defs/Graph"
        },
        "connector": {
          "$ref": "#/$defs/Installation"
        }
      },
      "required": [
        "tops_id",
        "namespace",
        "operation_id",
        "graph",
        "connector"
      ],
      "additionalProperties": false
    },
    "CommitInput": {
      "type": "object",
      "properties": {
        "tops_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "expected_intent_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "tops_id",
        "namespace",
        "operation_id",
        "expected_intent_digest"
      ],
      "additionalProperties": false
    },
    "StatusInput": {
      "type": "object",
      "properties": {
        "tops_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        }
      },
      "required": [
        "tops_id",
        "namespace",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "ExportInput": {
      "type": "object",
      "properties": {
        "tops_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "tops_id",
        "namespace",
        "snapshot_digest"
      ],
      "additionalProperties": false
    },
    "Cursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "query_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "after_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "query_digest",
            "after_key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Status": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "symphony.shv.graph-store-status.v1"
        },
        "backend": {
          "const": "duckdb"
        },
        "projection_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "counts": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "edges": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            }
          },
          "required": [
            "nodes",
            "edges"
          ],
          "additionalProperties": false
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "state": {
          "enum": [
            "prepared",
            "committed"
          ]
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "index_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "protocol",
        "backend",
        "projection_digest",
        "counts",
        "digest",
        "intent",
        "state",
