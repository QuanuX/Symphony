{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "protocol": "symphony.sqav.administration-schemas.v1",
  "requests": {
    "attempts_inspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "store",
        "offset",
        "limit"
      ],
      "properties": {
        "protocol": {
          "const": "symphony.sqav.attempts-inspect-input.v1"
        },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "expected_metadata_reference",
            "expected_store_generation",
            "max_read_bytes",
            "max_batches"
          ],
          "properties": {
            "root": {
              "type": "string",
              "minLength": 2,
              "maxLength": 4096
            },
            "expected_metadata_reference": {
              "type": "string",
              "maxLength": 128
            },
            "expected_store_generation": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "max_read_bytes": {
              "type": "string",
              "format": "uint64-decimal",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
            },
            "max_batches": {
              "type": "string",
              "format": "uint64-decimal",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
            }
          }
        },
        "offset": {
          "type": "string",
          "format": "uint64-decimal",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
        },
        "limit": {
          "type": "string",
          "format": "uint64-decimal",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
        }
      }
    }
  },
  "results": {
    "attempts_inspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "operation",
        "owner",
        "request_digest",
        "data",
        "provider_observation",
        "persistent_mutation",
        "result_digest"
      ],
      "properties": {
        "protocol": {
          "const": "symphony.sqav.attempts-inspect.v1"
        },
        "operation": {
          "const": "attempts_inspect"
        },
        "owner": {
          "const": "sqav"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "store",
            "attempts",
            "unresolved",
            "ceiling_nano_usd",
            "prior_charge_nano_usd",
            "charged_ceiling_nano_usd",
            "remaining_nano_usd",
            "offset",
            "entries",
            "next_offset",
            "accounting_scope",
            "execution_capability",
            "actual_provider_cost"
          ],
          "properties": {
            "store": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "integrity_scope",
                "metadata_reference",
                "store_generation",
                "producer_generation",
                "partition_hex_chunks",
                "committed_batches",
                "next_sequence",
                "sequence_exhausted",
                "physical_bytes",
                "head_commit_sha256",
                "tail_validated"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "clean",
                    "recovery_required"
                  ]
                },
                "integrity_scope": {
                  "type": "string",
                  "enum": [
                    "all_retained_frames",
                    "published_head_prefix_only"
                  ]
                },
                "metadata_reference": {
                  "type": "string",
                  "maxLength": 128
                },
                "store_generation": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "producer_generation": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "partition_hex_chunks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})+$",
                    "maxLength": 32768
                  },
                  "description": "Consecutive 16384-byte chunks; only the final chunk may be shorter."
                },
                "committed_batches": {
                  "type": "string",
                  "format": "uint64-decimal",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
                },
                "next_sequence": {
                  "type": "string",
                  "format": "uint64-decimal",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
                },
                "sequence_exhausted": {
                  "type": "boolean"
                },
                "physical_bytes": {
                  "type": "string",
                  "format": "uint64-decimal",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
                },
                "head_commit_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "tail_validated": {
                  "type": "boolean"
                }
              }
            },
            "attempts": {
              "type": "string",
              "format": "uint64-decimal",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
            },
            "unresolved": {
              "type": "string",
              "format": "uint64-decimal",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
            },
            "ceiling_nano_usd": {
              "type": "string",
              "format": "uint64-decimal",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
            },
            "prior_charge_nano_usd": {
              "type": "string",
              "format": "uint64-decimal",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
            },
            "charged_ceiling_nano_usd": {
              "type": "string",
              "format": "uint64-decimal",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
            },
            "remaining_nano_usd": {
              "type": "string",
              "format": "uint64-decimal",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
            },
            "offset": {
              "type": "string",
              "format": "uint64-decimal",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "attempt_id",
                  "request_reference",
                  "reserved_ceiling_nano_usd",
                  "ordinal",
                  "maximum",
                  "persisted_outcome",
                  "restart_outcome"
                ],
                "properties": {
                  "attempt_id": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$",
                    "maxLength": 8192,
                    "description": "Exact opaque bytes as lower-case hexadecimal."
                  },
                  "request_reference": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "reserved_ceiling_nano_usd": {
                    "type": "string",
                    "format": "uint64-decimal",
                    "pattern": "^(0|[1-9][0-9]{0,19})$",
                    "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
                  },
                  "ordinal": {
                    "type": "string",
                    "format": "uint64-decimal",
                    "pattern": "^(0|[1-9][0-9]{0,19})$",
                    "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
                  },
                  "maximum": {
                    "type": "string",
                    "format": "uint64-decimal",
                    "pattern": "^(0|[1-9][0-9]{0,19})$",
                    "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
                  },
                  "persisted_outcome": {
                    "type": "string",
                    "enum": [
                      "reserved",
                      "completed",
                      "rejected",
                      "cancelled",
                      "indeterminate"
                    ]
                  },
                  "restart_outcome": {
                    "type": "string",
                    "enum": [
                      "completed",
                      "rejected",
                      "cancelled",
                      "indeterminate"
                    ]
                  }
                }
              },
              "maxItems": 128
            },
            "next_offset": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uint64-decimal",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "description": "Canonical unsigned decimal, at most UINT64_MAX; native owner checks all semantic limits."
                },
                {
                  "type": "null"
                }
              ]
            },
            "accounting_scope": {
              "type": "string",
              "enum": [
                "conservative_reserved_ceilings"
              ]
            },
            "execution_capability": {
              "type": "string",
              "enum": [
                "not_issued"
              ]
            },
            "actual_provider_cost": {
              "type": "string",
              "enum": [
                "not_observed"
              ]
            }
          }
        },
        "provider_observation": {
          "const": "not_performed"
        },
        "persistent_mutation": {
          "const": false
        },
        "result_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
