{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scnv.names.v1",
  "title": "SCNV exact association validation and proposed transition",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "scnv.names.v1"
        },
        "mode": {
          "const": "records"
        },
        "records": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "coverage": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "required": [
        "protocol",
        "mode",
        "records",
        "coverage",
        "limits"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "scnv.names.v1"
        },
        "mode": {
          "const": "transition"
        },
        "records": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "coverage": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Exact valid UTF-8 bytes, at most 64 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
            },
            "comparison": {
              "const": "utf8_bytes"
            },
            "scope": {
              "const": "exact_scope"
            },
            "collision": {
              "const": "report"
            },
            "interval": {
              "const": "half_open"
            }
          },
          "required": [
            "id",
            "version",
            "comparison",
            "scope",
            "collision",
            "interval"
          ]
        },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": [
                "assign",
                "correct",
                "retire",
                "reuse",
                "restore"
              ]
            },
            "expected_evidence_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "new_record": {
              "$ref": "#/$defs/record"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "Exact valid UTF-8 bytes, at most 1024 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
            }
          },
          "required": [
            "action",
            "expected_evidence_digest",
            "new_record",
            "reason"
          ]
        }
      },
      "required": [
        "protocol",
        "mode",
        "records",
        "coverage",
        "limits",
        "policy",
        "intent"
      ]
    }
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "node",
            "incarnation",
            "resource",
            "cluster",
            "relationship"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "tops",
            "trog",
            "cluster"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "provider",
            "infrastructure",
            "symphony",
            "user",
            "observation"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        },
        "association_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        },
        "kind": {
          "enum": [
            "assignment",
            "correction",
            "retirement",
            "reuse",
            "restoration"
          ]
        },
        "previous_record_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
            },
            {
              "type": "null"
            }
          ]
        },
        "origin_record_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Exact valid UTF-8 bytes, at most 512 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        },
        "name_kind": {
          "enum": [
            "provider_resource_id",
            "provider_offering_name",
            "infrastructure_name",
            "node_identity",
            "cluster_name",
            "user_nickname",
            "short_name",
            "resource_name",
            "incarnation_name",
            "relationship_name",
            "external_name"
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from_unix_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "until_unix_ms": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "from_unix_ms",
            "until_unix_ms"
          ]
        },
        "observed_unix_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recorded_unix_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "record_id",
        "association_id",
        "kind",
        "previous_record_id",
        "origin_record_id",
        "subject",
        "name",
        "name_kind",
        "namespace",
        "source",
        "scope",
        "interval",
        "observed_unix_ms",
        "recorded_unix_ms"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_records": {
          "enum": [
            512,
            1024,
            2048
          ]
        }
      },
      "required": [
        "max_records"
      ]
    }
  },
  "description": "Native admission additionally enforces byte lengths, clean UTF-8, temporal ordering, immutable lineage and exact expected evidence digest. Unknown fields are rejected."
}
