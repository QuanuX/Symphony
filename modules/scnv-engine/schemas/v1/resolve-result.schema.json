{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scnv.resolve-result.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owner": {
      "const": "scnv"
    },
    "owner_version": {
      "const": "0.1.0-dev"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_ids": {
      "type": "array",
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "comparison": {
      "const": "utf8_bytes"
    },
    "coverage": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "protocol": {
      "const": "scnv.resolve-result.v1"
    },
    "mode": {
      "enum": [
        "exact",
        "scoped_candidates"
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "exact",
            "scoped_candidates"
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Exact valid UTF-8 bytes, at most 512 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "description": "Exact valid UTF-8 bytes, at most 32 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
            },
            {
              "type": "null"
            }
          ]
        },
        "name_kind": {
          "anyOf": [
            {
              "enum": [
                "provider_resource_id",
                "provider_offering_name",
                "infrastructure_name",
                "node_identity",
                "cluster_name",
                "user_nickname",
                "short_name",
                "resource_name",
                "incarnation_name",
                "relationship_name",
                "external_name"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of_unix_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "expected_evidence_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "name",
        "scope",
        "namespace",
        "name_kind",
        "as_of_unix_ms",
        "offset",
        "limit",
        "expected_evidence_digest"
      ]
    },
    "status": {
      "enum": [
        "unique",
        "absent",
        "ambiguous",
        "insufficient",
        "unsupported_scope",
        "candidates"
      ]
    },
    "resolved_subject": {
      "anyOf": [
        {
          "$ref": "#/$defs/subject"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolution_binding": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "const": "scnv.resolution-binding.v1"
            },
            "owner": {
              "const": "scnv"
            },
            "owner_version": {
              "const": "0.1.0-dev"
            },
            "subject": {
              "$ref": "#/$defs/subject"
            },
            "scope": {
              "$ref": "#/$defs/scope"
            },
            "as_of_unix_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "evidence_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "record_ids": {
              "type": "array",
              "maxItems": 2048,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "binding_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "protocol",
            "owner",
            "owner_version",
            "subject",
            "scope",
            "as_of_unix_ms",
            "evidence_digest",
            "record_ids",
            "binding_digest"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "candidates": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
          },
          "association_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
          },
          "subject": {
            "$ref": "#/$defs/subject"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Exact valid UTF-8 bytes, at most 512 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
          },
          "name_kind": {
            "enum": [
              "provider_resource_id",
              "provider_offering_name",
              "infrastructure_name",
              "node_identity",
              "cluster_name",
              "user_nickname",
              "short_name",
              "resource_name",
              "incarnation_name",
              "relationship_name",
              "external_name"
            ]
          },
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "scope": {
            "$ref": "#/$defs/scope"
          },
          "interval": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from_unix_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "until_unix_ms": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "from_unix_ms",
              "until_unix_ms"
            ]
          }
        },
        "required": [
          "record_id",
          "association_id",
          "subject",
          "name",
          "name_kind",
          "namespace",
          "source",
          "scope",
          "interval"
        ]
      }
    },
    "match_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2048
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "owner",
    "owner_version",
    "source_digest",
    "subject_ids",
    "evidence_digest",
    "comparison",
    "coverage",
    "protocol",
    "mode",
    "query",
    "status",
    "resolved_subject",
    "resolution_binding",
    "candidates",
    "match_count",
    "next_offset"
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "node",
            "incarnation",
            "resource",
            "cluster",
            "relationship"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "tops",
            "trog",
            "cluster"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "provider",
            "infrastructure",
            "symphony",
            "user",
            "observation"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        },
        "association_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        },
        "kind": {
          "enum": [
            "assignment",
            "correction",
            "retirement",
            "reuse",
            "restoration"
          ]
        },
        "previous_record_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
            },
            {
              "type": "null"
            }
          ]
        },
        "origin_record_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Exact valid UTF-8 bytes, at most 512 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        },
        "name_kind": {
          "enum": [
            "provider_resource_id",
            "provider_offering_name",
            "infrastructure_name",
            "node_identity",
            "cluster_name",
            "user_nickname",
            "short_name",
            "resource_name",
            "incarnation_name",
            "relationship_name",
            "external_name"
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact valid UTF-8 bytes, at most 256 UTF-8 bytes; C0/C1/DEL controls forbidden. No normalization."
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from_unix_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "until_unix_ms": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "from_unix_ms",
            "until_unix_ms"
          ]
        },
        "observed_unix_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recorded_unix_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "record_id",
        "association_id",
        "kind",
        "previous_record_id",
        "origin_record_id",
        "subject",
        "name",
        "name_kind",
        "namespace",
        "source",
        "scope",
        "interval",
        "observed_unix_ms",
        "recorded_unix_ms"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_records": {
          "enum": [
            512,
            1024,
            2048
          ]
        }
      },
      "required": [
        "max_records"
      ]
    }
  }
}
