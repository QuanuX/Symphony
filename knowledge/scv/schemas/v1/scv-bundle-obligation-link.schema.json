{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:qxctl:scv-bundle-obligation-link:v2",
  "description": "Explicit bundled follow-up relationships over exact original direct or bundled exploration records. Descriptor correspondence, original-owner replay and fixed-problem semantics are runtime checks. Digests do not authenticate provenance.",
  "$defs": {
    "RetainInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_ref",
        "after_ref",
        "submissions",
        "transport",
        "protocol"
      ],
      "properties": {
        "before_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "after_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "submissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "obligation.schema.json#/$defs/Submission"
          }
        },
        "transport": {
          "const": "bundle"
        },
        "protocol": {
          "const": "symphony.qxctl.scv-obligation-link-request.v2"
        }
      }
    },
    "ShowInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_ref"
      ],
      "properties": {
        "link_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "Link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "root",
        "tops_id",
        "submissions_digest",
        "transport",
        "before",
        "after",
        "followup"
      ],
      "properties": {
        "protocol": {
          "const": "symphony.qxctl.scv-obligation-link.v2"
        },
        "root": {
          "type": "string"
        },
        "tops_id": {
          "type": "string"
        },
        "submissions_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "transport": {
          "const": "bundle"
        },
        "before": {
          "allOf": [
            {
              "$ref": "#/$defs/LogicalReference"
            },
            {
              "properties": {
                "logical_operation": {
                  "const": "composition_explore"
                }
              }
            }
          ]
        },
        "after": {
          "allOf": [
            {
              "$ref": "#/$defs/LogicalReference"
            },
            {
              "properties": {
                "logical_operation": {
                  "const": "composition_explore"
                }
              }
            }
          ]
        },
        "followup": {
          "allOf": [
            {
              "$ref": "#/$defs/LogicalReference"
            },
            {
              "properties": {
                "logical_operation": {
                  "const": "composition_followup"
                }
              }
            }
          ]
        }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "link_ref",
        "link",
        "followup_ref",
        "validation",
        "digest"
      ],
      "properties": {
        "protocol": {
          "const": "symphony.qxctl.scv-obligation-link-result.v2"
        },
        "link_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "link": {
          "$ref": "#/$defs/Link"
        },
        "followup_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "validation": {
          "const": "owner_replayed"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "LogicalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_ref",
        "logical_operation",
        "logical_protocol",
        "logical_digest",
        "artifact_digest",
        "transport"
      ],
      "properties": {
        "record_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "logical_operation": {
          "enum": [
            "composition_explore",
            "composition_reassess",
            "composition_obligations",
            "composition_followup"
          ]
        },
        "logical_protocol": {
          "enum": [
            "symphony.scv.composition-exploration.v1",
            "symphony.scv.composition-reassessment.v1",
            "symphony.scv.composition-obligations.v1",
            "symphony.scv.composition-followup.v1"
          ]
        },
        "logical_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "transport": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "result_bundle_digest",
                "result_root_digest"
              ],
              "properties": {
                "result_bundle_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "result_root_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "logical_operation": {
                "const": "composition_explore"
              }
            }
          },
          "then": {
            "properties": {
              "logical_protocol": {
                "const": "symphony.scv.composition-exploration.v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "logical_operation": {
                "const": "composition_reassess"
              }
            }
          },
          "then": {
            "properties": {
              "logical_protocol": {
                "const": "symphony.scv.composition-reassessment.v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "logical_operation": {
                "const": "composition_obligations"
              }
            }
          },
          "then": {
            "properties": {
              "logical_protocol": {
                "const": "symphony.scv.composition-obligations.v1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "logical_operation": {
                "const": "composition_followup"
              }
            }
          },
          "then": {
            "properties": {
              "logical_protocol": {
                "const": "symphony.scv.composition-followup.v1"
              }
            }
          }
        }
      ]
    }
  }
}
