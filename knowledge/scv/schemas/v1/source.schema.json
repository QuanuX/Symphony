{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:scv:source:v1",
  "title": "Source v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "source_id",
    "provider_id",
    "family_id",
    "publisher",
    "authority_role",
    "scope",
    "locators",
    "continuity_evidence",
    "generation",
    "predecessor_digest",
    "digest"
  ],
  "properties": {
    "protocol": {
      "const": "symphony.scv.source.v1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "family_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "authority_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "locators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator_id",
          "uri",
          "role",
          "format",
          "selector"
        ],
        "properties": {
          "locator_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "format": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "selector": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096
          }
        }
      },
      "maxItems": 16,
      "minItems": 1
    },
    "continuity_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 64,
      "minItems": 0
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "predecessor_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "description": "Semantic checks additionally enforce source lineage, unique locator IDs, domain scope, URI safety, UTF-8 byte bounds and exact omit-self digest.",
  "$defs": {
    "desired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "provider_id",
        "family_id",
        "publisher",
        "authority_role",
        "scope",
        "locators",
        "continuity_evidence"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "family_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "authority_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "locators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locator_id",
              "uri",
              "role",
              "format",
              "selector"
            ],
            "properties": {
              "locator_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "uri": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "format": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "selector": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              }
            }
          },
          "maxItems": 16,
          "minItems": 1
        },
        "continuity_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 64,
          "minItems": 0
        }
      }
    }
  }
}
