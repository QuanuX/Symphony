{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:scv:interpretation-input:v1",
  "title": "Interpretation Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "captures",
    "claims",
    "interpreter_version",
    "selection_policy"
  ],
  "properties": {
    "captures": {
      "type": "array",
      "items": {
        "$ref": "capture.schema.json"
      },
      "maxItems": 16,
      "minItems": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "maxItems": 128,
      "minItems": 0
    },
    "interpreter_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "selection_policy": {
      "$ref": "#/$defs/selectionPolicy"
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "subject",
        "predicate",
        "value",
        "scope",
        "statement_kind",
        "evidence",
        "dependencies"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "const": "string"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "const": "reference"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "const": "boolean"
                },
                "value": {
                  "type": "boolean"
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "const": "integer"
                },
                "value": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "const": "decimal"
                },
                "value": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
                  "not": {
                    "const": "-0"
                  }
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  ]
                }
              }
            }
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 512
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxProperties": 16
        },
        "statement_kind": {
          "enum": [
            "documented_fact",
            "requirement",
            "recommendation",
            "observation",
            "user_assertion",
            "inference",
            "hypothesis"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capture_digest",
              "quote"
            ],
            "properties": {
              "capture_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          "maxItems": 16,
          "minItems": 0
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "role"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "role": {
                "enum": [
                  "support",
                  "requires",
                  "scope"
                ]
              }
            }
          },
          "maxItems": 16,
          "minItems": 0
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            }
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            }
          ]
        },
        "alternative_supports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "support_id",
              "evidence",
              "dependencies"
            ],
            "properties": {
              "support_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "capture_digest",
                    "quote"
                  ],
                  "properties": {
                    "capture_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  }
                },
                "maxItems": 16,
                "minItems": 0
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "claim_id",
                    "role"
                  ],
                  "properties": {
                    "claim_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "role": {
                      "enum": [
                        "support",
                        "requires",
                        "scope"
                      ]
                    }
                  }
                },
                "maxItems": 16,
                "minItems": 0
              }
            }
          },
          "maxItems": 7,
          "minItems": 0
        },
        "scope_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "capture_digests"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "capture_digests": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "maxItems": 16,
                "minItems": 0
              }
            }
          },
          "maxItems": 16,
          "minItems": 0
        }
      }
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "max_age_seconds",
        "allowed_statement_kinds",
        "partial_capture"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "max_age_seconds": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 3155760000
            }
          ]
        },
        "allowed_statement_kinds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "documented_fact",
              "requirement",
              "recommendation",
              "observation",
              "user_assertion",
              "inference",
              "hypothesis"
            ]
          }
        },
        "partial_capture": {
          "enum": [
            "exclude",
            "include_qualified"
          ]
        }
      }
    }
  }
}
