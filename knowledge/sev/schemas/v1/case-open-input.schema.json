{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:sev:case-open-input:v1",
  "title": "SEV Case Open Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "case_id", "case_kind", "source_current", "target", "created_at"],
  "properties": {
    "protocol": {"const": "symphony.sev.case-open-input.v1"},
    "case_id": {"$ref": "#/$defs/case_id"},
    "case_kind": {"enum": ["planned_change", "encountered_novelty"]},
    "source_current": {"$ref": "../../../sav/schemas/v1/current-snapshot.schema.json"},
    "target": {"type": ["object", "array", "string", "number", "boolean", "null"]},
    "created_at": {"$ref": "#/$defs/utc"}
  },
  "$defs": {
    "case_id": {"type": "string", "pattern": "^sevcase:[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
  }
}
