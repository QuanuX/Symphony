{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:sev:evolution-session-binding-input:v1",
  "title": "SEV Evolution Session Binding Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case", "lifecycle_profile_id", "lifecycle_profile_digest", "source_report_journal_digest", "desired_state_digest", "direction", "created_at"],
  "properties": {
    "case": {"$ref": "evolution-case.schema.json"},
    "lifecycle_profile_id": {"$ref": "#/$defs/id"},
    "lifecycle_profile_digest": {"$ref": "#/$defs/digest"},
    "source_report_journal_digest": {"$ref": "#/$defs/digest"},
    "desired_state_digest": {"$ref": "#/$defs/digest"},
    "direction": {"enum": ["forward", "reverse"]},
    "created_at": {"$ref": "#/$defs/utc"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/+-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
  }
}
