{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:sev:trigger-coalescing-result:v1",
  "title": "SEV Trigger Coalescing Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "policy_digest", "first_event_at", "last_event_at", "event_count", "event_set_digest", "proposed_case_kind", "case_open_authorized", "debounced", "read_only", "result_digest"],
  "properties": {
    "protocol": {"const": "symphony.sev.trigger-coalescing-result.v1"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "first_event_at": {"$ref": "#/$defs/utc"},
    "last_event_at": {"$ref": "#/$defs/utc"},
    "event_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "event_set_digest": {"$ref": "#/$defs/digest"},
    "proposed_case_kind": {"const": "encountered_novelty"},
    "case_open_authorized": {"const": false},
    "debounced": {"const": true},
    "read_only": {"const": true},
    "result_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
  }
}
