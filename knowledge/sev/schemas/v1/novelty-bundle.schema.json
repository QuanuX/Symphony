{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:sev:novelty-bundle:v1",
  "title": "SEV Novelty Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "bundle_id", "case_digest", "source_snapshot_digest", "items", "redactions", "approval_reference", "offline_capable", "network_transfer", "created_at", "canonical", "bundle_digest"],
  "properties": {
    "protocol": {"const": "symphony.sev.novelty-bundle.v1"},
    "bundle_id": {"type": "string", "pattern": "^sevnovelty:[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "case_digest": {"$ref": "#/$defs/digest"},
    "source_snapshot_digest": {"$ref": "#/$defs/digest"},
    "items": {"type": "array", "maxItems": 4096, "items": {"type": "object", "additionalProperties": false, "required": ["item_id", "disclosure_class", "content_digest", "payload"], "properties": {"item_id": {"$ref": "#/$defs/id"}, "disclosure_class": {"enum": ["public", "internal", "restricted"]}, "content_digest": {"$ref": "#/$defs/digest"}, "payload": {}}}},
    "redactions": {"type": "array", "maxItems": 4096, "items": {"type": "object", "additionalProperties": false, "required": ["item_id", "json_pointer", "reason"], "properties": {"item_id": {"$ref": "#/$defs/id"}, "json_pointer": {"type": "string", "maxLength": 4096}, "reason": {"type": "string", "minLength": 1, "maxLength": 4096}}}},
    "approval_reference": {"$ref": "#/$defs/id"},
    "offline_capable": {"const": true},
    "network_transfer": {"const": false},
    "created_at": {"$ref": "#/$defs/utc"},
    "canonical": {"const": false},
    "bundle_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/+-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
  }
}
