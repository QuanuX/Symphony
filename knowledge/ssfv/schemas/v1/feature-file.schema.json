{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:ssfv:feature-file:v1",
  "title": "SSFV embedded feature file v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "owner_contract",
    "source_scope",
    "records"
  ],
  "properties": {
    "protocol": {
      "const": "symphony.ssfv.feature-file.v1"
    },
    "owner_contract": {
      "$ref": "#/$defs/path"
    },
    "source_scope": {
      "$ref": "#/$defs/scope"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8192,
      "items": {
        "$ref": "urn:symphony:ssfv:feature-record:v2"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[*?\\[\\]{}])(?!.*[\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$"
    },
    "scope": {
      "oneOf": [
        {
          "const": "."
        },
        {
          "$ref": "#/$defs/path"
        }
      ]
    }
  }
}
