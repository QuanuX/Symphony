{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:ssfv:proposal-input:v2",
  "title": "SSFV bounded proposal input v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "session_ref",
    "context_ref",
    "created_at",
    "expires_at",
    "operation"
  ],
  "properties": {
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "session_ref": {
      "$ref": "#/$defs/optional_token"
    },
    "context_ref": {
      "$ref": "#/$defs/optional_token"
    },
    "created_at": {
      "$ref": "#/$defs/utc"
    },
    "expires_at": {
      "$ref": "#/$defs/utc"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "optional_token": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/token"
        }
      ]
    },
    "printable_256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^ssfv:[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 256
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[*?\\[\\]{}])(?!.*[\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "value"
      ],
      "properties": {
        "scheme": {
          "$ref": "#/$defs/token"
        },
        "value": {
          "$ref": "#/$defs/printable_256"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "revision",
        "worktree_id",
        "tree_digest"
      ],
      "properties": {
        "repository_id": {
          "$ref": "#/$defs/printable_256"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "worktree_id": {
          "$ref": "#/$defs/token"
        },
        "tree_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "semantic_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_worthiness_ratified",
        "owner_ratified",
        "rationale",
        "evidence"
      ],
      "properties": {
        "feature_worthiness_ratified": {
          "type": "boolean"
        },
        "owner_ratified": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "expected_contract_digest",
        "expected_namespace_digest",
        "expected_registry_digest",
        "expected_feature_digest",
        "affected_feature_ids",
        "target_paths",
        "namespace_entry",
        "feature_file",
        "feature_record",
        "registry_notes",
        "semantic_declaration",
        "authorization_ref"
      ],
      "properties": {
        "type": {
          "enum": [
            "allocate_namespace",
            "add_feature",
            "update_feature",
            "move_feature",
            "deprecate_feature",
            "retire_feature"
          ]
        },
        "expected_contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "expected_namespace_digest": {
          "$ref": "#/$defs/digest"
        },
        "expected_registry_digest": {
          "$ref": "#/$defs/digest"
        },
        "expected_feature_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "affected_feature_ids": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/feature_id"
          }
        },
        "target_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "namespace_entry": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:symphony:ssfv:namespace-entry:v1"
            }
          ]
        },
        "feature_file": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 11,
              "maxLength": 4096,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[*?\\[\\]{}])(?!.*[\\u0000-\\u001F\\u007F])(?:[^/]+/)*FEATURES\\.md$"
            }
          ]
        },
        "feature_record": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:symphony:ssfv:feature-record:v2"
            }
          ]
        },
        "registry_notes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          ]
        },
        "semantic_declaration": {
          "$ref": "#/$defs/semantic_declaration"
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "allocate_namespace"
              }
            }
          },
          "then": {
            "properties": {
              "affected_feature_ids": {
                "maxItems": 0
              },
              "expected_feature_digest": {
                "type": "null"
              },
              "namespace_entry": {
                "$ref": "urn:symphony:ssfv:namespace-entry:v1"
              },
              "feature_file": {
                "type": "null"
              },
              "feature_record": {
                "type": "null"
              },
              "registry_notes": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "affected_feature_ids": {
                "minItems": 1
              },
              "namespace_entry": {
                "type": "null"
              },
              "feature_file": {
                "type": "string"
              },
              "feature_record": {
                "$ref": "urn:symphony:ssfv:feature-record:v2"
              },
              "registry_notes": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
