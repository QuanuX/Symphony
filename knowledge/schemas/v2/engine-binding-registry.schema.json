{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:knowledge:engine-binding-registry:v2",
  "title": "Symphony user-scope knowledge engine binding registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "format_version",
    "scope",
    "profile_id",
    "generation",
    "updated_at",
    "previous_registry_digest",
    "previous_registry_protocol",
    "bindings",
    "canonical",
    "registry_digest"
  ],
  "properties": {
    "protocol": {"const": "symphony.knowledge.engine-binding-registry.v2"},
    "format_version": {"const": 2},
    "scope": {"const": "user"},
    "profile_id": {"const": "default"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64,
      "pattern": "Z$"
    },
    "previous_registry_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "previous_registry_protocol": {
      "enum": [
        "absent",
        "symphony.knowledge.engine-binding-registry.v1",
        "symphony.knowledge.engine-binding-registry.v2"
      ]
    },
    "bindings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/binding"}
    },
    "canonical": {"const": false},
    "registry_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"generation": {"const": 1}}},
      "then": {
        "properties": {
          "previous_registry_digest": {"type": "null"},
          "previous_registry_protocol": {"const": "absent"}
        }
      },
      "else": {
        "properties": {
          "previous_registry_digest": {"$ref": "#/$defs/digest"},
          "previous_registry_protocol": {
            "enum": [
              "symphony.knowledge.engine-binding-registry.v1",
              "symphony.knowledge.engine-binding-registry.v2"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "module_id",
        "engine_id",
        "version",
        "prefix",
        "receipt_path",
        "receipt_digest",
        "executable_path",
        "executable_digest",
        "state",
        "default_receptor"
      ],
      "properties": {
        "role": {"$ref": "#/$defs/token"},
        "module_id": {"$ref": "#/$defs/token"},
        "engine_id": {"$ref": "#/$defs/token"},
        "version": {"$ref": "#/$defs/version"},
        "prefix": {"$ref": "#/$defs/absolutePath"},
        "receipt_path": {"$ref": "#/$defs/absolutePath"},
        "receipt_digest": {"$ref": "#/$defs/digest"},
        "executable_path": {"$ref": "#/$defs/absolutePath"},
        "executable_digest": {"$ref": "#/$defs/digest"},
        "state": {"const": "bound_undocked"},
        "default_receptor": {"type": "null"}
      },
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "coordinator"}}},
          "then": {"properties": {"module_id": {"const": "knowledge-session-coordinator"}, "engine_id": {"const": "symphony-knowledge-session"}}}
        },
        {
          "if": {"properties": {"role": {"const": "sacv"}}},
          "then": {"properties": {"module_id": {"const": "sacv-engine"}, "engine_id": {"const": "symphony-sacv"}}}
        },
        {
          "if": {"properties": {"role": {"const": "sclv"}}},
          "then": {"properties": {"module_id": {"const": "sclv-engine"}, "engine_id": {"const": "symphony-sclv"}}}
        },
        {
          "if": {"properties": {"role": {"const": "skvi"}}},
          "then": {"properties": {"module_id": {"const": "skvi-engine"}, "engine_id": {"const": "symphony-skvi"}}}
        },
        {
          "if": {"properties": {"role": {"const": "sodv"}}},
          "then": {"properties": {"module_id": {"const": "sodv-engine"}, "engine_id": {"const": "symphony-sodv"}}}
        },
        {
          "if": {"properties": {"role": {"const": "ssfv"}}},
          "then": {"properties": {"module_id": {"const": "ssfv-engine"}, "engine_id": {"const": "symphony-ssfv"}}}
        },
        {
          "if": {"properties": {"role": {"const": "sav"}}},
          "then": {"properties": {"module_id": {"const": "sav-engine"}, "engine_id": {"const": "symphony-sav"}}}
        },
        {
          "if": {"properties": {"role": {"const": "sev"}}},
          "then": {"properties": {"module_id": {"const": "sev-engine"}, "engine_id": {"const": "symphony-sev"}}}
        }
      ]
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z.+-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?:$|[^/](?:.*[^/])?)$"
    }
  }
}
