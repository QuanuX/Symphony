{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:validation:baseline:v1",
  "title": "Symphony validation baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "format_version", "baseline_id", "tops_id", "repository_identity_digest",
    "validator_id", "validator_version", "created_at", "evidence_digest",
    "warning_occurrence_ids", "warning_subject_ids", "canonical", "baseline_digest"
  ],
  "properties": {
    "protocol": {"const": "symphony.validation.baseline.v1"},
    "format_version": {"const": 1},
    "baseline_id": {"$ref": "#/$defs/token"},
    "tops_id": {"$ref": "#/$defs/tops_id"},
    "repository_identity_digest": {"$ref": "#/$defs/digest"},
    "validator_id": {"const": "symphony-validator"},
    "validator_version": {"$ref": "#/$defs/version"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "warning_occurrence_ids": {"$ref": "#/$defs/digests"},
    "warning_subject_ids": {"$ref": "#/$defs/digests"},
    "canonical": {"const": false},
    "baseline_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digests": {
      "type": "array", "maxItems": 16384, "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "token": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "tops_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[0-9A-Za-z.+-]+$"
    }
  }
}
