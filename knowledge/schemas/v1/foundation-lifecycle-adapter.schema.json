{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:knowledge:foundation-lifecycle-adapter:v1",
  "title": "Symphony foundational lifecycle adapter descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "format_version", "component", "adapter_version", "binary_path", "binary_digest", "install_evidence_digest", "operations", "supported_scopes", "supported_managers", "compatibility", "limits", "canonical_apply_enabled", "network_listener", "descriptor_digest"],
  "properties": {
    "protocol": {"const": "symphony.foundation.lifecycle-adapter.v1"},
    "format_version": {"const": 1},
    "component": {"enum": ["ssiag", "stav"]},
    "adapter_version": {"$ref": "#/$defs/version"},
    "binary_path": {"$ref": "#/$defs/path"},
    "binary_digest": {"$ref": "#/$defs/digest"},
    "install_evidence_digest": {"$ref": "#/$defs/digest"},
    "operations": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/operationId"}},
    "supported_scopes": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["user", "system"]}},
    "supported_managers": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["launchd", "systemd", "external"]}},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "limits": {"$ref": "#/$defs/limits"},
    "canonical_apply_enabled": {"const": false},
    "network_listener": {"const": false},
    "descriptor_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Za-z.+-]+$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"},
    "operationId": {"type": "string", "maxLength": 256, "pattern": "^engop:symphony:(ssiag|stav)\\.(enrollment|supervisor)\\.(observe|plan|apply|apply-status|recover)$"},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["config_read_majors", "config_write_major", "runtime_read_majors", "runtime_write_major", "state_read_majors", "state_write_major", "rollback_readable"],
      "properties": {
        "config_read_majors": {"$ref": "#/$defs/majors"}, "config_write_major": {"type": "integer", "minimum": 1},
        "runtime_read_majors": {"$ref": "#/$defs/majors"}, "runtime_write_major": {"type": "integer", "minimum": 1},
        "state_read_majors": {"$ref": "#/$defs/majors"}, "state_write_major": {"type": "integer", "minimum": 1},
        "rollback_readable": {"type": "boolean"}
      }
    },
    "majors": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["request_bytes", "response_bytes", "deadline_ms", "json_depth", "json_values"],
      "properties": {
        "request_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "response_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
        "json_depth": {"type": "integer", "minimum": 1, "maximum": 64},
        "json_values": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    }
  }
}
