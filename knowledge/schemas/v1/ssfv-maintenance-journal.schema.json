{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:knowledge:ssfv-maintenance-journal:v1",
  "title": "Symphony persistent SSFV session-maintenance journal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "format_version", "journal_id", "context_key", "generation", "previous_journal_digest", "state", "tops_id", "subject_id", "repository_root", "session_journal_digest", "binding_registry_digest", "baseline_snapshot", "baseline_engine", "current_snapshot_digest", "current_engine", "maestro_inventory_digest", "review_state", "checkpoints", "compatibility", "extensions", "recovery", "started_at", "updated_at", "closed_at", "canonical", "journal_digest"],
  "properties": {
    "protocol": {"const": "symphony.knowledge.ssfv-maintenance-journal.v1"}, "format_version": {"const": 1},
    "journal_id": {"$ref": "#/$defs/token"}, "context_key": {"$ref": "#/$defs/digest"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "previous_journal_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "state": {"enum": ["open", "closed"]}, "tops_id": {"$ref": "#/$defs/uuid"}, "subject_id": {"$ref": "#/$defs/token"},
    "repository_root": {"$ref": "#/$defs/absolutePath"}, "session_journal_digest": {"$ref": "#/$defs/digest"},
    "binding_registry_digest": {"$ref": "#/$defs/digest"}, "baseline_snapshot": {"$ref": "urn:symphony:ssfv:semantic-snapshot:v1"},
    "baseline_engine": {"$ref": "urn:symphony:knowledge:ssfv-maintenance-command:v1#/$defs/engine"},
    "current_snapshot_digest": {"$ref": "#/$defs/digest"}, "current_engine": {"$ref": "urn:symphony:knowledge:ssfv-maintenance-command:v1#/$defs/engine"},
    "maestro_inventory_digest": {"$ref": "#/$defs/digest"}, "review_state": {"enum": ["current", "review_required"]},
    "checkpoints": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/checkpoint"}},
    "compatibility": {"$ref": "#/$defs/compatibility"}, "extensions": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/extension"}},
    "recovery": {"$ref": "#/$defs/recovery"}, "started_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"},
    "closed_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]}, "canonical": {"const": false}, "journal_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"}, "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Za-z.+-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "absolutePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?:$|[^/](?:.*[^/])?)$"},
    "summary": {"type": "object", "additionalProperties": false, "required": ["added", "changed", "removed", "uncovered", "stale", "review_required"], "properties": {"added": {"type": "integer", "minimum": 0}, "changed": {"type": "integer", "minimum": 0}, "removed": {"type": "integer", "minimum": 0}, "uncovered": {"type": "integer", "minimum": 0}, "stale": {"type": "integer", "minimum": 0}, "review_required": {"type": "integer", "minimum": 0}}},
    "checkpoint": {"type": "object", "additionalProperties": false, "required": ["sequence", "kind", "operation_id", "operation_fingerprint", "session_journal_digest", "binding_registry_digest", "engine_evidence_digest", "current_snapshot_digest", "diff_result_digest", "maestro_inventory_digest", "review_state", "diff_summary", "observed_at", "previous_checkpoint_digest", "checkpoint_digest"], "properties": {"sequence": {"type": "integer", "minimum": 1, "maximum": 256}, "kind": {"enum": ["begin", "checkpoint", "close", "recover"]}, "operation_id": {"$ref": "#/$defs/token"}, "operation_fingerprint": {"$ref": "#/$defs/digest"}, "session_journal_digest": {"$ref": "#/$defs/digest"}, "binding_registry_digest": {"$ref": "#/$defs/digest"}, "engine_evidence_digest": {"$ref": "#/$defs/digest"}, "current_snapshot_digest": {"$ref": "#/$defs/digest"}, "diff_result_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "maestro_inventory_digest": {"$ref": "#/$defs/digest"}, "review_state": {"enum": ["current", "review_required"]}, "diff_summary": {"$ref": "#/$defs/summary"}, "observed_at": {"$ref": "#/$defs/timestamp"}, "previous_checkpoint_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "checkpoint_digest": {"$ref": "#/$defs/digest"}}},
    "compatibility": {"type": "object", "additionalProperties": false, "required": ["process_protocols", "journal_read_versions", "journal_write_version", "minimum_reader_version", "required_capabilities", "optional_capabilities", "opaque_extensions_preserved"], "properties": {"process_protocols": {"const": ["symphony.knowledge.engine-process.v1"]}, "journal_read_versions": {"const": [1]}, "journal_write_version": {"const": 1}, "minimum_reader_version": {"const": 1}, "required_capabilities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}, "optional_capabilities": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}, "opaque_extensions_preserved": {"const": true}}},
    "extension": {"type": "object", "additionalProperties": false, "required": ["extension_id", "extension_version", "critical", "payload", "payload_digest"], "properties": {"extension_id": {"$ref": "#/$defs/token"}, "extension_version": {"$ref": "#/$defs/version"}, "critical": {"type": "boolean"}, "payload": {}, "payload_digest": {"$ref": "#/$defs/digest"}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["state", "disposition", "recovered_from_digest", "detail"], "properties": {"state": {"enum": ["clean", "recovered"]}, "disposition": {"enum": ["not_applicable", "selected_unique_forward_state"]}, "recovered_from_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "detail": {"type": "string", "minLength": 1, "maxLength": 4096}}}
  }
}
