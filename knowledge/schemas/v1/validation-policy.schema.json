{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:validation:policy:v1",
  "title": "Symphony validation policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "format_version", "profile_id", "tops_id", "generation",
    "previous_policy_digest", "updated_at", "default_warning_disposition",
    "historical_presentation", "new_presentation", "rules", "canonical", "policy_digest"
  ],
  "properties": {
    "protocol": {"const": "symphony.validation.policy.v1"},
    "format_version": {"const": 1},
    "profile_id": {"$ref": "#/$defs/token"},
    "tops_id": {"$ref": "#/$defs/tops_id"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "previous_policy_digest": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
    },
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "default_warning_disposition": {"$ref": "#/$defs/disposition"},
    "historical_presentation": {"$ref": "#/$defs/presentation"},
    "new_presentation": {"enum": ["full", "summary"]},
    "rules": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "disposition", "presentation"],
        "properties": {
          "rule_id": {"$ref": "#/$defs/token"},
          "disposition": {"$ref": "#/$defs/disposition"},
          "presentation": {"$ref": "#/$defs/presentation"}
        }
      }
    },
    "canonical": {"const": false},
    "policy_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "disposition": {"enum": ["record", "review", "require"]},
    "presentation": {"enum": ["full", "summary", "count"]},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "token": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "tops_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
