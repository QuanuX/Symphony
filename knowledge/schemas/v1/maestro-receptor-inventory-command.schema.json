{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:maestro:receptor-inventory-command:v1",
  "title": "Symphony Maestro derived receptor inventory command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "format_version", "operation", "state_root", "tops_id", "authorization_decision", "client"],
  "properties": {
    "protocol": {"const": "symphony.maestro.receptor-inventory-command.v1"},
    "format_version": {"const": 1},
    "operation": {"const": "inventory"},
    "state_root": {"$ref": "#/$defs/absolutePath"},
    "tops_id": {"$ref": "#/$defs/uuid"},
    "authorization_decision": {"$ref": "urn:symphony:ssiag:authorization-decision:v1"},
    "client": {"$ref": "#/$defs/client"}
  },
  "$defs": {
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Za-z.+-]+$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "absolutePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?:$|[^/](?:.*[^/])?)$"},
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "client_version", "process_protocols", "presence_read_versions", "presence_write_versions", "capabilities"],
      "properties": {
        "client_id": {"const": "qxctl"},
        "client_version": {"$ref": "#/$defs/version"},
        "process_protocols": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "presence_read_versions": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 16}},
        "presence_write_versions": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 16}},
        "capabilities": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "contains": {"const": "derived-receptor-inventory-v1"}, "items": {"$ref": "#/$defs/token"}}
      }
    }
  }
}
