{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:knowledge:administration-coverage-result:v1",
  "title": "Symphony administration coverage result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "format_version", "semantic_snapshot_digest", "profile_digest", "expected_command_registry_digest", "observed_command_registry_digest", "engine_descriptor_digests", "feature_findings", "surfaces", "module_integrations", "remediation_constraints", "summary", "read_only", "canonical", "result_digest"],
  "properties": {
    "protocol": {"const": "symphony.knowledge.administration-coverage-result.v1"},
    "format_version": {"const": 1},
    "semantic_snapshot_digest": {"$ref": "#/$defs/digest"}, "profile_digest": {"$ref": "#/$defs/digest"},
    "expected_command_registry_digest": {"$ref": "#/$defs/digest"},
    "observed_command_registry_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "engine_descriptor_digests": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "feature_findings": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/finding"}},
    "surfaces": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/surface"}},
    "module_integrations": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/moduleIntegration"}},
    "remediation_constraints": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/remediationConstraint"}},
    "summary": {"$ref": "#/$defs/summary"}, "read_only": {"const": true}, "canonical": {"const": false},
    "result_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "featureId": {"type": "string", "maxLength": 256, "pattern": "^ssfv:[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "commandId": {"type": "string", "maxLength": 256, "pattern": "^qxcmd:[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "operationId": {"type": "string", "maxLength": 256, "pattern": "^engop:[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "interaction": {"enum": ["discover", "inspect", "query", "validate", "configure", "propose", "invoke", "apply", "lifecycle", "recover"]},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "severity", "feature_id", "interaction", "engine_operation_id", "command_id", "reason", "missing", "proposal_only", "ratification_required"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/token"}, "severity": {"enum": ["information", "warning", "violation"]},
        "feature_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/featureId"}]},
        "interaction": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/interaction"}]},
        "engine_operation_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/operationId"}]},
        "command_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/commandId"}]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
        "missing": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"enum": ["feature_registration", "administration_expectation", "qxctl_command", "engine_operation", "input_protocol", "output_protocol", "result_validator", "authorization_binding", "expected_state", "recovery_route", "noninteractive_support", "json_output", "implementation_evidence", "test_evidence", "skvi_route"]}},
        "proposal_only": {"const": true}, "ratification_required": {"const": true}
      }
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["feature_id", "interaction", "design_state", "live_state", "authorization_state", "command_ids", "engine_operation_ids", "findings"],
      "properties": {
        "feature_id": {"$ref": "#/$defs/featureId"}, "interaction": {"$ref": "#/$defs/interaction"},
        "design_state": {"enum": ["satisfied", "uncovered", "exempt", "prohibited", "stale", "unresolved"]},
        "live_state": {"enum": ["not_evaluated", "ready", "qxctl_absent", "not_installed", "not_bound", "incompatible", "unreachable", "disabled", "unknown"]},
        "authorization_state": {"enum": ["not_evaluated", "allowed", "denied", "expired", "indeterminate"]},
        "command_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/commandId"}},
        "engine_operation_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/operationId"}},
        "findings": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "moduleIntegration": {
      "type": "object", "additionalProperties": false, "required": ["module_id", "engine_id", "descriptor_digest", "integration_state", "docking_ready", "findings"],
      "properties": {"module_id": {"$ref": "#/$defs/token"}, "engine_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/token"}]}, "descriptor_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "integration_state": {"enum": ["unassessed", "descriptor_invalid", "semantic_registration_required", "administration_unintegrated", "integration_ready", "blocked_incompatible", "retired"]}, "docking_ready": {"type": "boolean"}, "findings": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/finding"}}},
      "allOf": [{"if": {"properties": {"integration_state": {"const": "integration_ready"}}}, "then": {"properties": {"docking_ready": {"const": true}, "descriptor_digest": {"$ref": "#/$defs/digest"}}}, "else": {"properties": {"docking_ready": {"const": false}}}}]
    },
    "remediationConstraint": {
      "type": "object", "additionalProperties": false,
      "required": ["remediation_id", "finding_ids", "feature_id", "interaction", "backend_operation_ids", "required_mutability", "required_authority_mode", "required_target_scope", "required_evidence", "proposed_command_id", "proposed_grammar", "proposal_only", "ratification_required"],
      "properties": {
        "remediation_id": {"$ref": "#/$defs/token"},
        "finding_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "feature_id": {"$ref": "#/$defs/featureId"}, "interaction": {"$ref": "#/$defs/interaction"},
        "backend_operation_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/operationId"}},
        "required_mutability": {"enum": ["read_only", "evidence_only", "proposal_only", "permission_backed_mutation", "prohibited"]},
        "required_authority_mode": {"enum": ["none", "target_host_permission", "ssiag"]},
        "required_target_scope": {"enum": ["local", "target_host"]},
        "required_evidence": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"enum": ["command_spec", "cobra_leaf", "feature_binding", "backend_binding", "input_protocol", "output_protocol", "result_validator", "expected_state", "authorization_binding", "recovery_route", "noninteractive_support", "json_output", "implementation_test", "help_compatibility", "documentation", "skvi_route"]}},
        "proposed_command_id": {"type": "null"}, "proposed_grammar": {"type": "null"},
        "proposal_only": {"const": true}, "ratification_required": {"const": true}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["features_checked", "surfaces_checked", "satisfied", "uncovered", "exempt", "prohibited", "stale", "unresolved"],
      "properties": {"features_checked": {"type": "integer", "minimum": 0}, "surfaces_checked": {"type": "integer", "minimum": 0}, "satisfied": {"type": "integer", "minimum": 0}, "uncovered": {"type": "integer", "minimum": 0}, "exempt": {"type": "integer", "minimum": 0}, "prohibited": {"type": "integer", "minimum": 0}, "stale": {"type": "integer", "minimum": 0}, "unresolved": {"type": "integer", "minimum": 0}}
    }
  }
}
