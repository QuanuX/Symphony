{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:knowledge:temporal:v1",
  "title": "Symphony Temporal Semantics Definitions v1",
  "description": "Reusable structural encodings governed by knowledge/TIME.md. Implementations must additionally validate real Gregorian dates.",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "$defs": {
    "civil_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "utc_nanoseconds": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
    },
    "utc_seconds": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
