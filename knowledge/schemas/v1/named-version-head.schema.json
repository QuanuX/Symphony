{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:symphony:knowledge:named-version-head:v1",
  "title": "Symphony protected Named Version head v1", "type": "object", "additionalProperties": false,
  "required": ["protocol", "format_version", "tops_id", "active_slot", "generation", "registry_digest", "previous_head_digest", "head_digest"],
  "properties": {"protocol": {"const": "symphony.knowledge.named-version-head.v1"}, "format_version": {"const": 1}, "tops_id": {"$ref": "#/$defs/uuid"}, "active_slot": {"type": "integer", "minimum": 0, "maximum": 1}, "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "registry_digest": {"$ref": "#/$defs/digest"}, "previous_head_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "head_digest": {"$ref": "#/$defs/digest"}},
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}}
}
