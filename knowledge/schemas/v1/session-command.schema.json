{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:knowledge:session-command:v1",
  "title": "Symphony authenticated knowledge-session command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "operation", "state_root", "operation_id",
    "expected_journal_digest", "repository_root", "context_refs",
    "authorization_decision", "client"
  ],
  "properties": {
    "protocol": {"const": "symphony.knowledge.session-command.v1"},
    "operation": {"enum": ["session_begin", "session_status", "session_checkpoint", "session_close", "session_recover"]},
    "state_root": {"$ref": "#/$defs/absolutePath"},
    "operation_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/token"}]},
    "expected_journal_digest": {"oneOf": [{"type": "null"}, {"const": "absent"}, {"const": "discover"}, {"$ref": "#/$defs/digest"}]},
    "repository_root": {"$ref": "#/$defs/absolutePath"},
    "context_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "authorization_decision": {"$ref": "urn:symphony:ssiag:authorization-decision:v1"},
    "client": {"$ref": "#/$defs/client"}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "session_begin"}}}, "then": {"properties": {"operation_id": {"type": "string"}, "expected_journal_digest": {"oneOf": [{"const": "absent"}, {"$ref": "#/$defs/digest"}]}}}},
    {"if": {"properties": {"operation": {"const": "session_status"}}}, "then": {"properties": {"operation_id": {"type": "null"}, "expected_journal_digest": {"type": "null"}, "context_refs": {"maxItems": 0}}}},
    {"if": {"properties": {"operation": {"enum": ["session_checkpoint", "session_close"]}}}, "then": {"properties": {"operation_id": {"type": "string"}, "expected_journal_digest": {"$ref": "#/$defs/digest"}}}},
    {"if": {"properties": {"operation": {"const": "session_recover"}}}, "then": {"properties": {"operation_id": {"type": "string"}, "expected_journal_digest": {"oneOf": [{"const": "discover"}, {"$ref": "#/$defs/digest"}]}, "context_refs": {"maxItems": 0}}}}
  ],
  "$defs": {
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Za-z.+-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?:$|[^/](?:.*[^/])?)$"},
    "client": {
      "type": "object", "additionalProperties": false,
      "required": ["client_id", "client_version", "process_protocols", "journal_read_versions", "journal_write_versions", "capabilities"],
      "properties": {
        "client_id": {"const": "qxctl"}, "client_version": {"$ref": "#/$defs/version"},
        "process_protocols": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "journal_read_versions": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 1024}},
        "journal_write_versions": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 1024}},
        "capabilities": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}
      }
    }
  }
}
