{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:knowledge:session-result:v1",
  "title": "Symphony authenticated knowledge-session result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "operation", "compatibility", "journal_present", "journal", "journal_digest", "effective_state", "changed", "recovered", "repair_actions", "read_only", "canonical_apply_enabled", "canonical"],
  "properties": {
    "protocol": {"const": "symphony.knowledge.session-result.v1"},
    "operation": {"enum": ["session_begin", "session_status", "session_checkpoint", "session_close", "session_recover"]},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "journal_present": {"type": "boolean"},
    "journal": {"oneOf": [{"type": "null"}, {"$ref": "urn:symphony:knowledge:session-journal:v1"}]},
    "journal_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "effective_state": {"enum": ["absent", "open", "closed", "expired"]},
    "changed": {"type": "boolean"}, "recovered": {"type": "boolean"},
    "repair_actions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "read_only": {"type": "boolean"}, "canonical_apply_enabled": {"const": false}, "canonical": {"const": false}
  },
  "$defs": {
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "process_protocol", "journal_read_version", "journal_write_version", "shared_capabilities", "missing_capabilities", "reasons"],
      "properties": {
        "mode": {"enum": ["full", "read_only", "migration_required", "unsupported"]},
        "process_protocol": {"oneOf": [{"type": "null"}, {"const": "symphony.knowledge.engine-process.v1"}]},
        "journal_read_version": {"oneOf": [{"type": "null"}, {"const": 1}]},
        "journal_write_version": {"oneOf": [{"type": "null"}, {"const": 1}]},
        "shared_capabilities": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "missing_capabilities": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "reasons": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
      }
    }
  }
}
