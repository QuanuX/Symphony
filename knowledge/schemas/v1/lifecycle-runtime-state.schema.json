{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:knowledge:lifecycle-runtime-state:v1",
  "title": "Symphony lifecycle runtime state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "format_version", "profile_id", "tops_id", "generation",
    "previous_runtime_state_digest", "components", "updated_at", "canonical",
    "runtime_state_digest"
  ],
  "properties": {
    "protocol": {"const": "symphony.knowledge.lifecycle-runtime-state.v1"},
    "format_version": {"const": 1},
    "profile_id": {"$ref": "#/$defs/token"},
    "tops_id": {"$ref": "#/$defs/token"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "previous_runtime_state_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "components": {
      "type": "array", "maxItems": 4096,
      "items": {"$ref": "#/$defs/component"}
    },
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "canonical": {"const": false},
    "runtime_state_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id", "selected_receipt_digest", "activation", "docking",
        "receptor_id", "component_state_digest"
      ],
      "properties": {
        "component_id": {"$ref": "#/$defs/token"},
        "selected_receipt_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "activation": {"enum": ["inactive", "active"]},
        "docking": {"const": "undocked"},
        "receptor_id": {"type": "null"},
        "component_state_digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [{
        "if": {"properties": {"activation": {"const": "active"}}},
        "then": {"properties": {"selected_receipt_digest": {"$ref": "#/$defs/digest"}}}
      }]
    },
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
  }
}
