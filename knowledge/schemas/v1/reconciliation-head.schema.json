{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:knowledge:reconciliation-head:v1",
  "title": "Symphony reconciliation journal head v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "format_version", "context_id", "worktree_key", "active_slot",
    "generation", "journal_digest", "previous_head_digest", "updated_at",
    "head_digest"
  ],
  "properties": {
    "protocol": {"const": "symphony.knowledge.reconciliation-head.v1"},
    "format_version": {"const": 1},
    "context_id": {"$ref": "#/$defs/token"},
    "worktree_key": {"$ref": "#/$defs/digest"},
    "active_slot": {"enum": [0, 1]},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "journal_digest": {"$ref": "#/$defs/digest"},
    "previous_head_digest": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
    },
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "head_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
