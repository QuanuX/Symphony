{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:symphony:maestro:docking-presence-head:v1","title":"Symphony Maestro docking presence head v1","type":"object","additionalProperties":false,
  "required":["protocol","format_version","tops_id","receptor_id","active_slot","generation","registry_digest","previous_head_digest","updated_at","head_digest"],
