{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:knowledge:foundation-lifecycle-attempt:v1",
  "title": "Symphony foundational lifecycle protected attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "format_version", "component", "surface", "scope", "tops_id", "operation_id", "request_id", "correlation_id", "phase", "plan_digest", "prior_state_digest", "desired_state", "binary_digest", "install_evidence_digest", "audit_state", "audit_receipt_digest", "started_at", "updated_at", "completed_at", "predecessor_digest", "result_digest", "attempt_digest"],
  "properties": {
    "protocol": {"const": "symphony.foundation.lifecycle-attempt.v1"}, "format_version": {"const": 1},
    "component": {"enum": ["ssiag", "stav"]}, "surface": {"enum": ["enrollment", "supervisor"]}, "scope": {"enum": ["user", "system"]}, "tops_id": {"$ref": "#/$defs/uuid"},
    "operation_id": {"$ref": "#/$defs/token"}, "request_id": {"$ref": "#/$defs/uuid"}, "correlation_id": {"$ref": "#/$defs/uuid"},
    "phase": {"enum": ["prepared", "mutating", "observing", "mutation_closed", "reconciling_audit", "closed", "recovery_required"]},
    "plan_digest": {"$ref": "#/$defs/digest"}, "prior_state_digest": {"oneOf": [{"const": "absent"}, {"$ref": "#/$defs/digest"}]},
    "desired_state": {"enum": ["enrolled", "unenrolled_preserved", "native_running", "native_installed_stopped", "absent_stopped"]},
    "binary_digest": {"$ref": "#/$defs/digest"}, "install_evidence_digest": {"$ref": "#/$defs/digest"},
    "audit_state": {"enum": ["pending", "committed", "audit_deferred", "reconciled"]}, "audit_receipt_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "started_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}, "completed_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
    "predecessor_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "result_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "attempt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"}, "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
  }
}
