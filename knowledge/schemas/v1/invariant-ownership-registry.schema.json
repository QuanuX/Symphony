{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:knowledge:invariant-ownership-registry:v1",
  "title": "Symphony common invariant ownership registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "format_version", "scope", "catalog_scope", "catalog_complete", "forward_gate", "test_policy", "adapters", "invariants", "registry_digest"],
  "properties": {
    "protocol": {"const": "symphony.knowledge.invariant-ownership-registry.v1"},
    "format_version": {"const": 1},
    "scope": {"const": "common_lowest_authoritative_layer"},
    "catalog_scope": {"const": "registered_incremental"},
    "catalog_complete": {"const": false},
    "forward_gate": {"const": "enforce_new_or_modified"},
    "test_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_producer_regression_required", "consumer_boundary_rejection_required", "real_process_required_for_ipc"],
      "properties": {
        "owner_producer_regression_required": {"const": true},
        "consumer_boundary_rejection_required": {"const": true},
        "real_process_required_for_ipc": {"const": true}
      }
    },
    "adapters": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/adapter"}},
    "invariants": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/invariant"}},
    "registry_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9._/-]+$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "invariantId": {"type": "string", "maxLength": 256, "pattern": "^invariant:symphony:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "adapterId": {"type": "string", "maxLength": 256, "pattern": "^adapter:symphony:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "operationId": {"type": "string", "maxLength": 256, "pattern": "^engop:[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "testReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "cases"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "cases": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "component", "entry_point_id", "command_protocol", "format_version", "owner_contract", "implementation_path", "version_policy", "operation_ids"],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/adapterId"},
        "component": {"enum": ["ssiag", "stav"]},
        "entry_point_id": {"enum": ["ssiag.foundation-lifecycle", "ssiag.macos-keychain-provider", "stav.foundation-lifecycle"]},
        "command_protocol": {"enum": ["symphony.foundation.lifecycle-command.v1", "symphony.ssiag.provider.control.v1"]},
        "format_version": {"const": 1},
        "owner_contract": {"$ref": "#/$defs/path"},
        "implementation_path": {"$ref": "#/$defs/path"},
        "version_policy": {"const": "exact_receipt_v2_entry_point_and_capability_compatible"},
        "operation_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/operationId"}}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "title", "owner_contract", "owner_component", "statement", "producer_implementations", "producer_regressions", "consumer_boundary_rejections", "allowed_adapter_ids", "ipc_boundary", "real_process_regressions", "status"],
      "properties": {
        "invariant_id": {"$ref": "#/$defs/invariantId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "owner_contract": {"$ref": "#/$defs/path"},
        "owner_component": {"$ref": "#/$defs/token"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 4096},
        "producer_implementations": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "producer_regressions": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/testReference"}},
        "consumer_boundary_rejections": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/testReference"}},
        "allowed_adapter_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/adapterId"}},
        "ipc_boundary": {"type": "boolean"},
        "real_process_regressions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/testReference"}},
        "status": {"const": "active"}
      },
      "allOf": [
        {"if": {"properties": {"ipc_boundary": {"const": true}}, "required": ["ipc_boundary"]}, "then": {"properties": {"allowed_adapter_ids": {"type": "array", "minItems": 1}, "real_process_regressions": {"type": "array", "minItems": 1}}}, "else": {"properties": {"real_process_regressions": {"type": "array", "maxItems": 0}}}}
      ]
    }
  }
}
