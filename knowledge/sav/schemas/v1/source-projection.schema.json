{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:sav:source-projection:v1",
  "title": "SAV Typed Source Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "owner_vector", "owner_contract", "protocol", "authority_role", "collection_state", "content_digest", "observation_digest", "observed_at", "freshness", "payload"],
  "properties": {
    "source_id": {"$ref": "#/$defs/identity"},
    "owner_vector": {"$ref": "#/$defs/token"},
    "owner_contract": {"$ref": "#/$defs/path"},
    "protocol": {"$ref": "#/$defs/token"},
    "authority_role": {"enum": ["canonical_contract", "installed_receipt", "protected_selection", "maestro_presence", "derived_evidence", "local_overlay", "authorized_exception"]},
    "collection_state": {"enum": ["available", "unavailable", "incompatible", "invalid"]},
    "content_digest": {"$ref": "#/$defs/digest"},
    "observation_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "observed_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/utc"}]},
    "freshness": {"enum": ["not_applicable", "current", "stale", "unknown"]},
    "payload": {"type": ["object", "array", "string", "number", "boolean", "null"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "identity": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/+-]+$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(knowledge|modules|libraries|tools)/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F]).+$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
  }
}
