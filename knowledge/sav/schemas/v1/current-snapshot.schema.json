{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:sav:current-snapshot:v1",
  "title": "SAV CURRENT Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "tops_id", "operation_id", "snapshot_started_at", "snapshot_completed_at", "named_version_id", "named_version_digest", "declared_scope", "scope_digest", "coverage_state", "sources", "unresolved_sources", "snapshot_digest", "observation_digest", "canonical", "derived", "read_only"],
  "properties": {
    "protocol": {"const": "symphony.sav.current-snapshot.v1"},
    "tops_id": {"$ref": "#/$defs/identity"},
    "operation_id": {"$ref": "#/$defs/identity"},
    "snapshot_started_at": {"$ref": "#/$defs/utc"},
    "snapshot_completed_at": {"$ref": "#/$defs/utc"},
    "named_version_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^savver:[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"}]},
    "named_version_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "declared_scope": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
    "scope_digest": {"$ref": "#/$defs/digest"},
    "coverage_state": {"enum": ["complete", "partial", "unknown"]},
    "sources": {"type": "array", "maxItems": 256, "items": {"$ref": "source-projection.schema.json"}},
    "unresolved_sources": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/unresolved"}},
    "snapshot_digest": {"$ref": "#/$defs/digest"},
    "observation_digest": {"$ref": "#/$defs/digest"},
    "canonical": {"const": false},
    "derived": {"const": true},
    "read_only": {"const": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:/+-]+$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "unresolved": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "reason", "detail"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identity"},
        "reason": {"enum": ["absent", "unavailable", "incompatible", "invalid", "stale", "ambiguous_owner", "unknown_critical_version"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 65536}
      }
    }
  }
}
