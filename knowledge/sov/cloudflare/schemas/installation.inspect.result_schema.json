  "required": [
    "protocol",
    "request_id",
    "correlation_id",
    "operation",
    "request_ref",
    "descriptor_ref",
    "installation_ref",
    "context_ref",
    "plan_ref",
    "dispatch_state",
    "outcome",
    "effect_state",
    "error_code",
    "authority_ref",
    "audit_ref",
    "evidence",
    "artifacts",
