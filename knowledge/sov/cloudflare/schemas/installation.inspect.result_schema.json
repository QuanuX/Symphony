            "integrity": {
              "const": "verified"
            },
            "toolchain_id": {
              "type": "string"
            }
          },
          "required": [
            "toolchain_id",
            "bundle",
            "integrity"
          ],
          "type": "object"
        }
      ]
    },
    "descriptor_ref": {
      "maxLength": 4096,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "dispatch_state": {
      "enum": [
        "not_dispatched",
        "dispatch_started",
        "response_received"
