                  "type": "string"
                },
                "cf_integrity": {
                  "const": "sha512-sMt4G50Mvz0+wvp6ScckPmmJSrEtfN3BeYJbtJ9yN5wAgECgFUGy0twoup1KySG9Md4Ow4ifSkllPLBFQV9ePw=="
                },
                "cf_version": {
                  "const": "1.0.0-beta.28"
                },
                "entrypoint": {
                  "const": "cf/node_modules/cf/bin/cf"
                },
                "files": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "digest": {
                        "maxLength": 4096,
                        "pattern": "^sha256:[0-9a-f]{64}$",
                        "type": "string"
                      },
                      "executable": {
                        "type": "boolean"
                      },
                      "path": {
                        "maxLength": 4096,
                        "type": "string"
                      },
                      "size": {
                        "maximum": 536870912,
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "path",
                      "digest",
                      "size",
                      "executable"
                    ],
                    "type": "object"
                  },
                  "maxItems": 16000,
                  "minItems": 1,
                  "type": "array"
                },
                "node": {
                  "const": "node/bin/node"
                },
                "node_version": {
                  "const": "26.12.0"
                },
                "os": {
                  "enum": [
                    "macos",
                    "linux"
                  ],
                  "type": "string"
                },
                "protocol": {
                  "const": "symphony.sov.cloudflare-bundle.v1"
                },
                "scripts_executed": {
                  "const": false
