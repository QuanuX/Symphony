      "oneOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 4096,
          "type": "string"
        }
      ]
    },
    "context_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 4096,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "correlation_id": {
      "maxLength": 4096,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "data": {
