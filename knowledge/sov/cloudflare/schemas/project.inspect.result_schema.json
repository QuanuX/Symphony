{
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "maxItems": 0,
      "type": "array"
    },
    "audit_ref": {
      "type": "null"
    },
    "authority_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 4096,
          "type": "string"
        }
      ]
    },
    "context_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 4096,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "correlation_id": {
      "maxLength": 4096,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "completeness": {
              "const": "selected_files_only"
            },
            "configuration_evaluated": {
              "const": false
            },
            "content_retained": {
              "const": false
            },
            "execution_available": {
              "const": false
            },
            "manifest": {
              "additionalProperties": false,
              "properties": {
                "configuration": {
                  "maxLength": 4096,
                  "pattern": "^[ -~]+$",
                  "type": "string"
                },
                "configuration_kind": {
                  "enum": [
                    "cf",
                    "wrangler"
                  ],
                  "maxLength": 4096,
                  "type": "string"
                },
                "files": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "digest": {
                        "maxLength": 71,
                        "pattern": "sha256:[0-9a-f]{64}",
                        "type": "string"
                      },
                      "executable": {
                        "type": "boolean"
                      },
                      "path": {
                        "maxLength": 4096,
                        "pattern": "^[ -~]+$",
                        "type": "string"
                      },
                      "size": {
                        "maximum": 16777216,
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "path",
                      "digest",
                      "size",
                      "executable"
                    ],
                    "type": "object"
                  },
                  "maxItems": 4096,
                  "minItems": 1,
                  "type": "array"
                },
                "protocol": {
                  "const": "symphony.sov.cloudflare-project-manifest.v1"
                },
                "root": {
                  "maxLength": 4096,
                  "pattern": "^/[ -~]+$",
                  "type": "string"
                },
                "total_bytes": {
                  "maximum": 67108864,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "protocol",
                "root",
                "configuration_kind",
                "configuration",
                "files",
                "total_bytes"
              ],
              "type": "object"
            },
            "migration_required": {
              "type": "boolean"
            },
            "provider_dispatch": {
              "const": false
            },
            "snapshot_digest": {
              "maxLength": 71,
              "pattern": "sha256:[0-9a-f]{64}",
              "type": "string"
            }
          },
          "required": [
            "manifest",
            "snapshot_digest",
            "completeness",
            "content_retained",
            "configuration_evaluated",
            "migration_required",
            "provider_dispatch",
            "execution_available"
          ],
          "type": "object"
        }
      ]
    },
    "descriptor_ref": {
      "maxLength": 4096,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "dispatch_state": {
      "enum": [
        "not_dispatched",
        "dispatch_started",
        "response_received"
      ],
      "type": "string"
    },
    "effect_state": {
      "enum": [
        "not_applicable",
        "not_applied",
        "applied_verified",
        "partial_verified",
        "unresolved"
      ],
      "type": "string"
    },
    "error_code": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "invalid_control",
            "unavailable_contract",
            "binding_mismatch",
            "integrity_failure",
            "state_conflict",
            "local_failure",
            "child_failure",
            "unresolved_attempt"
          ],
          "type": "string"
        }
      ]
    },
    "evidence": {
      "items": {
        "maxLength": 4096,
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "installation_ref": {
      "additionalProperties": false,
      "properties": {
        "executable_digest": {
          "maxLength": 4096,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "receipt_digest": {
          "maxLength": 4096,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "const": "0.1.0-dev"
        }
      },
      "required": [
        "version",
        "executable_digest",
        "receipt_digest"
      ],
      "type": "object"
    },
    "next_action": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "inspect_plan",
            "reconcile",
            "new_plan",
            "implement_I4",
            "inspect_native_import"
          ],
          "type": "string"
        }
      ]
    },
    "operation": {
      "const": "project.inspect"
    },
    "outcome": {
      "enum": [
        "completed",
        "rejected",
        "aborted",
        "failed",
        "unknown"
      ],
      "type": "string"
    },
    "plan_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 4096,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "protocol": {
      "const": "symphony.sov.cloudflare-result.v1"
    },
    "request_id": {
      "maxLength": 4096,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "request_ref": {
      "maxLength": 4096,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "request_id",
    "correlation_id",
    "operation",
    "request_ref",
    "descriptor_ref",
    "installation_ref",
    "context_ref",
    "plan_ref",
    "dispatch_state",
    "outcome",
    "effect_state",
    "error_code",
    "authority_ref",
    "audit_ref",
    "evidence",
    "artifacts",
    "next_action",
    "data"
  ],
  "type": "object"
}
