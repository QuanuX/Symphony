{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:ssiag:provider-binding-plan:v1",
  "title": "SSIAG provider binding plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "plan_id", "tops_id", "scope", "provider_name", "provider_kind", "desired_state", "installation_id", "expected_state_digest", "current_state_digest", "inventory_digest", "actions", "applicable", "changed", "recovery_required", "reason", "expires_at", "operational_access_enabled", "provider_operations_enabled", "secret_channel_enabled", "caller_class_used", "canonical", "plan_digest"],
  "properties": {
    "protocol": {"const": "symphony.ssiag.provider-binding-plan.v1"},
    "plan_id": {"$ref": "#/$defs/uuid"},
    "tops_id": {"$ref": "#/$defs/uuid"},
    "scope": {"enum": ["user", "system"]},
    "provider_name": {"$ref": "#/$defs/provider_name"},
    "provider_kind": {"$ref": "#/$defs/token"},
    "desired_state": {"enum": ["bound", "unbound_preserved"]},
    "installation_id": {"$ref": "#/$defs/digest_or_not_applicable"},
    "expected_state_digest": {"$ref": "#/$defs/digest_or_absent"},
    "current_state_digest": {"$ref": "#/$defs/digest_or_absent"},
    "inventory_digest": {"$ref": "#/$defs/digest"},
    "actions": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/action"}},
    "applicable": {"type": "boolean"},
    "changed": {"type": "boolean"},
    "recovery_required": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000\\r\\n]+$"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "operational_access_enabled": {"const": false},
    "provider_operations_enabled": {"const": false},
    "secret_channel_enabled": {"const": false},
    "caller_class_used": {"const": false},
    "canonical": {"const": false},
    "plan_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"desired_state": {"const": "bound"}}}, "then": {"properties": {"installation_id": {"$ref": "#/$defs/digest"}}}},
    {"if": {"properties": {"desired_state": {"const": "unbound_preserved"}}}, "then": {"properties": {"installation_id": {"const": "not_applicable"}}}},
    {"if": {"properties": {"changed": {"const": false}}}, "then": {"properties": {"actions": {"type": "array", "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/action"}, {"properties": {"kind": {"const": "retain"}}}]}}}}}
  ],
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "kind", "direction", "depends_on"],
      "properties": {
        "action_id": {"$ref": "#/$defs/token"},
        "kind": {"enum": ["retain", "bind", "unbind_preserved"]},
        "direction": {"enum": ["none", "forward", "reverse"]},
        "depends_on": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}
      }
    },
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "provider_name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digest_or_not_applicable": {"oneOf": [{"const": "not_applicable"}, {"$ref": "#/$defs/digest"}]},
    "digest_or_absent": {"oneOf": [{"const": "absent"}, {"$ref": "#/$defs/digest"}]},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
