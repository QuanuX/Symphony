{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:ssiag:provider-installation-inventory:v1",
  "title": "SSIAG exact provider installation inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "tops_id", "scope", "provider_name", "provider_kind", "installations", "observed_at", "operational_access_enabled", "provider_operations_enabled", "secret_channel_enabled", "read_only", "canonical", "inventory_digest"],
  "properties": {
    "protocol": {"const": "symphony.ssiag.provider-installation-inventory.v1"},
    "tops_id": {"$ref": "#/$defs/uuid"},
    "scope": {"enum": ["user", "system"]},
    "provider_name": {"$ref": "#/$defs/provider_name"},
    "provider_kind": {"$ref": "#/$defs/token"},
    "installations": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/installation"}
    },
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "operational_access_enabled": {"const": false},
    "provider_operations_enabled": {"const": false},
    "secret_channel_enabled": {"const": false},
    "read_only": {"const": true},
    "canonical": {"const": false},
    "inventory_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation_id", "adapter_identifier", "adapter_version", "provider_protocol", "command_protocol", "receipt_digest", "executable_digest", "foundation_version", "foundation_receipt_digest", "foundation_executable_digest", "compatibility_state", "reason_code"],
      "properties": {
        "installation_id": {"$ref": "#/$defs/digest"},
        "adapter_identifier": {"$ref": "#/$defs/token"},
        "adapter_version": {"$ref": "#/$defs/token"},
        "provider_protocol": {"const": "symphony.ssiag.provider.v1"},
        "command_protocol": {"const": "symphony.ssiag.provider.control.v1"},
        "receipt_digest": {"$ref": "#/$defs/digest"},
        "executable_digest": {"$ref": "#/$defs/digest"},
        "foundation_version": {"$ref": "#/$defs/token"},
        "foundation_receipt_digest": {"$ref": "#/$defs/digest_or_not_applicable"},
        "foundation_executable_digest": {"$ref": "#/$defs/digest"},
        "compatibility_state": {"enum": ["exact", "incompatible", "unsupported"]},
        "reason_code": {"$ref": "#/$defs/reason"}
      },
      "allOf": [
        {"if": {"properties": {"compatibility_state": {"const": "exact"}}, "required": ["compatibility_state"]}, "then": {"properties": {"foundation_receipt_digest": {"$ref": "#/$defs/digest"}}}}
      ]
    },
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "provider_name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^symphony\\.ssiag\\.provider\\.[A-Za-z0-9._:-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digest_or_not_applicable": {"oneOf": [{"const": "not_applicable"}, {"$ref": "#/$defs/digest"}]},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
