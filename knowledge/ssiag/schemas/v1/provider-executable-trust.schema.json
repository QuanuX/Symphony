{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:ssiag:provider-executable-trust:v1",
  "title": "Symphony SSIAG provider executable trust declaration v1",
  "description": "declaration_digest is sha256 plus lowercase hexadecimal over the compact Go encoding/json serialization of this strict object after omitting declaration_digest; object member names are recursively serialized in lexical order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "tops_id", "scope", "provider_name", "provider_kind", "adapter_identifier",
    "adapter_version", "provider_protocol", "executable_path",
    "installation_digest", "executable_digest", "owner_uid", "owner_gid",
    "file_mode", "adapter_signing_identity", "foundation_executable_path",
    "foundation_installation_digest", "foundation_executable_digest",
    "foundation_owner_uid", "foundation_owner_gid", "foundation_signing_identity",
    "operational_access_enabled", "provider_operations_enabled",
    "secret_channel_enabled", "declaration_digest"
  ],
  "properties": {
    "protocol": {"const": "symphony.ssiag.provider-executable-trust.v1"},
    "tops_id": {"$ref": "#/$defs/uuid"},
    "scope": {"enum": ["user", "system"]},
    "provider_name": {"$ref": "#/$defs/provider_name"},
    "provider_kind": {"$ref": "#/$defs/token"},
    "adapter_identifier": {"$ref": "#/$defs/token"},
    "adapter_version": {"$ref": "#/$defs/token"},
    "provider_protocol": {"const": "symphony.ssiag.provider.v1"},
    "executable_path": {"$ref": "#/$defs/absolute_path"},
    "installation_digest": {"$ref": "#/$defs/digest"},
    "executable_digest": {"$ref": "#/$defs/digest"},
    "owner_uid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "owner_gid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "file_mode": {"type": "string", "pattern": "^0[1357][0145][0145]$"},
    "adapter_signing_identity": {"$ref": "#/$defs/value_or_not_applicable"},
    "foundation_executable_path": {"$ref": "#/$defs/absolute_path"},
    "foundation_installation_digest": {"$ref": "#/$defs/digest_or_not_applicable"},
    "foundation_executable_digest": {"$ref": "#/$defs/digest"},
    "foundation_owner_uid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "foundation_owner_gid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "foundation_signing_identity": {"$ref": "#/$defs/value_or_not_applicable"},
    "operational_access_enabled": {"const": false},
    "provider_operations_enabled": {"const": false},
    "secret_channel_enabled": {"const": false},
    "declaration_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "provider_name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "value_or_not_applicable": {"anyOf": [{"const": "not_applicable"}, {"$ref": "#/$defs/token"}]},
    "absolute_path": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\u0000]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digest_or_not_applicable": {"oneOf": [{"const": "not_applicable"}, {"$ref": "#/$defs/digest"}]}
  }
}
