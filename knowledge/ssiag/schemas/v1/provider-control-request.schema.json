{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:ssiag:provider-control-request:v1",
  "title": "Symphony SSIAG provider control request v1",
  "description": "request_digest is sha256 plus lowercase hexadecimal over the compact Go encoding/json serialization of this strict object after omitting request_digest; object member names are recursively serialized in lexical order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "request_id", "correlation_id", "tops_id", "provider_name",
    "adapter_identifier", "foundation_executable_path",
    "foundation_installation_digest", "foundation_executable_digest",
    "foundation_signing_identity", "operation", "requested_at", "deadline_at",
    "timeout_milliseconds", "operational_access_requested",
    "provider_operation_requested", "secret_channel_requested", "request_digest"
  ],
  "properties": {
    "protocol": {"const": "symphony.ssiag.provider-control-request.v1"},
    "request_id": {"$ref": "#/$defs/uuid"},
    "correlation_id": {"$ref": "#/$defs/uuid"},
    "tops_id": {"$ref": "#/$defs/uuid"},
    "provider_name": {"$ref": "#/$defs/token"},
    "adapter_identifier": {"$ref": "#/$defs/token"},
    "foundation_executable_path": {"$ref": "#/$defs/absolute_path"},
    "foundation_installation_digest": {"$ref": "#/$defs/digest_or_not_applicable"},
    "foundation_executable_digest": {"$ref": "#/$defs/digest"},
    "foundation_signing_identity": {"$ref": "#/$defs/value_or_not_applicable"},
    "operation": {"enum": ["handshake", "status", "capabilities"]},
    "requested_at": {"$ref": "#/$defs/timestamp"},
    "deadline_at": {"$ref": "#/$defs/timestamp"},
    "timeout_milliseconds": {"type": "integer", "minimum": 1, "maximum": 30000},
    "operational_access_requested": {"const": false},
    "provider_operation_requested": {"const": false},
    "secret_channel_requested": {"const": false},
    "request_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "value_or_not_applicable": {"anyOf": [{"const": "not_applicable"}, {"$ref": "#/$defs/token"}]},
    "absolute_path": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\u0000]*$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digest_or_not_applicable": {"oneOf": [{"const": "not_applicable"}, {"$ref": "#/$defs/digest"}]}
  }
}
