{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:ssiag:provider-control-response:v1",
  "title": "Symphony SSIAG provider control response v1",
  "description": "response_digest is sha256 plus lowercase hexadecimal over the compact Go encoding/json serialization of this strict object after omitting response_digest; object member names are recursively serialized in lexical order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "request_id", "correlation_id", "tops_id", "provider_name",
    "adapter_identifier", "operation", "deadline_at", "outcome", "status",
    "reason_code", "handshake", "capabilities", "error",
    "operational_access_enabled", "provider_operations_enabled",
    "secret_channel_enabled", "completed_at", "response_digest"
  ],
  "properties": {
    "protocol": {"const": "symphony.ssiag.provider-control-response.v1"},
    "request_id": {"$ref": "#/$defs/uuid"},
    "correlation_id": {"$ref": "#/$defs/uuid"},
    "tops_id": {"$ref": "#/$defs/uuid"},
    "provider_name": {"$ref": "#/$defs/token"},
    "adapter_identifier": {"$ref": "#/$defs/token"},
    "operation": {"enum": ["handshake", "status", "capabilities"]},
    "deadline_at": {"$ref": "#/$defs/timestamp"},
    "outcome": {"enum": ["succeeded", "failed"]},
    "status": {"enum": ["declared", "ready", "degraded", "locked", "unavailable", "disabled"]},
    "reason_code": {"$ref": "#/$defs/reason"},
    "handshake": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "urn:symphony:ssiag:provider-handshake:v1"}
      ]
    },
    "capabilities": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": {"$ref": "#/$defs/token"}
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/safe_error"}
      ]
    },
    "operational_access_enabled": {"const": false},
    "provider_operations_enabled": {"const": false},
    "secret_channel_enabled": {"const": false},
    "completed_at": {"$ref": "#/$defs/timestamp"},
    "response_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "succeeded"}}},
      "then": {"properties": {"error": {"type": "null"}}},
      "else": {"properties": {"handshake": {"type": "null"}, "error": {"$ref": "#/$defs/safe_error"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "handshake"}, "outcome": {"const": "succeeded"}}, "required": ["operation", "outcome"]},
      "then": {"properties": {"handshake": {"$ref": "urn:symphony:ssiag:provider-handshake:v1"}}},
      "else": {"properties": {"handshake": {"type": "null"}}}
    }
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^symphony\\.ssiag\\.provider\\.[a-z0-9._-]+$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safe_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "retryable", "native_detail_included", "secret_material_included"],
      "properties": {
        "code": {"$ref": "#/$defs/reason"},
        "category": {"enum": ["invalid_request", "compatibility", "trust", "timeout", "cancelled", "unavailable", "locked", "interaction", "internal"]},
        "retryable": {"type": "boolean"},
        "native_detail_included": {"const": false},
        "secret_material_included": {"const": false}
      }
    }
  }
}
