{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:ssiag:provider-binding-state:v1",
  "title": "SSIAG protected provider binding state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "tops_id", "scope", "provider_name", "provider_kind", "generation", "binding_state", "installation_id", "previous_installation_id", "previous_state_digest", "updated_at", "operational_access_enabled", "provider_operations_enabled", "secret_channel_enabled", "state_digest"],
  "properties": {
    "protocol": {"const": "symphony.ssiag.provider-binding-state.v1"},
    "tops_id": {"$ref": "#/$defs/uuid"},
    "scope": {"enum": ["user", "system"]},
    "provider_name": {"$ref": "#/$defs/provider_name"},
    "provider_kind": {"$ref": "#/$defs/token"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "binding_state": {"enum": ["unbound", "bound"]},
    "installation_id": {"$ref": "#/$defs/digest_or_not_applicable"},
    "previous_installation_id": {"$ref": "#/$defs/digest_or_not_applicable"},
    "previous_state_digest": {"$ref": "#/$defs/digest_or_absent"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "operational_access_enabled": {"const": false},
    "provider_operations_enabled": {"const": false},
    "secret_channel_enabled": {"const": false},
    "state_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"binding_state": {"const": "bound"}}, "required": ["binding_state"]}, "then": {"properties": {"installation_id": {"$ref": "#/$defs/digest"}}}},
    {"if": {"properties": {"binding_state": {"const": "unbound"}}, "required": ["binding_state"]}, "then": {"properties": {"installation_id": {"const": "not_applicable"}}}},
    {"if": {"properties": {"generation": {"const": 1}}, "required": ["generation"]}, "then": {"properties": {"previous_state_digest": {"const": "absent"}}}},
    {"if": {"properties": {"generation": {"minimum": 2}}, "required": ["generation"]}, "then": {"properties": {"previous_state_digest": {"$ref": "#/$defs/digest"}}}}
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "provider_name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digest_or_not_applicable": {"oneOf": [{"const": "not_applicable"}, {"$ref": "#/$defs/digest"}]},
    "digest_or_absent": {"oneOf": [{"const": "absent"}, {"$ref": "#/$defs/digest"}]},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
