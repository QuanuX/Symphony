{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symphony:ssiag:provider-one-shot-channel:v1",
  "title": "Symphony SSIAG synthetic provider one-shot channel descriptor v1",
  "description": "channel_digest is sha256 plus lowercase hexadecimal over the compact Go encoding/json serialization of this strict object after omitting channel_digest; object member names are recursively serialized in lexical order. The descriptor is synthetic and must not be opened.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "channel_id", "request_id", "correlation_id", "tops_id",
    "provider_name", "adapter_identifier", "operation", "deadline_at",
    "transport", "direction", "descriptor_number", "maximum_bytes",
    "synthetic", "operational", "single_use", "replay_permitted",
    "retry_permitted", "close_after_delivery", "secret_bytes_in_control",
    "channel_digest"
  ],
  "properties": {
    "protocol": {"const": "symphony.ssiag.provider-one-shot-channel.v1"},
    "channel_id": {"$ref": "#/$defs/uuid"},
    "request_id": {"$ref": "#/$defs/uuid"},
    "correlation_id": {"$ref": "#/$defs/uuid"},
    "tops_id": {"$ref": "#/$defs/uuid"},
    "provider_name": {"$ref": "#/$defs/token"},
    "adapter_identifier": {"$ref": "#/$defs/token"},
    "operation": {"$ref": "#/$defs/token"},
    "deadline_at": {"$ref": "#/$defs/timestamp"},
    "transport": {"const": "inherited-file-descriptor"},
    "direction": {"enum": ["foundation-to-provider", "provider-to-foundation"]},
    "descriptor_number": {"const": -1},
    "maximum_bytes": {"const": 0},
    "synthetic": {"const": true},
    "operational": {"const": false},
    "single_use": {"const": true},
    "replay_permitted": {"const": false},
    "retry_permitted": {"const": false},
    "close_after_delivery": {"const": true},
    "secret_bytes_in_control": {"const": false},
    "channel_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
