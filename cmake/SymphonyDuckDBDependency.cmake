# Explicit local dependency admission. Downloading is a separate reviewed step.
function(symphony_duckdb_regular_file path)
  if(IS_SYMLINK "${path}")
    message(FATAL_ERROR "Pinned DuckDB input is not a regular non-symlink file: ${path}")
  endif()
  execute_process(COMMAND /bin/test -f "${path}" RESULT_VARIABLE regular TIMEOUT 3)
  if(NOT regular EQUAL 0)
    message(FATAL_ERROR "Pinned DuckDB input is not a regular non-symlink file: ${path}")
  endif()
endfunction()

function(symphony_duckdb_dependency target)
  set(DUCKDB_ROOT "" CACHE PATH "Verified DuckDB 1.5.5 header, license and notices directory")
  set(DUCKDB_LIBRARY "" CACHE FILEPATH "Exact DuckDB 1.5.5 shared library")
  if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(os macos)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(os linux)
  else()
    message(FATAL_ERROR "Pinned DuckDB supports native macOS and Linux only")
  endif()
  set(processor "${CMAKE_SYSTEM_PROCESSOR}")
  if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES architecture_count)
    if(NOT architecture_count EQUAL 1)
      message(FATAL_ERROR "Select one DuckDB architecture per package")
    endif()
    set(processor "${CMAKE_OSX_ARCHITECTURES}")
  endif()
  string(TOLOWER "${processor}" processor)
  if(processor MATCHES "^(x86_64|amd64)$")
    set(architecture amd64)
    set(elf_machine "3e00")
    set(macho_cpu "07000001")
  elseif(processor MATCHES "^(arm64|aarch64)$")
    set(architecture arm64)
    set(elf_machine "b700")
    set(macho_cpu "0c000001")
  else()
    message(FATAL_ERROR "Unreviewed DuckDB architecture: ${processor}")
  endif()
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/DUCKDB-PROVENANCE.json" provenance)
  string(JSON protocol GET "${provenance}" protocol)
  if(NOT protocol STREQUAL "symphony.graph.duckdb-dependency.v2")
    message(FATAL_ERROR "Unsupported DuckDB dependency provenance protocol")
  endif()
  foreach(name duckdb.h LICENSE THIRD_PARTY_LICENSES.txt)
    if(NOT EXISTS "${DUCKDB_ROOT}/${name}" OR IS_SYMLINK "${DUCKDB_ROOT}/${name}")
      message(FATAL_ERROR "Missing regular pinned DuckDB input: ${name}")
    endif()
    symphony_duckdb_regular_file("${DUCKDB_ROOT}/${name}")
    string(JSON expected GET "${provenance}" files "${name}" sha256)
    string(JSON expected_bytes GET "${provenance}" files "${name}" bytes)
    file(SHA256 "${DUCKDB_ROOT}/${name}" actual)
    file(SIZE "${DUCKDB_ROOT}/${name}" actual_bytes)
    if(NOT actual STREQUAL expected OR NOT actual_bytes EQUAL expected_bytes)
      message(FATAL_ERROR "Pinned DuckDB dependency differs: ${name}")
    endif()
  endforeach()
  if(NOT EXISTS "${DUCKDB_LIBRARY}" OR IS_SYMLINK "${DUCKDB_LIBRARY}")
    message(FATAL_ERROR "Supply the exact regular DuckDB shared library")
  endif()
  symphony_duckdb_regular_file("${DUCKDB_LIBRARY}")
  set(platform "${os}-${architecture}")
  string(JSON expected GET "${provenance}" platforms "${platform}" library_sha256)
  string(JSON expected_bytes GET "${provenance}" platforms "${platform}" library_bytes)
  file(SHA256 "${DUCKDB_LIBRARY}" actual)
  file(SIZE "${DUCKDB_LIBRARY}" actual_bytes)
  if(NOT actual STREQUAL expected OR NOT actual_bytes EQUAL expected_bytes)
    message(FATAL_ERROR "Pinned DuckDB library differs for ${platform}")
  endif()
  file(READ "${DUCKDB_LIBRARY}" object_header OFFSET 0 LIMIT 20 HEX)
  if(os STREQUAL "linux")
    string(SUBSTRING "${object_header}" 0 12 magic)
    string(SUBSTRING "${object_header}" 36 4 machine)
    if(NOT magic STREQUAL "7f454c460201" OR NOT machine STREQUAL elf_machine)
      message(FATAL_ERROR "DuckDB is not the selected little-endian ELF64 architecture")
    endif()
  else()
    string(SUBSTRING "${object_header}" 0 8 magic)
    string(SUBSTRING "${object_header}" 8 8 machine)
    if(NOT magic STREQUAL "cffaedfe" OR NOT machine STREQUAL macho_cpu)
      message(FATAL_ERROR "DuckDB is not the selected thin Mach-O64 architecture")
    endif()
  endif()
  add_library(${target} SHARED IMPORTED)
  set_target_properties(${target} PROPERTIES IMPORTED_LOCATION "${DUCKDB_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${DUCKDB_ROOT}")
  message(STATUS "Verified pinned DuckDB 1.5.5 ${platform}: ${actual}")
endfunction()
