cmake_minimum_required(VERSION 3.30)
get_filename_component(MVP_REPOSITORY "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${MVP_REPOSITORY}/tests/mvp-dependencies/common.cmake")
file(READ "${MVP_MAP}" MVP_MAP_JSON)
file(READ "${CMAKE_CURRENT_LIST_DIR}/mvp-release-identities.json" catalog)
string(JSON protocol GET "${catalog}" protocol)
string(JSON format GET "${catalog}" format_version)
if(NOT protocol STREQUAL "symphony.mvp.release-identities.v1" OR NOT format EQUAL 1)
  message(FATAL_ERROR "Unknown release identity catalog protocol")
endif()
string(JSON components GET "${catalog}" components)
function(row_for_path array path output)
  mvp_indices(indices "${array}")
  set(matches 0)
  foreach(index IN LISTS indices)
    string(JSON candidate GET "${array}" ${index} path)
    if(candidate STREQUAL path)
      string(JSON row GET "${array}" ${index})
      set(${output} "${row}" PARENT_SCOPE)
      math(EXPR matches "${matches}+1")
    endif()
  endforeach()
  if(NOT matches EQUAL 1)
    message(FATAL_ERROR "Expected exactly one identity row for ${path}; found ${matches}")
  endif()
endfunction()
string(JSON roots GET "${MVP_MAP_JSON}" component_roots)
string(JSON root_count LENGTH "${roots}")
string(JSON component_count LENGTH "${components}")
if(NOT root_count EQUAL component_count)
  message(FATAL_ERROR "Identity catalog must cover every dependency-map root")
endif()
mvp_indices(indices "${roots}")
foreach(index IN LISTS indices)
  string(JSON path GET "${roots}" ${index} path)
  row_for_path("${components}" "${path}" row)
  get_filename_component(expected_id "${path}" NAME)
  string(JSON swift_path GET "${MVP_MAP_JSON}" swift_provider path)
  if(path STREQUAL swift_path)
    string(JSON expected_id GET "${MVP_MAP_JSON}" swift_provider component_id)
  endif()
  string(JSON actual_id GET "${row}" component_id)
  if(NOT actual_id STREQUAL expected_id)
    message(FATAL_ERROR "Candidate component owner differs for ${path}")
  endif()
endforeach()
string(JSON natives GET "${MVP_MAP_JSON}" native_components)
mvp_indices(indices "${natives}")
foreach(index IN LISTS indices)
  string(JSON native GET "${natives}" ${index})
  string(JSON path GET "${native}" path)
  row_for_path("${components}" "${path}" row)
  string(JSON package GET "${native}" package_release_version)
  string(JSON selected GET "${row}" package_version)
  if(NOT package STREQUAL selected)
    message(FATAL_ERROR "Native receipt identity changed in candidate catalog: ${path}")
  endif()
  string(JSON exports GET "${native}" exported_packages)
  string(JSON sdk_versions GET "${row}" sdk_versions)
  string(JSON export_count LENGTH "${exports}")
  string(JSON sdk_count LENGTH "${sdk_versions}")
  if(NOT export_count EQUAL sdk_count)
    message(FATAL_ERROR "SDK identity count differs for ${path}")
  endif()
  mvp_indices(exports_indices "${exports}")
  foreach(export IN LISTS exports_indices)
    foreach(field IN ITEMS package version)
      string(JSON expected GET "${exports}" ${export} ${field})
      string(JSON actual GET "${sdk_versions}" ${export} ${field})
      if(NOT expected STREQUAL actual)
        message(FATAL_ERROR "SDK ${field} changed in identity catalog: ${path}")
      endif()
    endforeach()
  endforeach()
endforeach()
string(JSON go_modules GET "${MVP_MAP_JSON}" go_modules)
string(JSON artifacts GET "${catalog}" go_artifacts)
string(JSON artifact_count LENGTH "${artifacts}")
set(command_count 0)
mvp_indices(indices "${go_modules}")
foreach(index IN LISTS indices)
  string(JSON module GET "${go_modules}" ${index})
  string(JSON path GET "${module}" path)
  row_for_path("${components}" "${path}" row)
  foreach(field IN ITEMS source_runtime_version)
    string(JSON expected GET "${module}" ${field})
    string(JSON actual GET "${row}" ${field})
    if(NOT expected STREQUAL actual)
      message(FATAL_ERROR "Go source identity differs for ${path}")
    endif()
  endforeach()
  string(JSON expected GET "${module}" verified_public_release_identities)
  string(JSON actual GET "${row}" public_go_source_identities)
  if(NOT expected STREQUAL actual)
    message(FATAL_ERROR "Public Go identities must remain independently owned: ${path}")
  endif()
  string(JSON commands GET "${module}" executable_packages)
  mvp_indices(command_indices "${commands}")
  foreach(command IN LISTS command_indices)
    math(EXPR command_count "${command_count}+1")
    row_for_path("${artifacts}" "${path}" artifact)
    string(JSON expected_id GET "${row}" component_id)
    string(JSON actual_id GET "${artifact}" component_id)
    if(NOT actual_id STREQUAL expected_id)
      message(FATAL_ERROR "Candidate artifact owner differs for ${path}")
    endif()
    foreach(field IN ITEMS binary_name entrypoint)
      string(JSON expected GET "${commands}" ${command} ${field})
      string(JSON actual GET "${artifact}" ${field})
      if(NOT expected STREQUAL actual)
        message(FATAL_ERROR "Candidate command ${field} differs for ${path}")
      endif()
    endforeach()
    string(JSON expected GET "${commands}" ${command} package)
    string(JSON actual GET "${artifact}" main_package)
    if(NOT expected STREQUAL actual)
      message(FATAL_ERROR "Candidate command main package differs: ${path}")
    endif()
    string(JSON selected GET "${artifact}" package_version)
    string(JSON row_version GET "${row}" package_version)
    if(NOT selected STREQUAL row_version)
      message(FATAL_ERROR "Candidate command/component versions disagree: ${path}")
    endif()
    string(JSON source GET "${module}" source_runtime_version)
    string(JSON symbol GET "${artifact}" version_symbol)
    if(path STREQUAL "modules/stav-append-authority")
      set(expected "0.2.1")
    elseif(path STREQUAL "modules/secure-identity-access-governance")
      set(expected "0.1.0-dev")
    else()
      set(expected "${source}")
      if(NOT symbol STREQUAL "")
        message(FATAL_ERROR "Unexpected version override for ${path}")
      endif()
    endif()
    if(NOT selected STREQUAL expected)
      message(FATAL_ERROR "Unreviewed candidate identity selection: ${path}")
    endif()
    if(path MATCHES "^modules/(stav-append-authority|secure-identity-access-governance)$")
      string(JSON module_path GET "${module}" module)
      if(NOT symbol STREQUAL "${module_path}/internal/version.Version")
        message(FATAL_ERROR "Candidate version override points to another owner")
      endif()
    endif()
  endforeach()
endforeach()
if(NOT artifact_count EQUAL command_count OR NOT command_count EQUAL 7)
  message(FATAL_ERROR "Candidate catalog must enumerate exactly the seven production Go commands")
endif()
string(JSON owners GET "${MVP_MAP_JSON}" owner_interfaces)
string(JSON supported GET "${catalog}" supported_owner_interfaces)
string(JSON owner_count LENGTH "${owners}")
string(JSON supported_count LENGTH "${supported}")
if(NOT owner_count EQUAL supported_count)
  message(FATAL_ERROR "Owner declaration identity coverage differs")
endif()
mvp_indices(indices "${owners}")
foreach(index IN LISTS indices)
  string(JSON owner GET "${owners}" ${index})
  string(JSON path GET "${owner}" path)
  row_for_path("${supported}" "${path}" row)
  foreach(field IN ITEMS protocol current_package_version)
    string(JSON expected GET "${owner}" ${field})
    string(JSON actual GET "${row}" ${field})
    if(NOT expected STREQUAL actual)
      message(FATAL_ERROR "Owner ${field} changed: ${path}")
    endif()
  endforeach()
  string(JSON releases GET "${owner}" releases)
  string(JSON retained GET "${row}" retained_package_versions)
  string(JSON releases_count LENGTH "${releases}")
  string(JSON retained_count LENGTH "${retained}")
  if(NOT releases_count EQUAL retained_count)
    message(FATAL_ERROR "Retained version admission differs: ${path}")
  endif()
  mvp_indices(release_indices "${releases}")
  string(JSON releases_type TYPE "${releases}")
  set(expected_versions "")
  set(actual_versions "")
  foreach(release IN LISTS release_indices)
    if(releases_type STREQUAL "OBJECT")
      string(JSON expected MEMBER "${releases}" ${release})
    else()
      string(JSON type TYPE "${releases}" ${release})
      if(type STREQUAL "STRING")
        string(JSON expected GET "${releases}" ${release})
      else()
        string(JSON expected GET "${releases}" ${release} version)
      endif()
    endif()
    string(JSON actual GET "${retained}" ${release})
    list(APPEND expected_versions "${expected}")
    list(APPEND actual_versions "${actual}")
  endforeach()
  list(SORT expected_versions)
  list(SORT actual_versions)
  if(NOT expected_versions STREQUAL actual_versions)
    message(FATAL_ERROR "Retained owner versions changed: ${path}")
  endif()
endforeach()
string(JSON swift GET "${MVP_MAP_JSON}" swift_provider)
string(JSON path GET "${swift}" path)
row_for_path("${components}" "${path}" row)
string(JSON expected GET "${swift}" version)
string(JSON actual GET "${row}" package_version)
if(NOT expected STREQUAL actual)
  message(FATAL_ERROR "Swift provider identity changed")
endif()
message(STATUS "PASS candidate identities: ${component_count} roots, ${command_count} Go commands, ${owner_count} owner declarations; independent and retained versions preserved")
