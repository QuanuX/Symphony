include("${CMAKE_CURRENT_LIST_DIR}/Support.cmake")
foreach(path IN ITEMS "${RELEASE_CANDIDATE}/candidate.json" "${RELEASE_CANDIDATE}/candidate.json.sig" "${RELEASE_ALLOWED_SIGNERS}")
  symphony_receipt_v2_regular_file("${path}")
endforeach()
if(NOT DEFINED RELEASE_SIGNER OR RELEASE_SIGNER STREQUAL "" OR NOT DEFINED RELEASE_EXPECTED_PROFILE)
  message(FATAL_ERROR "Verification requires independent signer policy and expected profile")
endif()
find_program(RELEASE_SSH_KEYGEN ssh-keygen REQUIRED)
file(REAL_PATH "${RELEASE_CANDIDATE}" candidate_root)
file(REAL_PATH "${RELEASE_ALLOWED_SIGNERS}" trusted_policy)
cmake_path(IS_PREFIX candidate_root "${trusted_policy}" NORMALIZE policy_in_candidate)
if(policy_in_candidate)
  message(FATAL_ERROR "Allowed-signers policy must be supplied independently of the downloaded candidate")
endif()
execute_process(COMMAND "${RELEASE_SSH_KEYGEN}" -Y verify -f "${RELEASE_ALLOWED_SIGNERS}"
  -I "${RELEASE_SIGNER}" -n symphony-release -s "${RELEASE_CANDIDATE}/candidate.json.sig"
  INPUT_FILE "${RELEASE_CANDIDATE}/candidate.json" COMMAND_ERROR_IS_FATAL ANY
  OUTPUT_VARIABLE signer_output ERROR_VARIABLE signer_diagnostics)
string(REGEX MATCHALL "SHA256:[A-Za-z0-9+/]+" observed_keys "${signer_output}${signer_diagnostics}")
list(REMOVE_DUPLICATES observed_keys)
list(LENGTH observed_keys key_count)
if(NOT key_count EQUAL 1)
  message(FATAL_ERROR "Successful signature verification did not identify exactly one signing key")
endif()
list(GET observed_keys 0 observed_key)
release_read("${RELEASE_CANDIDATE}/candidate.json" inventory)
release_candidate_shape("${inventory}")
string(JSON protocol GET "${inventory}" protocol)
string(JSON publication GET "${inventory}" publication_authorized)
string(JSON profile GET "${inventory}" platform profile_id)
string(JSON filename GET "${inventory}" artifact filename)
if(NOT protocol STREQUAL "symphony.release.candidate.v1" OR publication OR
    NOT profile STREQUAL RELEASE_EXPECTED_PROFILE OR NOT filename STREQUAL "candidate.tar")
  message(FATAL_ERROR "Signed candidate identity/profile does not match the requested candidate")
endif()
foreach(binding IN ITEMS "candidate.tar|artifact|sha256" "platform-evidence.json|platform|evidence_sha256"
    "build-evidence.json|build_evidence_sha256" "dependency-map.json|dependency_map_sha256"
    "identity-catalog.json|identity_catalog_sha256")
  string(REPLACE "|" ";" fields "${binding}")
  list(POP_FRONT fields path)
  string(JSON expected GET "${inventory}" ${fields})
  symphony_receipt_v2_regular_file("${RELEASE_CANDIDATE}/${path}")
  file(SHA256 "${RELEASE_CANDIDATE}/${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Signed candidate evidence mismatch: ${path}")
  endif()
endforeach()
string(JSON expected_size GET "${inventory}" artifact size)
file(SIZE "${RELEASE_CANDIDATE}/candidate.tar" actual_size)
if(NOT actual_size EQUAL expected_size)
  message(FATAL_ERROR "Candidate archive size differs")
endif()
if(DEFINED RELEASE_UNPACKED_ROOT)
  symphony_receipt_v2_root("${RELEASE_UNPACKED_ROOT}" unpacked)
  release_inventory("${unpacked}" components files paths)
  string(JSON signed_os GET "${inventory}" platform os)
  string(JSON signed_arch GET "${inventory}" platform architecture)
  if(NOT release_inventory_os STREQUAL signed_os OR NOT release_inventory_architecture STREQUAL signed_arch)
    message(FATAL_ERROR "Unpacked receipt target differs from signed platform")
  endif()
  foreach(field IN ITEMS components files)
    string(JSON expected GET "${inventory}" "${field}")
    release_canonical("${expected}" ARRAY 0 expected)
    release_canonical("${${field}}" ARRAY 0 actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Unpacked candidate ${field} differ from signed inventory")
    endif()
  endforeach()
  message(STATUS "Verified signer, archive/evidence bytes and exact unpacked receipt/file closure; execution qualification remains separate")
  set(scope caller_supplied_payload)
else()
  message(STATUS "Verified signer and archive/evidence bytes only; payload has not been extracted, inspected or executed")
  set(scope downloaded_bytes)
endif()
if(DEFINED RELEASE_VERIFICATION_OUTPUT)
  if(NOT IS_ABSOLUTE "${RELEASE_VERIFICATION_OUTPUT}" OR EXISTS "${RELEASE_VERIFICATION_OUTPUT}" OR IS_SYMLINK "${RELEASE_VERIFICATION_OUTPUT}")
    message(FATAL_ERROR "Verification output must be a new absolute file")
  endif()
  file(SHA256 "${RELEASE_CANDIDATE}/candidate.json" inventory_sha)
  file(SHA256 "${RELEASE_CANDIDATE}/candidate.json.sig" signature_sha)
  file(SHA256 "${RELEASE_ALLOWED_SIGNERS}" policy_sha)
  string(JSON artifact_sha GET "${inventory}" artifact sha256)
  string(JSON commit GET "${inventory}" source commit)
  string(JSON tree GET "${inventory}" source tree)
  string(TIMESTAMP verified_at "%Y-%m-%dT%H:%M:%SZ" UTC)
  release_quote("${RELEASE_SIGNER}" signer_json)
  release_quote("${profile}" profile_json)
  file(WRITE "${RELEASE_VERIFICATION_OUTPUT}" "{\"protocol\":\"symphony.release.candidate-verification.v1\",\"scope\":\"${scope}\",\"publication_authorized\":false,\"verified_at\":\"${verified_at}\",\"source_commit\":\"${commit}\",\"source_tree\":\"${tree}\",\"profile_id\":${profile_json},\"artifact_sha256\":\"${artifact_sha}\",\"inventory_sha256\":\"${inventory_sha}\",\"signature_sha256\":\"${signature_sha}\",\"allowed_signers_sha256\":\"${policy_sha}\",\"signature_scheme\":\"sshsig\",\"namespace\":\"symphony-release\",\"signer_principal\":${signer_json},\"observed_key_id\":\"${observed_key}\"}\n")
endif()
