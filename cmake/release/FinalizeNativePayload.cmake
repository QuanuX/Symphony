cmake_minimum_required(VERSION 3.30)
# Source-selected finalizer for native executable/shared-library payloads.
# CMake installation has already performed its configured loader-path edits.
find_program(native_strip strip REQUIRED)
foreach(spec IN LISTS SYMPHONY_PACKAGE_OWNED_SPECS)
  string(REPLACE "|" ";" fields "${spec}")
  list(GET fields 0 path)
  list(GET fields 1 kind)
  if(kind STREQUAL "executable" OR path MATCHES "\\.(dylib|so(\\.[0-9]+)*)$")
    set(binary "${SYMPHONY_PACKAGE_ROOT}/${path}")
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
      execute_process(COMMAND "${native_strip}" -S "${binary}" COMMAND_ERROR_IS_FATAL ANY)
      if(NOT "$ENV{SYMPHONY_CODESIGN_IDENTITY}" STREQUAL "")
        if("$ENV{SYMPHONY_CODESIGN_IDENTITY}" STREQUAL "-")
          set(timestamp --timestamp=none)
        else()
          set(timestamp --timestamp)
        endif()
        execute_process(COMMAND /usr/bin/codesign --force --sign "$ENV{SYMPHONY_CODESIGN_IDENTITY}"
          ${timestamp} "${binary}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND /usr/bin/codesign --verify --strict "${binary}" COMMAND_ERROR_IS_FATAL ANY)
      endif()
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
      execute_process(COMMAND "${native_strip}" --strip-unneeded "${binary}" COMMAND_ERROR_IS_FATAL ANY)
    else()
      message(FATAL_ERROR "Native payload finalization supports macOS/Linux only")
    endif()
  endif()
endforeach()
