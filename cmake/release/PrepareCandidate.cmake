include("${CMAKE_CURRENT_LIST_DIR}/Support.cmake")
foreach(name RELEASE_STAGE RELEASE_OUTPUT RELEASE_REPOSITORY RELEASE_PLATFORM_EVIDENCE RELEASE_BUILD_EVIDENCE)
  if(NOT DEFINED ${name} OR NOT IS_ABSOLUTE "${${name}}")
    message(FATAL_ERROR "${name} must be an absolute explicit path")
  endif()
endforeach()
if(EXISTS "${RELEASE_OUTPUT}" OR IS_SYMLINK "${RELEASE_OUTPUT}")
  message(FATAL_ERROR "Candidate output must be a new directory")
endif()
symphony_receipt_v2_root("${RELEASE_STAGE}" stage)
symphony_receipt_v2_root("${RELEASE_OUTPUT}" output)
file(REAL_PATH "${RELEASE_REPOSITORY}" repository)
foreach(parent IN ITEMS stage repository)
  cmake_path(IS_PREFIX ${parent} "${output}" NORMALIZE inside)
  if(inside)
    message(FATAL_ERROR "Candidate output must be outside source and payload roots")
  endif()
endforeach()
find_program(RELEASE_GIT git REQUIRED)
execute_process(COMMAND "${RELEASE_GIT}" --no-replace-objects -C "${repository}" status --porcelain --untracked-files=normal
  RESULT_VARIABLE status OUTPUT_VARIABLE dirty)
if(NOT status EQUAL 0 OR NOT dirty STREQUAL "")
  message(FATAL_ERROR "Candidate source must be a clean committed checkout")
endif()
execute_process(COMMAND "${RELEASE_GIT}" --no-replace-objects -C "${repository}" rev-parse HEAD
  COMMAND_ERROR_IS_FATAL ANY OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE)
execute_process(COMMAND "${RELEASE_GIT}" --no-replace-objects -C "${repository}" rev-parse "${commit}^{tree}"
  COMMAND_ERROR_IS_FATAL ANY OUTPUT_VARIABLE tree OUTPUT_STRIP_TRAILING_WHITESPACE)
release_read("${RELEASE_PLATFORM_EVIDENCE}" platform)
foreach(field protocol profile_id os architecture source_commit source_tree qualification_status)
  string(JSON "platform_${field}" GET "${platform}" "${field}")
endforeach()
if(NOT platform_protocol STREQUAL "symphony.platform-observation.v1" OR
    NOT platform_source_commit STREQUAL commit OR NOT platform_source_tree STREQUAL tree OR
    NOT platform_qualification_status STREQUAL "evidence_only" OR
    NOT platform_os MATCHES "^(linux|macos)$" OR NOT platform_architecture MATCHES "^(arm64|amd64)$")
  message(FATAL_ERROR "Platform observation is not bound to the selected source/target")
endif()
release_read("${RELEASE_BUILD_EVIDENCE}" build)
foreach(field source_commit source_tree profile_id)
  string(JSON value GET "${build}" "${field}")
  if(field STREQUAL "source_commit")
    set(expected "${commit}")
  elseif(field STREQUAL "source_tree")
    set(expected "${tree}")
  else()
    set(expected "${platform_profile_id}")
  endif()
  if(NOT value STREQUAL expected)
    message(FATAL_ERROR "Build evidence ${field} differs from candidate source/profile")
  endif()
endforeach()
release_inventory("${stage}" components files paths)
if(NOT release_inventory_os STREQUAL platform_os OR NOT release_inventory_architecture STREQUAL platform_architecture)
  message(FATAL_ERROR "Candidate receipt target differs from observed platform")
endif()
file(SHA256 "${RELEASE_PLATFORM_EVIDENCE}" platform_sha)
file(SHA256 "${RELEASE_BUILD_EVIDENCE}" build_sha)
file(SHA256 "${repository}/cmake/mvp-dependencies.json" dependencies_sha)
file(SHA256 "${repository}/cmake/mvp-release-identities.json" identities_sha)
file(MAKE_DIRECTORY "${output}")
# Archive creation is packaging, not cross-host byte reproducibility.
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${output}/candidate.tar" --format=gnutar -- ${paths}
  WORKING_DIRECTORY "${stage}" COMMAND_ERROR_IS_FATAL ANY)
release_inventory("${stage}" final_components final_files final_paths)
if(NOT final_components STREQUAL components OR NOT final_files STREQUAL files OR NOT final_paths STREQUAL paths)
  message(FATAL_ERROR "Candidate staging bytes changed during archive creation; discard this output")
endif()
execute_process(COMMAND "${RELEASE_GIT}" --no-replace-objects -C "${repository}" rev-parse HEAD
  OUTPUT_VARIABLE final_commit OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${RELEASE_GIT}" --no-replace-objects -C "${repository}" status --porcelain --untracked-files=normal
  OUTPUT_VARIABLE final_dirty COMMAND_ERROR_IS_FATAL ANY)
if(NOT final_commit STREQUAL commit OR NOT final_dirty STREQUAL "")
  message(FATAL_ERROR "Source changed during candidate preparation")
endif()
file(SHA256 "${output}/candidate.tar" archive_sha)
file(SIZE "${output}/candidate.tar" archive_size)
release_quote("${platform_profile_id}" profile_json)
set(inventory "{\"protocol\":\"symphony.release.candidate.v1\",\"publication_authorized\":false,\"source\":{\"commit\":\"${commit}\",\"tree\":\"${tree}\"},\"platform\":{\"profile_id\":${profile_json},\"os\":\"${platform_os}\",\"architecture\":\"${platform_architecture}\",\"evidence_sha256\":\"${platform_sha}\"},\"build_evidence_sha256\":\"${build_sha}\",\"dependency_map_sha256\":\"${dependencies_sha}\",\"identity_catalog_sha256\":\"${identities_sha}\",\"artifact\":{\"filename\":\"candidate.tar\",\"sha256\":\"${archive_sha}\",\"size\":${archive_size}},\"components\":${components},\"files\":${files}}")
release_candidate_shape("${inventory}")
file(WRITE "${output}/candidate.json" "${inventory}\n")
configure_file("${RELEASE_PLATFORM_EVIDENCE}" "${output}/platform-evidence.json" COPYONLY)
configure_file("${RELEASE_BUILD_EVIDENCE}" "${output}/build-evidence.json" COPYONLY)
configure_file("${repository}/cmake/mvp-dependencies.json" "${output}/dependency-map.json" COPYONLY)
configure_file("${repository}/cmake/mvp-release-identities.json" "${output}/identity-catalog.json" COPYONLY)
file(SHA256 "${output}/candidate.json" inventory_sha)
file(WRITE "${output}/SHA256SUMS" "${archive_sha}  candidate.tar\n${inventory_sha}  candidate.json\n")
message(STATUS "Prepared candidate ${archive_sha}; source/build evidence is declared, not publisher authorization or download qualification")
