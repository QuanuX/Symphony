cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../SymphonyReceiptV2Support.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/StrictJSON.cmake")
function(release_read path output)
  symphony_receipt_v2_regular_file("${path}")
  file(SIZE "${path}" size)
  if(size GREATER 16777216)
    message(FATAL_ERROR "Release evidence exceeds 16 MiB")
  endif()
  file(READ "${path}" value)
  release_strict_json("${value}")
  set(${output} "${value}" PARENT_SCOPE)
endfunction()
function(release_quote value output)
  symphony_receipt_v2_json_string("${value}" encoded)
  set(${output} "${encoded}" PARENT_SCOPE)
endfunction()

function(release_type value expected)
  string(JSON actual ERROR_VARIABLE error TYPE "${value}" ${ARGN})
  if(error OR NOT actual STREQUAL expected)
    message(FATAL_ERROR "Candidate field ${ARGN} must have JSON type ${expected}")
  endif()
endfunction()
function(release_keys value)
  release_type("${value}" OBJECT)
  string(JSON count LENGTH "${value}")
  list(LENGTH ARGN expected)
  if(NOT count EQUAL expected)
    message(FATAL_ERROR "Candidate object has unexpected/missing fields")
  endif()
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON key MEMBER "${value}" ${index})
    if(NOT key IN_LIST ARGN)
      message(FATAL_ERROR "Candidate object has an unknown field")
    endif()
  endforeach()
endfunction()
function(release_hex value length)
  string(LENGTH "${value}" actual_length)
  if(NOT actual_length EQUAL length OR NOT value MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Candidate digest/source identity is malformed")
  endif()
endfunction()
function(release_size object field)
  release_type("${object}" NUMBER "${field}")
  string(JSON size GET "${object}" "${field}")
  if(NOT size MATCHES "^(0|[1-9][0-9]*)$" OR size GREATER 9007199254740991)
    message(FATAL_ERROR "Candidate byte size must be a portable nonnegative integer")
  endif()
endfunction()

# This is a build-tool descriptor, not publication authorization. Validate its
# whole shape before signing or using values in a machine verification record.
function(release_candidate_shape inventory)
  release_keys("${inventory}" protocol publication_authorized source platform
    build_evidence_sha256 dependency_map_sha256 identity_catalog_sha256 artifact components files)
  release_type("${inventory}" STRING protocol)
  release_type("${inventory}" BOOLEAN publication_authorized)
  string(JSON protocol GET "${inventory}" protocol)
  string(JSON publication GET "${inventory}" publication_authorized)
  if(NOT protocol STREQUAL "symphony.release.candidate.v1" OR publication)
    message(FATAL_ERROR "Candidate protocol/publication disposition is invalid")
  endif()
  foreach(field IN ITEMS build_evidence_sha256 dependency_map_sha256 identity_catalog_sha256)
    release_type("${inventory}" STRING "${field}")
    string(JSON hash GET "${inventory}" "${field}")
    release_hex("${hash}" 64)
  endforeach()
  string(JSON source GET "${inventory}" source)
  release_keys("${source}" commit tree)
  foreach(field IN ITEMS commit tree)
    release_type("${source}" STRING "${field}")
    string(JSON hash GET "${source}" "${field}")
    release_hex("${hash}" 40)
  endforeach()
  string(JSON platform GET "${inventory}" platform)
  release_keys("${platform}" profile_id os architecture evidence_sha256)
  foreach(field IN ITEMS profile_id os architecture evidence_sha256)
    release_type("${platform}" STRING "${field}")
    string(JSON ${field} GET "${platform}" "${field}")
  endforeach()
  string(LENGTH "${profile_id}" profile_length)
  if(NOT os MATCHES "^(linux|macos)$" OR NOT architecture MATCHES "^(arm64|amd64)$" OR
      NOT profile_id MATCHES "^[A-Za-z0-9._-]+$" OR profile_length GREATER 256)
    message(FATAL_ERROR "Candidate platform identity is invalid")
  endif()
  release_hex("${evidence_sha256}" 64)
  string(JSON artifact GET "${inventory}" artifact)
  release_keys("${artifact}" filename sha256 size)
  release_type("${artifact}" STRING filename)
  release_type("${artifact}" STRING sha256)
  string(JSON filename GET "${artifact}" filename)
  string(JSON hash GET "${artifact}" sha256)
  if(NOT filename STREQUAL "candidate.tar")
    message(FATAL_ERROR "Candidate archive name is invalid")
  endif()
  release_hex("${hash}" 64)
  release_size("${artifact}" size)
  foreach(array IN ITEMS components files)
    release_type("${inventory}" ARRAY "${array}")
    string(JSON count LENGTH "${inventory}" "${array}")
    if(count LESS 1 OR count GREATER 4096)
      message(FATAL_ERROR "Candidate inventory array exceeds its bound")
    endif()
    math(EXPR last "${count} - 1")
    set(seen "")
    foreach(index RANGE 0 ${last})
      string(JSON row GET "${inventory}" "${array}" ${index})
      if(array STREQUAL "files")
        release_keys("${row}" path sha256 size)
        foreach(field IN ITEMS path sha256)
          release_type("${row}" STRING "${field}")
          string(JSON ${field} GET "${row}" "${field}")
        endforeach()
        symphony_receipt_v2_relative_path("${path}")
        release_hex("${sha256}" 64)
        release_size("${row}" size)
        set(identity "${path}")
      else()
        release_keys("${row}" component_id package_id version receipt_digest receipt_path)
        foreach(field IN ITEMS component_id package_id version receipt_digest receipt_path)
          release_type("${row}" STRING "${field}")
          string(JSON ${field} GET "${row}" "${field}")
        endforeach()
        foreach(field IN ITEMS component_id package_id version)
          string(LENGTH "${${field}}" length)
          if(NOT "${${field}}" MATCHES "^[A-Za-z0-9._:+-]+$" OR length GREATER 256)
            message(FATAL_ERROR "Candidate component identity is invalid")
          endif()
        endforeach()
        symphony_receipt_v2_relative_path("${receipt_path}")
        string(REGEX REPLACE "^sha256:" "" digest "${receipt_digest}")
        if(NOT receipt_digest STREQUAL "sha256:${digest}")
          message(FATAL_ERROR "Candidate receipt digest is invalid")
        endif()
        release_hex("${digest}" 64)
        set(identity "${component_id}|${version}")
      endif()
      if(identity IN_LIST seen)
        message(FATAL_ERROR "Candidate inventory has a duplicate identity/path")
      endif()
      list(APPEND seen "${identity}")
    endforeach()
  endforeach()
endfunction()
function(release_unmanaged root)
  foreach(path IN ITEMS ".symphony-lifecycle-ownership-v1.json"
      "share/symphony/receipts/symphony-root-ownership/1/install-receipt.json")
    symphony_receipt_v2_no_follow("${root}" "${path}")
    if(EXISTS "${root}/${path}")
      message(FATAL_ERROR "Candidate packaging refuses a qxctl-managed root")
    endif()
  endforeach()
endfunction()
# Verify receipt digests and installed bytes, then require an exact closed
# inventory. Package-manager files/user state never become implicit payload.
function(release_inventory root components_output files_output paths_output)
  release_unmanaged("${root}")
  file(GLOB receipts RELATIVE "${root}" "${root}/share/symphony/receipts/*/*/install-receipt.json")
  list(SORT receipts)
  list(LENGTH receipts receipt_count)
  if(receipt_count LESS 1 OR receipt_count GREATER 256)
    message(FATAL_ERROR "Candidate requires 1..256 exact receipt-v2 packages")
  endif()
  set(paths "")
  set(components "")
  set(selected_os "")
  set(selected_arch "")
  foreach(relative IN LISTS receipts)
    symphony_receipt_v2_no_follow("${root}" "${relative}")
    release_read("${root}/${relative}" receipt)
    string(JSON protocol GET "${receipt}" protocol)
    string(JSON format GET "${receipt}" format_version)
    if(NOT protocol STREQUAL "symphony.knowledge.install-receipt.v2" OR NOT format EQUAL 2)
      message(FATAL_ERROR "Candidate requires receipt-v2")
    endif()
    string(JSON platform_count LENGTH "${receipt}" platform_requirements)
    if(NOT platform_count EQUAL 1)
      message(FATAL_ERROR "Native candidate requires one exact platform requirement")
    endif()
    string(JSON os GET "${receipt}" platform_requirements 0 os)
    string(JSON arch GET "${receipt}" platform_requirements 0 architecture)
    if(NOT os MATCHES "^(linux|macos)$" OR NOT arch MATCHES "^(arm64|amd64)$")
      message(FATAL_ERROR "Native candidate receipt target is invalid")
    endif()
    if(NOT selected_os STREQUAL "" AND (NOT os STREQUAL selected_os OR NOT arch STREQUAL selected_arch))
      message(FATAL_ERROR "Native candidate mixes receipt targets")
    endif()
    set(selected_os "${os}")
    set(selected_arch "${arch}")
    foreach(field component_id module_id package_id version receipt_digest)
      string(JSON ${field} GET "${receipt}" "${field}")
    endforeach()
    if(NOT relative STREQUAL "share/symphony/receipts/${module_id}/${version}/install-receipt.json")
      message(FATAL_ERROR "Candidate receipt identity differs from its route")
    endif()
    string(JSON unsigned REMOVE "${receipt}" receipt_digest)
    symphony_receipt_v2_canonical("${unsigned}" OBJECT 0 canonical)
    string(SHA256 digest "${canonical}")
    if(NOT receipt_digest STREQUAL "sha256:${digest}")
      message(FATAL_ERROR "Candidate receipt self-digest mismatch")
    endif()
    string(JSON count LENGTH "${receipt}" files)
    if(count LESS 1 OR count GREATER 4096)
      message(FATAL_ERROR "Candidate package file count is invalid")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON path GET "${receipt}" files ${index} path)
      string(JSON expected_size GET "${receipt}" files ${index} size)
      string(JSON expected_hash GET "${receipt}" files ${index} digest)
      string(JSON kind GET "${receipt}" files ${index} kind)
      if(path IN_LIST paths OR path MATCHES "^share/symphony/receipts(/|$)" OR path MATCHES "^\\.symphony-")
        message(FATAL_ERROR "Candidate has duplicate/reserved ownership")
      endif()
      symphony_receipt_v2_no_follow("${root}" "${path}")
      symphony_receipt_v2_regular_file("${root}/${path}")
      file(SIZE "${root}/${path}" actual_size)
      file(SHA256 "${root}/${path}" actual_hash)
      if(NOT actual_size EQUAL expected_size OR NOT expected_hash STREQUAL "sha256:${actual_hash}")
        message(FATAL_ERROR "Candidate installed-byte mismatch: ${path}")
      endif()
      if(kind STREQUAL "executable")
        execute_process(COMMAND /bin/test -x "${root}/${path}" RESULT_VARIABLE executable)
        if(NOT executable EQUAL 0)
          message(FATAL_ERROR "Candidate executable has lost its executable mode")
        endif()
      elseif(NOT kind STREQUAL "regular")
        message(FATAL_ERROR "Candidate file kind is invalid")
      endif()
      list(APPEND paths "${path}")
    endforeach()
    list(APPEND paths "${relative}")
    foreach(field component_id package_id version receipt_digest relative)
      release_quote("${${field}}" "${field}_json")
    endforeach()
    if(NOT components STREQUAL "")
      string(APPEND components ",")
    endif()
    string(APPEND components "{\"component_id\":${component_id_json},\"package_id\":${package_id_json},\"version\":${version_json},\"receipt_digest\":${receipt_digest_json},\"receipt_path\":${relative_json}}")
  endforeach()
  list(SORT paths)
  file(GLOB_RECURSE actual LIST_DIRECTORIES TRUE RELATIVE "${root}" "${root}/*" "${root}/.*")
  set(actual_files "")
  foreach(path IN LISTS actual)
    symphony_receipt_v2_no_follow("${root}" "${path}")
    if(NOT IS_DIRECTORY "${root}/${path}")
      symphony_receipt_v2_regular_file("${root}/${path}")
      list(APPEND actual_files "${path}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES actual_files)
  list(SORT actual_files)
  if(NOT actual_files STREQUAL paths)
    message(FATAL_ERROR "Candidate contains foreign/unreceipted files")
  endif()
  set(files "")
  foreach(path IN LISTS paths)
    file(SHA256 "${root}/${path}" sha)
    file(SIZE "${root}/${path}" size)
    release_quote("${path}" path_json)
    if(NOT files STREQUAL "")
      string(APPEND files ",")
    endif()
    string(APPEND files "{\"path\":${path_json},\"sha256\":\"${sha}\",\"size\":${size}}")
  endforeach()
  set(${components_output} "[${components}]" PARENT_SCOPE)
  set(${files_output} "[${files}]" PARENT_SCOPE)
  set(${paths_output} "${paths}" PARENT_SCOPE)
  set(release_inventory_os "${selected_os}" PARENT_SCOPE)
  set(release_inventory_architecture "${selected_arch}" PARENT_SCOPE)
endfunction()
