{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "delivery-definition-v1",
  "description": "Release-tooling contract only; no installation, owner acceptance, provider or publication authority. Go additionally enforces duplicate-free JSON, dependency closure, target/source equality, all path/file references and complete bounded filesystem inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "set_id",
    "file_paths",
    "artifacts"
  ],
  "properties": {
    "set_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "file_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
      },
      "minItems": 1,
      "maxItems": 65536
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "os",
        "architecture"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "os": {
          "enum": [
            "macos",
            "linux"
          ]
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ]
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "package_id",
        "kind",
        "verification_adapter",
        "component_versions",
        "dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "package_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "kind": {
          "enum": [
            "native",
            "go",
            "swift",
            "vendor",
            "source"
          ]
        },
        "verification_adapter": {
          "enum": [
            "native-candidate-v1",
            "ssiag-receipt-v2",
            "stav-receipt-v2",
            "accordare-receipt-v2",
            "qxctl-files-v1",
            "sov-executable-v1",
            "swift-metadata-v2",
            "cloudflare-bundle-v1",
            "source-material-v1"
          ]
        },
        "component_versions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 256,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "minLength": 1,
            "maxLength": 128,
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "minLength": 1,
            "maxLength": 128,
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "minLength": 1,
            "maxLength": 128,
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          },
          "minItems": 0,
          "maxItems": 4096
        }
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "provenance_path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "provenance_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size",
        "mode"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 17179869184
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511,
          "description": "POSIX permissions in decimal; group/other write and special mode bits refused by Go."
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "source",
        "vendor",
        "file_paths",
        "primary_path",
        "payload_inventory_path",
        "manifest_path",
        "signature_path",
        "artifact_signer_policy_sha256",
        "receipt_paths",
        "install_recipe_path",
        "remove_recipe_path",
        "notice_paths",
        "source_material_paths",
        "build_evidence_paths"
      ],
      "properties": {
        "selection": {
          "$ref": "#/$defs/choice"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        },
        "vendor": {
          "anyOf": [
            {
              "$ref": "#/$defs/vendor"
            },
            {
              "type": "null"
            }
          ]
        },
        "file_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
          },
          "minItems": 1,
          "maxItems": 65536
        },
        "primary_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
        },
        "payload_inventory_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
        },
        "manifest_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
            },
            {
              "type": "null"
            }
          ]
        },
        "signature_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_signer_policy_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
          },
          "minItems": 0,
          "maxItems": 65536
        },
        "install_recipe_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
        },
        "remove_recipe_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
        },
        "notice_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
          },
          "minItems": 1,
          "maxItems": 65536
        },
        "source_material_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
          },
          "minItems": 1,
          "maxItems": 65536
        },
        "build_evidence_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Clean relative slash path; Go validator additionally rejects traversal, reserved index names, controls, CMake delimiters, links and ambiguous paths."
          },
          "minItems": 1,
          "maxItems": 65536
        }
      }
    }
  }
}
