cmake_minimum_required(VERSION 3.30)
# One isolated build per selected command. Byte reproducibility is not asserted.
find_program(CANDIDATE_GIT NAMES git REQUIRED)
file(REAL_PATH "${CANDIDATE_REPOSITORY}" repository)
if(NOT IS_ABSOLUTE "${CANDIDATE_WORK}" OR EXISTS "${CANDIDATE_WORK}" OR IS_SYMLINK "${CANDIDATE_WORK}")
  message(FATAL_ERROR "Candidate identity builds require a new absolute work directory")
endif()
get_filename_component(work_parent "${CANDIDATE_WORK}" DIRECTORY)
get_filename_component(work_name "${CANDIDATE_WORK}" NAME)
if(NOT IS_DIRECTORY "${work_parent}")
  message(FATAL_ERROR "The candidate work directory must have an existing parent")
endif()
file(REAL_PATH "${work_parent}" work_parent)
set(work "${work_parent}/${work_name}")
cmake_path(NORMAL_PATH work)
cmake_path(IS_PREFIX repository "${work}" NORMALIZE inside)
if(inside)
  message(FATAL_ERROR "Candidate identity builds must be outside the source checkout")
endif()
execute_process(COMMAND "${CANDIDATE_GIT}" --no-replace-objects -C "${repository}" status --porcelain --untracked-files=normal
  RESULT_VARIABLE status OUTPUT_VARIABLE dirty)
if(NOT status EQUAL 0 OR NOT dirty STREQUAL "")
  message(FATAL_ERROR "Candidate source must be clean, including untracked files")
endif()
file(MAKE_DIRECTORY "${work}/logs" "${work}/modules" "${work}/go-tmp" "${work}/telemetry" "${work}/identities")
file(WRITE "${work}/telemetry/mode" "off\n")
set(ENV{GOMODCACHE} "${work}/modules")
set(ENV{GOTMPDIR} "${work}/go-tmp")
set(ENV{TEST_TELEMETRY_DIR} "${work}/telemetry")

function(run name directory)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${directory}"
    RESULT_VARIABLE result OUTPUT_FILE "${work}/logs/${name}.log" ERROR_FILE "${work}/logs/${name}.log")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${name} failed (${result}); see ${work}/logs/${name}.log")
  endif()
endfunction()
function(git_value output)
  execute_process(COMMAND "${CANDIDATE_GIT}" --no-replace-objects -C "${repository}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Unable to read source identity: ${ARGN}")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()
git_value(commit rev-parse HEAD)
git_value(tree rev-parse "${commit}^{tree}")
git_value(epoch show -s --format=%ct "${commit}")
if(NOT epoch MATCHES "^(0|[1-9][0-9]*)$")
  message(FATAL_ERROR "Source commit time must be a nonnegative integer")
endif()
set(ENV{SOURCE_DATE_EPOCH} "${epoch}")
foreach(document IN ITEMS mvp-dependencies mvp-release-identities)
  execute_process(COMMAND "${CANDIDATE_GIT}" --no-replace-objects -C "${repository}" show "${commit}:cmake/${document}.json"
    RESULT_VARIABLE result OUTPUT_FILE "${work}/${document}.json")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "The selected commit lacks ${document}.json")
  endif()
endforeach()
file(SHA256 "${work}/mvp-dependencies.json" dependency_sha256)
file(SHA256 "${work}/mvp-release-identities.json" catalog_sha256)
file(READ "${work}/mvp-release-identities.json" catalog)
execute_process(COMMAND "${CANDIDATE_GO}" env GOVERSION GOHOSTOS GOHOSTARCH
  RESULT_VARIABLE status OUTPUT_VARIABLE go_environment OUTPUT_STRIP_TRAILING_WHITESPACE)
string(REPLACE "\n" ";" environment "${go_environment}")
list(LENGTH environment count)
if(NOT status EQUAL 0 OR NOT count EQUAL 3)
  message(FATAL_ERROR "Unable to inspect the selected Go toolchain")
endif()
list(GET environment 0 actual_go)
list(GET environment 1 goos)
list(GET environment 2 goarch)
if(NOT actual_go STREQUAL "go1.26.5")
  message(FATAL_ERROR "Exact Go 1.26.5 required; found ${actual_go}")
endif()
if(NOT goos MATCHES "^(darwin|linux)$" OR NOT goarch MATCHES "^(amd64|arm64)$")
  message(FATAL_ERROR "Candidate identity recipe admits native macOS/Linux x86_64/ARM64 only")
endif()
string(JSON artifact_count LENGTH "${catalog}" go_artifacts)
if(NOT artifact_count EQUAL 7)
  message(FATAL_ERROR "Expected the seven current production Go commands")
endif()
math(EXPR last_artifact "${artifact_count} - 1")
set(built_components "")
set(seen_paths "")
set(identities "")
set(qxctl_count 0)
foreach(index RANGE 0 ${last_artifact})
  foreach(field IN ITEMS component_id path main_package entrypoint binary_name package_version version_output_prefix recipe)
    string(JSON ${field} GET "${catalog}" go_artifacts ${index} ${field})
  endforeach()
  if(path IN_LIST seen_paths)
    message(FATAL_ERROR "Duplicate candidate component path ${path}")
  endif()
  list(APPEND seen_paths "${path}")
  if(recipe STREQUAL "qxctl-reproducible" AND path STREQUAL "tools/qxctl")
    math(EXPR qxctl_count "${qxctl_count} + 1")
    continue()
  endif()
  if(NOT recipe STREQUAL "go-candidate" OR NOT path MATCHES "^(modules|tools)/[a-z0-9-]+$" OR
      NOT component_id MATCHES "^[a-z][a-z0-9-]+$" OR NOT binary_name MATCHES "^[a-z][a-z0-9-]+$" OR
      NOT main_package MATCHES "^(\\.|\\./cmd/[a-z][a-z0-9-]+)$" OR
      NOT package_version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$")
    message(FATAL_ERROR "Invalid candidate catalog entry ${index}")
  endif()
  if(component_id IN_LIST built_components)
    message(FATAL_ERROR "Duplicate candidate component identity ${component_id}")
  endif()
  if(NOT version_output_prefix STREQUAL "${binary_name} version ")
    message(FATAL_ERROR "Unexpected compiled version output prefix for ${component_id}")
  endif()
  string(JSON symbol_type TYPE "${catalog}" go_artifacts ${index} version_symbol)
  set(version_symbol "")
  if(symbol_type STREQUAL "STRING")
    string(JSON version_symbol GET "${catalog}" go_artifacts ${index} version_symbol)
  elseif(NOT symbol_type STREQUAL "NULL")
    message(FATAL_ERROR "Invalid candidate version symbol")
  endif()
  set(expected_symbol "")
  if(path STREQUAL "modules/secure-identity-access-governance" OR path STREQUAL "modules/stav-append-authority")
    set(expected_symbol "github.com/QuanuX/Symphony/${path}/internal/version.Version")
  endif()
  if(NOT version_symbol STREQUAL expected_symbol)
    message(FATAL_ERROR "Unexpected linker identity override for ${path}")
  endif()
  set(root "${work}/${component_id}")
  file(MAKE_DIRECTORY "${root}/source" "${root}/bin" "${root}/cache" "${root}/gopath")
  run("${component_id}-archive" "${root}" "${CANDIDATE_GIT}" --no-replace-objects -C "${repository}" archive
    --format=tar "--output=${root}/source.tar" "${commit}" "${path}")
  run("${component_id}-extract" "${root}/source" "${CMAKE_COMMAND}" -E tar xf "${root}/source.tar")
  set(source "${root}/source/${path}")
  if(main_package STREQUAL ".")
    set(expected_entrypoint "${path}/main.go")
  else()
    string(REGEX REPLACE "^\\./" "" package_directory "${main_package}")
    set(expected_entrypoint "${path}/${package_directory}/main.go")
  endif()
  if(NOT entrypoint STREQUAL expected_entrypoint OR NOT EXISTS "${root}/source/${entrypoint}")
    message(FATAL_ERROR "Candidate entrypoint differs from its module/main package")
  endif()
  file(GLOB_RECURSE source_entries LIST_DIRECTORIES TRUE "${source}/*")
  foreach(entry IN LISTS source_entries)
    if(IS_SYMLINK "${entry}")
      message(FATAL_ERROR "Candidate source copies must not contain symlinks")
    endif()
  endforeach()
  file(READ "${source}/go.mod" module_file)
  if(NOT module_file MATCHES "(^|\n)go 1\\.26\\.5\n")
    message(FATAL_ERROR "Candidate module must declare exact Go 1.26.5")
  endif()
  file(SHA256 "${source}/go.mod" mod_sha256)
  set(sum_sha256 "")
  set(sum_json "null")
  if(EXISTS "${source}/go.sum")
    file(SHA256 "${source}/go.sum" sum_sha256)
    set(sum_json "\"${sum_sha256}\"")
  endif()
  set(ENV{GOCACHE} "${root}/cache")
  set(ENV{GOPATH} "${root}/gopath")
  execute_process(COMMAND "${CANDIDATE_GO}" list -mod=readonly -m
    -f "{{if .Replace}}{{.Path}} => {{.Replace.Path}} {{.Replace.Version}}{{end}}" all
    WORKING_DIRECTORY "${source}" RESULT_VARIABLE graph_status
    OUTPUT_FILE "${work}/logs/${component_id}-replacements.log" ERROR_FILE "${work}/logs/${component_id}-graph-diagnostics.log")
  if(NOT graph_status EQUAL 0)
    message(FATAL_ERROR "Candidate module graph failed; see ${component_id}-graph-diagnostics.log")
  endif()
  file(READ "${work}/logs/${component_id}-replacements.log" replacements)
  string(STRIP "${replacements}" replacements)
  if(NOT replacements STREQUAL "")
    message(FATAL_ERROR "Candidate module graph must not select replacements")
  endif()
  run("${component_id}-module-graph" "${source}" "${CANDIDATE_GO}" list -mod=readonly -m -json all)
  set(ldflags "-buildid=")
  if(NOT version_symbol STREQUAL "")
    string(APPEND ldflags " -X ${version_symbol}=${package_version}")
  endif()
  set(binary "${root}/bin/${binary_name}")
  run("${component_id}-build" "${source}" "${CANDIDATE_GO}" build -mod=readonly -trimpath -buildvcs=false
    "-ldflags=${ldflags}" -o "${binary}" "${main_package}")
  run("${component_id}-module-verification" "${source}" "${CANDIDATE_GO}" mod verify)
  run("${component_id}-version" "${root}" "${binary}" --version)
  file(READ "${work}/logs/${component_id}-version.log" reported_version)
  if(NOT reported_version STREQUAL "${version_output_prefix}${package_version}\n")
    message(FATAL_ERROR "Compiled ${component_id} identity differs from the selected candidate version")
  endif()
  file(SHA256 "${source}/go.mod" after_mod)
  set(after_sum "")
  if(EXISTS "${source}/go.sum")
    file(SHA256 "${source}/go.sum" after_sum)
  endif()
  if(NOT after_mod STREQUAL mod_sha256 OR NOT after_sum STREQUAL sum_sha256)
    message(FATAL_ERROR "Candidate build changed module metadata")
  endif()
  file(SHA256 "${binary}" executable_sha256)
  file(WRITE "${work}/identities/${component_id}.json" "{\n  \"protocol\": \"symphony.artifact-build-identity.v1\",\n  \"component_id\": \"${component_id}\",\n  \"version\": \"${package_version}\",\n  \"binary_name\": \"${binary_name}\",\n  \"source_commit\": \"${commit}\",\n  \"source_tree\": \"${tree}\",\n  \"source_date_epoch\": \"${epoch}\",\n  \"dependency_map_sha256\": \"${dependency_sha256}\",\n  \"release_identity_catalog_sha256\": \"${catalog_sha256}\",\n  \"go_mod_sha256\": \"${mod_sha256}\",\n  \"go_sum_sha256\": ${sum_json},\n  \"build_recipe\": \"symphony.go.candidate-build.v1\",\n  \"go_version\": \"${actual_go}\",\n  \"goos\": \"${goos}\",\n  \"goarch\": \"${goarch}\",\n  \"executable_sha256\": \"${executable_sha256}\",\n  \"isolated_builds\": 1,\n  \"reproducibility\": \"not_assessed\",\n  \"publication_authorized\": false\n}\n")
  list(APPEND built_components "${component_id}")
  message(STATUS "Verified candidate identity: ${component_id} ${package_version} ${goos}/${goarch} ${executable_sha256}")
endforeach()
list(LENGTH built_components built_count)
if(NOT built_count EQUAL 5 OR NOT qxctl_count EQUAL 1)
  message(FATAL_ERROR "Expected five single-build candidates and one separately reproducible qxctl candidate")
endif()
message(STATUS "Verified ${built_count} isolated Go candidate identities; no publication or runtime-provider qualification performed")
