# Exact source-owned notices, independent of package-manager layout. This does
# not select a dependency, grant redistribution authority or attest a binary.
include_guard(GLOBAL)
function(symphony_dependency_notice dependency output)
  set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/notices")
  file(READ "${root}/sources.json" manifest)
  string(JSON count LENGTH "${manifest}" components)
  math(EXPR last "${count}-1")
  foreach(index RANGE 0 ${last})
    string(JSON id GET "${manifest}" components ${index} id)
    if(id STREQUAL dependency)
      string(JSON name GET "${manifest}" components ${index} notice_file)
      string(JSON expected GET "${manifest}" components ${index} notice_sha256)
      if(NOT name MATCHES "^[A-Za-z0-9_.-]+$" OR NOT expected MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid dependency notice source record")
      endif()
      if(NOT EXISTS "${root}/${name}" OR IS_DIRECTORY "${root}/${name}" OR IS_SYMLINK "${root}/${name}")
        message(FATAL_ERROR "Missing regular pinned ${dependency} notice")
      endif()
      file(SHA256 "${root}/${name}" actual)
      if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Pinned ${dependency} notice differs")
      endif()
      set(${output} "${root}/${name}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "No pinned notice for ${dependency}")
endfunction()
