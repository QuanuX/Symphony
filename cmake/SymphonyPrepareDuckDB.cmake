cmake_minimum_required(VERSION 3.25)
foreach(required DUCKDB_PREPARE_ROOT DUCKDB_PLATFORM DUCKDB_PROVENANCE)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
file(READ "${DUCKDB_PROVENANCE}" provenance)
function(download_exact url hash destination)
  file(DOWNLOAD "${url}" "${destination}" EXPECTED_HASH "SHA256=${hash}"
    TLS_VERIFY ON STATUS status INACTIVITY_TIMEOUT 60 TIMEOUT 300)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Pinned DuckDB download failed: ${status}")
  endif()
endfunction()
string(JSON platform GET "${provenance}" platforms "${DUCKDB_PLATFORM}")
foreach(key archive_url archive_sha256 archive_library library_name library_sha256)
  string(JSON ${key} GET "${platform}" "${key}")
endforeach()
download_exact("${archive_url}" "${archive_sha256}" "${DUCKDB_PREPARE_ROOT}/upstream.zip")
file(ARCHIVE_EXTRACT INPUT "${DUCKDB_PREPARE_ROOT}/upstream.zip" DESTINATION "${DUCKDB_PREPARE_ROOT}/archive")
file(COPY_FILE "${DUCKDB_PREPARE_ROOT}/archive/duckdb.h" "${DUCKDB_PREPARE_ROOT}/duckdb.h")
if(DUCKDB_PLATFORM MATCHES "^macos-")
  find_program(LIPO lipo REQUIRED)
  if(DUCKDB_PLATFORM STREQUAL "macos-amd64")
    set(arch x86_64)
  else()
    set(arch arm64)
  endif()
  execute_process(COMMAND "${LIPO}" -thin "${arch}" "${DUCKDB_PREPARE_ROOT}/archive/${archive_library}"
    -output "${DUCKDB_PREPARE_ROOT}/${library_name}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot select pinned DuckDB slice")
  endif()
else()
  file(COPY_FILE "${DUCKDB_PREPARE_ROOT}/archive/${archive_library}" "${DUCKDB_PREPARE_ROOT}/${library_name}")
endif()
file(SHA256 "${DUCKDB_PREPARE_ROOT}/${library_name}" actual)
if(NOT actual STREQUAL library_sha256)
  message(FATAL_ERROR "Derived DuckDB shared library differs from pinned identity")
endif()
string(JSON license_url GET "${provenance}" license_url)
string(JSON license_hash GET "${provenance}" files LICENSE sha256)
download_exact("${license_url}" "${license_hash}" "${DUCKDB_PREPARE_ROOT}/LICENSE")
string(JSON source_url GET "${provenance}" notice_source archive_url)
string(JSON source_hash GET "${provenance}" notice_source archive_sha256)
download_exact("${source_url}" "${source_hash}" "${DUCKDB_PREPARE_ROOT}/source.zip")
file(ARCHIVE_EXTRACT INPUT "${DUCKDB_PREPARE_ROOT}/source.zip" DESTINATION "${DUCKDB_PREPARE_ROOT}/source")
file(READ "${DUCKDB_PREPARE_ROOT}/source/duckdb.cpp" amalgamation)
string(JSON marker GET "${provenance}" notice_source start_marker)
string(FIND "${amalgamation}" "${marker}" start)
string(FIND "${amalgamation}" "*/" end REVERSE)
if(start LESS 0 OR end LESS_EQUAL start)
  message(FATAL_ERROR "DuckDB upstream license appendix is absent")
endif()
math(EXPR length "${end} - ${start}")
string(SUBSTRING "${amalgamation}" ${start} ${length} appendix)
string(REGEX MATCHALL "### THIRD PARTY LICENSE #[0-9]+ ###" markers "${appendix}")
list(LENGTH markers count)
string(JSON expected_count GET "${provenance}" notice_source license_count)
if(NOT count EQUAL expected_count)
  message(FATAL_ERROR "DuckDB upstream license appendix count differs")
endif()
string(JSON prefix GET "${provenance}" notice_source prefix)
file(WRITE "${DUCKDB_PREPARE_ROOT}/THIRD_PARTY_LICENSES.txt" "${prefix}${appendix}")
foreach(name duckdb.h LICENSE THIRD_PARTY_LICENSES.txt)
  string(JSON expected GET "${provenance}" files "${name}" sha256)
  file(SHA256 "${DUCKDB_PREPARE_ROOT}/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Prepared DuckDB input differs: ${name}")
  endif()
endforeach()
file(COPY_FILE "${DUCKDB_PROVENANCE}" "${DUCKDB_PREPARE_ROOT}/DUCKDB-PROVENANCE.json")
file(WRITE "${DUCKDB_PREPARE_ROOT}/dependency.cmake"
  "set(DUCKDB_ROOT [==[${DUCKDB_PREPARE_ROOT}]==] CACHE PATH \"\" FORCE)\nset(DUCKDB_LIBRARY [==[${DUCKDB_PREPARE_ROOT}/${library_name}]==] CACHE FILEPATH \"\" FORCE)\n")
message(STATUS "Prepared pinned DuckDB ${DUCKDB_PLATFORM}: ${DUCKDB_PREPARE_ROOT}/${library_name}")
