cmake_minimum_required(VERSION 3.31)
include("${CMAKE_CURRENT_LIST_DIR}/../SymphonyDependencyNotices.cmake")
if(NOT IS_ABSOLUTE "${DEPENDENCY_WORK}" OR NOT EXISTS "${DEPENDENCY_WORK}/curl-build/CMakeCache.txt" OR NOT EXISTS "${DEPENDENCY_WORK}/zstd-build/CMakeCache.txt")
  message(FATAL_ERROR "Select the verified private curl/zstd build directory")
endif()
set(prefix "${DEPENDENCY_WORK}/prefix")
file(READ "${CMAKE_CURRENT_LIST_DIR}/sources.json" sources)
string(JSON result SET "${sources}" publication_authorized false)
string(JSON result SET "${result}" observation_scope "\"build-time selection, not TLS handshake or legal approval\"")
foreach(id curl zstd)
  symphony_dependency_notice(${id} notice)
  if(id STREQUAL "curl")
    set(source_notice "${DEPENDENCY_WORK}/curl-8.7.1/COPYING")
    set(version 8.7.1)
    set(archive "${DEPENDENCY_WORK}/curl-8.7.1.tar.xz")
    string(JSON archive_expected GET "${sources}" components 0 source_sha256)
  else()
    set(source_notice "${DEPENDENCY_WORK}/zstd-1.5.7/LICENSE")
    set(version 1.5.7)
    set(archive "${DEPENDENCY_WORK}/zstd-1.5.7.tar.gz")
    string(JSON archive_expected GET "${sources}" components 1 source_sha256)
  endif()
  file(SHA256 "${archive}" archive_actual)
  if(NOT archive_actual STREQUAL archive_expected)
    message(FATAL_ERROR "Selected ${id} source archive differs")
  endif()
  file(SHA256 "${notice}" expected)
  file(SHA256 "${source_notice}" actual)
  if(NOT expected STREQUAL actual)
    message(FATAL_ERROR "Downloaded ${id} notice differs from the selected exact source notice")
  endif()
  file(MAKE_DIRECTORY "${prefix}/share/licenses/${id}/${version}")
  file(COPY_FILE "${notice}" "${prefix}/share/licenses/${id}/${version}/LICENSE")
endforeach()
function(quote input output)
  string(REPLACE "\\" "\\\\" value "${input}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()
set(config "{}")
foreach(id curl zstd)
  file(STRINGS "${DEPENDENCY_WORK}/${id}-build/CMakeCache.txt" lines REGEX "^(CURL_USE_[A-Z0-9_]+|OPENSSL_SSL_LIBRARY|OPENSSL_CRYPTO_LIBRARY|OPENSSL_INCLUDE_DIR|_OPENSSL_VERSION|ZLIB_LIBRARY_RELEASE|ZLIB_LIBRARY_DEBUG|CURL_BROTLI|CURL_ZSTD|USE_NGHTTP2|USE_LIBIDN2|USE_LIBSSH2|CURL_USE_LIBPSL|BUILD_SHARED_LIBS|ZSTD_BUILD_STATIC|ZSTD_BUILD_SHARED|CMAKE_C_COMPILER|CMAKE_BUILD_TYPE):")
  set(values "[]")
  set(index 0)
  foreach(line IN LISTS lines)
    quote("${line}" quoted)
    string(JSON values SET "${values}" ${index} "${quoted}")
    math(EXPR index "${index}+1")
  endforeach()
  string(JSON config SET "${config}" ${id} "${values}")
endforeach()
string(JSON result SET "${result}" selected_cmake_cache "${config}")
file(MAKE_DIRECTORY "${prefix}/share/symphony/dependency-evidence")
file(WRITE "${prefix}/share/symphony/dependency-evidence/curl-zstd.json" "${result}\n")
