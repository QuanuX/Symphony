set(receipt_relative "@SYMPHONY_RECEIPT_PREFLIGHT_PATH@")
include("${CMAKE_CURRENT_LIST_DIR}/SymphonyReceiptV2Support.cmake")
symphony_receipt_v2_root("$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}" install_root)
set(finalizer [==[@SYMPHONY_RECEIPT_FINALIZER@]==])
if(NOT finalizer STREQUAL "")
    if(NOT DEFINED SYMPHONY_PACKAGE_STAGE_ROOT)
        message(FATAL_ERROR "package finalization requires explicit SYMPHONY_PACKAGE_STAGE_ROOT before installation")
    endif()
    symphony_receipt_v2_root("${SYMPHONY_PACKAGE_STAGE_ROOT}" declared_stage)
    if(NOT declared_stage STREQUAL install_root)
        message(FATAL_ERROR "package finalization stage differs from the actual install root")
    endif()
    symphony_receipt_v2_regular_file("${finalizer}")
    file(SHA256 "${finalizer}" finalizer_sha)
    if(NOT finalizer_sha STREQUAL "@SYMPHONY_RECEIPT_FINALIZER_SHA256@")
        message(FATAL_ERROR "package finalizer changed since configure")
    endif()
endif()
set(owned_paths "@SYMPHONY_RECEIPT_PREFLIGHT_OWNED_PATHS@")
foreach(relative IN LISTS owned_paths)
    symphony_receipt_v2_no_follow("${install_root}" "${relative}")
    if(EXISTS "${install_root}/${relative}")
        symphony_receipt_v2_regular_file("${install_root}/${relative}")
    endif()
endforeach()
symphony_receipt_v2_no_follow("${install_root}" "${receipt_relative}")
symphony_receipt_v2_no_follow("${install_root}" "${receipt_relative}.tmp")
symphony_receipt_v2_no_follow("${install_root}" ".symphony-lifecycle-ownership-v1.json")
symphony_receipt_v2_no_follow("${install_root}" "share/symphony/receipts/symphony-root-ownership/1/install-receipt.json")
set(receipt_absolute "${install_root}/${receipt_relative}")
set(ownership_registry "${install_root}/.symphony-lifecycle-ownership-v1.json")
set(ownership_fence "${install_root}/share/symphony/receipts/symphony-root-ownership/1/install-receipt.json")

# Once qxctl establishes the shared-root ownership fence or registry, direct
# package installers must not race the authenticated lifecycle circuit or
# create unclaimed inventory. Staged installs remain valid because their
# private root has neither marker; qxctl performs the serialized final mutation.
if(IS_SYMLINK "${ownership_registry}" OR EXISTS "${ownership_registry}" OR
   IS_SYMLINK "${ownership_fence}" OR EXISTS "${ownership_fence}")
    message(FATAL_ERROR
        "this installation root is administered by qxctl shared-root ownership; "
        "stage the package and use the authenticated lifecycle apply circuit")
endif()
if(EXISTS "${receipt_absolute}.tmp")
    message(FATAL_ERROR "receipt-v2 temporary target already exists")
endif()

# The receipt is the immutable commit marker for one exact package version.
# This preflight is deliberately registered before any owned-file install rule,
# so a direct CMake reinstall cannot overwrite an already committed version.
if(IS_SYMLINK "${receipt_absolute}" OR EXISTS "${receipt_absolute}")
    message(FATAL_ERROR
        "receipt-v2 already commits this exact package version at ${receipt_relative}; "
        "install a side-by-side version or run the package's exact uninstaller first")
endif()
