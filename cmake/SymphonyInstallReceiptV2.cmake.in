set(component_id "@SYMPHONY_RECEIPT_COMPONENT_ID@")
set(component_kind "@SYMPHONY_RECEIPT_COMPONENT_KIND@")
set(module_id "@SYMPHONY_RECEIPT_MODULE_ID@")
set(vector_id "@SYMPHONY_RECEIPT_VECTOR_ID@")
set(engine_id "@SYMPHONY_RECEIPT_ENGINE_ID@")
set(package_id "@SYMPHONY_RECEIPT_PACKAGE_ID@")
set(package_version "@SYMPHONY_RECEIPT_VERSION@")
set(receipt_relative "@SYMPHONY_RECEIPT_RECEIPT_PATH@")
set(owned_specs "@SYMPHONY_RECEIPT_OWNED_FILES@")
set(entry_specs "@SYMPHONY_RECEIPT_ENTRY_POINTS@")
set(provides "@SYMPHONY_RECEIPT_PROVIDES_CAPABILITIES@")
set(requires "@SYMPHONY_RECEIPT_REQUIRES_CAPABILITIES@")
set(receptors "@SYMPHONY_RECEIPT_COMPATIBLE_RECEPTORS@")
set(platform_os "@SYMPHONY_RECEIPT_OS@")
set(platform_arch "@SYMPHONY_RECEIPT_ARCH@")

function(json_string input output)
    string(REPLACE "\\" "\\\\" escaped "${input}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(require_token value label)
    string(LENGTH "${value}" value_length)
    if(value STREQUAL "" OR value_length GREATER 256 OR
       NOT value MATCHES "^[A-Za-z0-9._:-]+$")
        message(FATAL_ERROR "receipt-v2 ${label} is not a bounded token: ${value}")
    endif()
endfunction()

function(json_string_array output maximum)
    set(values ${ARGN})
    list(LENGTH values value_count)
    if(value_count GREATER maximum)
        message(FATAL_ERROR "receipt-v2 token array exceeds its ${maximum}-item bound")
    endif()
    list(SORT values)
    set(items "")
    set(previous "")
    foreach(value IN LISTS values)
        if(value STREQUAL "")
            message(FATAL_ERROR "receipt-v2 token arrays must not contain empty values")
        endif()
        require_token("${value}" "array value")
        if(value STREQUAL previous)
            message(FATAL_ERROR "receipt-v2 token arrays must not contain duplicates: ${value}")
        endif()
        set(previous "${value}")
        json_string("${value}" encoded)
        if(items STREQUAL "")
            set(items "${encoded}")
        else()
            string(APPEND items ",${encoded}")
        endif()
    endforeach()
    set(${output} "[${items}]" PARENT_SCOPE)
endfunction()

foreach(identity component_id module_id package_id)
    require_token("${${identity}}" "${identity}")
endforeach()
if(NOT component_kind MATCHES "^(coordinator|vector_engine|module|adapter|ui|service)$")
    message(FATAL_ERROR "receipt-v2 component kind is invalid: ${component_kind}")
endif()
if(NOT vector_id STREQUAL "")
    require_token("${vector_id}" "vector_id")
endif()
if(NOT engine_id STREQUAL "")
    require_token("${engine_id}" "engine_id")
endif()
string(LENGTH "${package_version}" version_length)
if(package_version STREQUAL "" OR version_length GREATER 64 OR
   NOT package_version MATCHES "^[0-9A-Za-z.+-]+$")
    message(FATAL_ERROR "receipt-v2 version is invalid: ${package_version}")
endif()

set(install_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
list(SORT owned_specs)
list(LENGTH owned_specs owned_count)
if(owned_count GREATER 4096)
    message(FATAL_ERROR "receipt-v2 owns more than 4096 files")
endif()
set(file_items "")
set(owned_paths "")
foreach(spec IN LISTS owned_specs)
    string(REPLACE "|" ";" fields "${spec}")
    list(LENGTH fields field_count)
    if(NOT field_count EQUAL 2)
        message(FATAL_ERROR "invalid receipt-v2 owned-file declaration: ${spec}")
    endif()
    list(GET fields 0 relative)
    list(GET fields 1 kind)
    if(NOT kind MATCHES "^(regular|executable)$" OR
       relative MATCHES "(^/|(^|/)\\.\\.?(/|$)|//|\\\\)" OR
       relative MATCHES "^\\.symphony-" OR
       relative MATCHES "^share/symphony/receipts(/|$)")
        message(FATAL_ERROR "unsafe receipt-v2 owned-file declaration: ${spec}")
    endif()
    list(FIND owned_paths "${relative}" duplicate_owned_path)
    if(NOT duplicate_owned_path EQUAL -1 OR relative STREQUAL receipt_relative)
        message(FATAL_ERROR "receipt-v2 owned-file path is duplicated or names the receipt: ${relative}")
    endif()
    list(APPEND owned_paths "${relative}")
    set(absolute "${install_root}/${relative}")
    if(IS_SYMLINK "${absolute}" OR NOT EXISTS "${absolute}" OR IS_DIRECTORY "${absolute}")
        message(FATAL_ERROR "receipt-v2 owned file is absent, non-regular, or a symlink: ${relative}")
    endif()
    file(SIZE "${absolute}" size)
    if(size GREATER 9007199254740991)
        message(FATAL_ERROR "receipt-v2 owned file exceeds the portable JSON size bound: ${relative}")
    endif()
    file(SHA256 "${absolute}" sha)
    json_string("${relative}" path_json)
    json_string("${kind}" kind_json)
    set(item "{\"digest\":\"sha256:${sha}\",\"kind\":${kind_json},\"path\":${path_json},\"size\":${size}}")
    if(file_items STREQUAL "")
        set(file_items "${item}")
    else()
        string(APPEND file_items ",${item}")
    endif()
endforeach()
set(files_json "[${file_items}]")

list(SORT entry_specs)
list(LENGTH entry_specs entry_count)
if(entry_count GREATER 128)
    message(FATAL_ERROR "receipt-v2 declares more than 128 entry points")
endif()
set(entry_items "")
set(entry_ids "")
foreach(spec IN LISTS entry_specs)
    string(REPLACE "|" ";" fields "${spec}")
    list(LENGTH fields field_count)
    if(NOT field_count EQUAL 4)
        message(FATAL_ERROR "invalid receipt-v2 entry-point declaration: ${spec}")
    endif()
    list(GET fields 0 entry_id)
    list(GET fields 1 entry_kind)
    list(GET fields 2 entry_path)
    list(GET fields 3 protocol_csv)
    require_token("${entry_id}" "entry point id")
    if(NOT entry_kind MATCHES "^(executable|descriptor|adapter)$")
        message(FATAL_ERROR "receipt-v2 entry point kind is invalid: ${entry_kind}")
    endif()
    list(FIND entry_ids "${entry_id}" duplicate_entry_id)
    list(FIND owned_paths "${entry_path}" owned_entry_path)
    if(NOT duplicate_entry_id EQUAL -1 OR owned_entry_path EQUAL -1)
        message(FATAL_ERROR "receipt-v2 entry point is duplicated or not receipt-owned: ${entry_id}")
    endif()
    list(APPEND entry_ids "${entry_id}")
    string(REPLACE "," ";" protocols "${protocol_csv}")
    json_string_array(protocols_json 64 ${protocols})
    json_string("${entry_id}" id_json)
    json_string("${entry_kind}" entry_kind_json)
    json_string("${entry_path}" entry_path_json)
    set(item "{\"entry_point_id\":${id_json},\"kind\":${entry_kind_json},\"path\":${entry_path_json},\"protocols\":${protocols_json}}")
    if(entry_items STREQUAL "")
        set(entry_items "${item}")
    else()
        string(APPEND entry_items ",${item}")
    endif()
endforeach()
set(entries_json "[${entry_items}]")

json_string_array(provides_json 128 ${provides})
json_string_array(requires_json 128 ${requires})
json_string_array(receptors_json 128 ${receptors})
json_string("${component_id}" component_id_json)
json_string("${component_kind}" component_kind_json)
json_string("${module_id}" module_id_json)
json_string("${package_id}" package_id_json)
json_string("${package_version}" version_json)
if(vector_id STREQUAL "")
    set(vector_id_json "null")
else()
    json_string("${vector_id}" vector_id_json)
endif()
if(engine_id STREQUAL "")
    set(engine_id_json "null")
else()
    json_string("${engine_id}" engine_id_json)
endif()

# This field order is the UTF-8 lexical key order emitted by Go's encoding/json
# for the digest-bearing object. The receipt_digest member itself is excluded.
set(canonical "{\"compatible_receptors\":${receptors_json},\"component_id\":${component_id_json},\"component_kind\":${component_kind_json},\"engine_id\":${engine_id_json},\"entry_points\":${entries_json},\"files\":${files_json},\"format_version\":2,\"install_scope\":\"prefix\",\"module_id\":${module_id_json},\"package_id\":${package_id_json},\"platform_requirements\":[{\"architecture\":\"${platform_arch}\",\"critical\":true,\"kernel_abi\":null,\"os\":\"${platform_os}\"}],\"prefix_mode\":\"installation_prefix\",\"protocol\":\"symphony.knowledge.install-receipt.v2\",\"provides_capabilities\":${provides_json},\"requires_capabilities\":${requires_json},\"vector_id\":${vector_id_json},\"version\":${version_json}}")
string(SHA256 receipt_sha "${canonical}")
string(REGEX REPLACE "}$" ",\"receipt_digest\":\"sha256:${receipt_sha}\"}" receipt_json "${canonical}")

set(receipt_absolute "${install_root}/${receipt_relative}")
get_filename_component(receipt_directory "${receipt_absolute}" DIRECTORY)
file(MAKE_DIRECTORY "${receipt_directory}")
set(receipt_temporary "${receipt_absolute}.tmp")
if(IS_SYMLINK "${receipt_absolute}" OR EXISTS "${receipt_absolute}")
    message(FATAL_ERROR "receipt-v2 target already exists; exact package versions are immutable")
endif()
if(IS_SYMLINK "${receipt_temporary}" OR EXISTS "${receipt_temporary}")
    message(FATAL_ERROR "receipt-v2 temporary target already exists")
endif()
file(WRITE "${receipt_temporary}" "${receipt_json}\n")
file(RENAME "${receipt_temporary}" "${receipt_absolute}")
