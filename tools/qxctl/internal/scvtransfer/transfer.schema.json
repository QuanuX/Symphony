        },
        "next_phase": {
          "enum": [
            "prepare_pending",
            "prepared",
            "commit_pending",
            "committed",
            "complete",
            ""
          ]
        },
        "next_operation_id": {
          "type": "string",
          "maxLength": 128
        },
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "recorded_complete",
            "recorded_incomplete"
          ]
        },
        "problem": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/InventoryManifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
