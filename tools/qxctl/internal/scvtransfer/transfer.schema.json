    "Imported_capture_schema_": {
      "title": "Capture v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "source",
        "locator_id",
        "resolved_uri",
        "redirects",
        "observed_at",
        "upstream_revision",
        "media_type",
        "body",
        "completeness",
        "issues",
        "body_digest",
        "byte_size",
        "digest"
      ],
      "properties": {
        "protocol": {
          "const": "symphony.scv.capture.v1"
        },
        "source": {
          "$ref": "#/$defs/Imported_source_schema_"
        },
        "locator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "resolved_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "redirects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 8,
          "minItems": 0
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "upstream_revision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scheme",
                "value"
              ],
              "properties": {
                "scheme": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "body": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65536
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 64,
          "minItems": 0
        },
        "body_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "description": "body maxLength is a structural character bound; runtime separately enforces 65536 UTF-8 bytes, excludes NUL, validates both digests and requires issues for partial/failed captures."
    },
