      ],
      "properties": {
        "protocol": {
          "const": "symphony.qxctl.scv-index-transfer-intent.v1"
        },
        "source_root": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "target_root": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "plan": {
          "$ref": "#/$defs/TransferPlanResult"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "TransferEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "transfer_digest",
        "sequence",
        "previous",
        "phase",
        "operation_id",
        "result_digest",
        "digest"
      ],
      "properties": {
        "protocol": {
          "const": "symphony.qxctl.scv-index-transfer-event.v1"
        },
        "transfer_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "previous": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "phase": {
          "enum": [
            "prepare_pending",
            "prepared",
            "commit_pending",
            "committed",
            "complete"
          ]
        },
        "operation_id": {
          "type": "string",
          "maxLength": 128
        },
        "result_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "const": ""
            }
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "enum": [
                  "prepared",
                  "committed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "else": {
            "properties": {
              "result_digest": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "operation_id": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "operation_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          }
        }
      ]
    },
    "TransferResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "transfer_digest",
        "source_root",
        "target_root",
        "events",
