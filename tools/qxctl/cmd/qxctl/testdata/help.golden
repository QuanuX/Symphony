qxctl - Symphony administrative spine

Usage:
  qxctl <command>

Commands:
  --help                            Print concise usage
  --version                         Print version
  doctor                            Perform local repository/admin-spine checks
  contracts                         Verify first runtime-set module contract surfaces
  modules                           List deterministic runtime modules
  modules check                     Verify contract shape for all modules
  modules metadata [--json]         Extract contract metadata for all modules
  module inspect <module-name>      Inspect a specific runtime module
  module check <module-name>        Verify contract shape for a module
  module metadata <module-name> [--json] Extract contract metadata for a module
  inventory [--json]                Emit deterministic runtime inventory snapshot
  inventory digest [--json]         Emit deterministic runtime inventory SHA-256 digest
  status [--json]                   Report consolidated administrative status
  validate scan --tops-id UUID --prefix PATH [--profile-id ID] [--baseline-id ID] [--json] Run full structured repository validation
  validate debug --tops-id UUID --prefix PATH [--rule ID|--record ID|--path PATH|--delta CLASS] [--json] Filter display after a full scan
  validate profile list|show|set|remove --tops-id UUID [...] Administer protected warning policy
  validate baseline create|show|remove --tops-id UUID [...] Administer protected warning baselines
  ssiag status --tops-id UUID [--scope user|system] [--json] Read safe SSIAG status
  ssiag providers --tops-id UUID [--scope user|system] [--json] List safe provider metadata
  ssiag doctor --tops-id UUID [--scope user|system] Verify local SSIAG availability
  stav status --tops-id UUID [--scope user|system] [--json] Read authenticated STAV status
  stav verify --tops-id UUID [--scope user|system] [--json] Verify the STAV digest chain
  stav query --tops-id UUID [--scope user|system] [bounded filters] [--json] Query authorized STAV projections
  stav doctor --tops-id UUID [--scope user|system] Run authenticated STAV diagnostics
  knowledge engines list [--state-root PATH] [--json] List the user-default exact engine bindings
  knowledge engines inspect ROLE [--state-root PATH] [--json] Inspect one exact engine binding
  knowledge engines doctor [--state-root PATH] [--json] Verify every bound installation
  knowledge engines bind ROLE --prefix PATH [--version VERSION] --expected-registry-digest STATE [--json] Bind an exact installation
  knowledge engines unbind ROLE --expected-registry-digest DIGEST [--json] Remove one exact binding
  knowledge reconcile compatibility [--state-root PATH] [--repo PATH] [--json] Negotiate coordinator compatibility
  knowledge reconcile begin --operation-id ID --expected-journal-digest STATE --path FILE... [--json] Begin a durable context
  knowledge reconcile status [--state-root PATH] [--repo PATH] [--json] Read durable context status
  knowledge reconcile checkpoint --operation-id ID --expected-journal-digest DIGEST [--json] Record a durable checkpoint
  knowledge reconcile close --operation-id ID --expected-journal-digest DIGEST [--json] Close a durable context
  knowledge reconcile recover --operation-id ID (--expected-journal-digest DIGEST|--discover) [--json] Repair from durable evidence
  knowledge session begin --tops-id UUID --operation-id ID --expected-journal-digest STATE [--context-ref REF...] [--json] Begin an authenticated authority epoch
  knowledge session status --tops-id UUID [--json] Read authenticated session status
  knowledge session checkpoint --tops-id UUID --operation-id ID --expected-journal-digest DIGEST [--context-ref REF...] [--json] Checkpoint an authenticated session
  knowledge session close --tops-id UUID --operation-id ID --expected-journal-digest DIGEST [--json] Close an authenticated session
  knowledge session recover --tops-id UUID --operation-id ID (--expected-journal-digest DIGEST|--discover) [--json] Recover authenticated session evidence
  knowledge session transition --tops-id UUID --event login|refresh|logout --event-id ID [--recover] [--json] Converge an explicit host lifecycle event
  knowledge lifecycle profile list --tops-id UUID [--profile-id ID] [--json] List protected lifecycle profiles
  knowledge lifecycle profile show --tops-id UUID [--profile-id ID] [--json] Read one protected lifecycle profile
  knowledge lifecycle profile set --tops-id UUID --input FILE --expected-profile-digest STATE [--profile-id ID] [--json] Commit exact desired profile intent
  knowledge lifecycle profile remove --tops-id UUID --expected-profile-digest DIGEST [--profile-id ID] [--json] Remove one protected lifecycle profile
  knowledge lifecycle observe --tops-id UUID [--profile-id ID | --root PATH...] [--json] Inventory fixed-layout receipts without execution
  knowledge lifecycle report --tops-id UUID [--profile-id ID] [--prior-applied-state-digest DIGEST] [--json] Re-observe and produce a dynamic report-only plan
  knowledge lifecycle boot --tops-id UUID --operation-id ID --expected-journal-digest STATE [--json] Durably record or replan report-only boot evidence
  knowledge lifecycle status --tops-id UUID [--profile-id ID] [--json] Read durable lifecycle boot state
  knowledge lifecycle recover --tops-id UUID --operation-id ID (--expected-journal-digest DIGEST|--discover) [--json] Repair uniquely linked lifecycle boot evidence
  knowledge lifecycle apply --tops-id UUID --operation-id ID --source-journal-digest DIGEST --expected-apply-journal-digest STATE --expected-applied-state-digest STATE [--source-root PATH...] [--json] Converge exact apply-compatible lifecycle actions
  knowledge lifecycle apply-status --tops-id UUID [--profile-id ID] [--json] Read durable apply-capable lifecycle state
  knowledge lifecycle apply-recover --tops-id UUID --operation-id ID (--expected-apply-journal-digest DIGEST|--discover) [--json] Repair uniquely linked apply-capable lifecycle evidence
  maestro inspect --prefix PATH --tops-id UUID --receptor-id ID [--version VERSION] [--json] Inspect an exact local receptor
  maestro status --prefix PATH --tops-id UUID --receptor-id ID [--component-id ID] [--json] Read authenticated presence
  maestro recover --prefix PATH --tops-id UUID --receptor-id ID --operation-id ID (--expected-registry-digest DIGEST|--discover) [--json] Repair unique presence evidence
  skvi inspect --prefix PATH [--version VERSION] [--json] Inspect an exact installed SKVI engine
  skvi check --prefix PATH [--version VERSION] [--json] Check canonical SKVI index truth
  skvi propose --prefix PATH --input FILE [--version VERSION] [--json] Prepare a caller-declared proposal
  skvi project --prefix PATH [--version VERSION] [--json] Build a disposable SKVI projection
  sclv inspect --prefix PATH [--version VERSION] [--json] Inspect an exact installed SCLV engine
  sclv check --prefix PATH [--version VERSION] [--json] Check canonical SCLV ledger truth
  sclv propose --prefix PATH --input FILE [--version VERSION] [--json] Prepare a provider-neutral record proposal
  sclv recover --prefix PATH --input FILE [--version VERSION] [--json] Reconcile ephemeral SCLV closure evidence
  sclv project --prefix PATH [--version VERSION] [--json] Build a disposable SCLV projection
  sacv inspect --prefix PATH [--version VERSION] [--json] Inspect an exact installed SACV engine
  sacv check --prefix PATH [--version VERSION] [--json] Check canonical SACV registry and API contracts
  sacv diff --prefix PATH --input FILE [--version VERSION] [--json] Compare bounded OpenAPI revisions
  sacv propose --prefix PATH --input FILE [--version VERSION] [--json] Prepare a caller-declared registry proposal
  sacv project --prefix PATH [--version VERSION] [--json] Build a disposable SACV inventory
  sodv inspect --prefix PATH [--version VERSION] [--json] Inspect an exact installed SODV engine
  sodv check --prefix PATH [--version VERSION] [--json] Check canonical release transaction truth
  sodv verify --prefix PATH --input FILE [--version VERSION] [--json] Verify caller-observed publication state
  sodv propose --prefix PATH --input FILE [--version VERSION] [--json] Prepare a release-record proposal
  sodv recover --prefix PATH --input FILE [--version VERSION] [--json] Reconcile an interrupted release journal
  sodv project --prefix PATH [--version VERSION] [--json] Build a disposable release inventory
  ssfv inspect --prefix PATH [--version VERSION] [--json] Inspect an exact installed SSFV engine
  ssfv check --prefix PATH [--version VERSION] [freshness flags] [--json] Check canonical semantic-feature truth
  ssfv diff --prefix PATH --input FILE [--version VERSION] [--json] Compare a semantic baseline with live truth
  ssfv propose --prefix PATH --input FILE [--version VERSION] [--json] Prepare a caller-declared semantic proposal
  ssfv graph --prefix PATH [--version VERSION] [--json] Build a disposable semantic-feature graph
