{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "symphony.qxctl.shv-source-activation-schema-document.v1",
  "$comment": "CLI-owned activation definitions. Source definitions copied from SHV source engine0.1.0-dev (sha256:a003a7b79297e46e6b230336a9dedebb33b00786d6e32f344045c6f009af38ae); SSIAG decision/capability schemas retain their owner IDs. Shape checks do not authenticate authority, validate seals or replace source reduction.",
  "$defs": {
    "Node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 32
        },
        "properties": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "labels",
        "properties"
      ],
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "properties": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "label",
        "properties"
      ],
      "additionalProperties": false
    },
    "Graph": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "symphony.graph.exchange.v1"
        },
        "owner": {
          "type": "object",
          "properties": {
            "engine_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "engine_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "artifact_protocol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "artifact_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "engine_id",
            "engine_version",
            "artifact_protocol",
            "artifact_digest"
          ],
          "additionalProperties": false
        },
        "owner_artifact": {
          "type": "object",
          "required": [
            "protocol",
            "digest"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 1024
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 2048
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocol",
        "owner",
        "owner_artifact",
        "nodes",
        "edges",
        "digest"
      ],
      "additionalProperties": false
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z.+-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "featureId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^ssfv:[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "operationId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^engop:[a-z][a-z0-9-]{0,62}:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_operation_id",
        "operation_name",
        "availability",
        "feature_ids",
        "administrative_interactions",
        "administration_disposition",
        "input_protocol",
        "output_protocol",
        "mutability",
        "idempotency",
        "expected_state_required",
        "authorization_requirement",
        "recovery_operation_id",
        "direct_invocation",
        "thermal_path"
      ],
      "properties": {
        "engine_operation_id": {
          "$ref": "#/$defs/operationId"
        },
        "operation_name": {
          "$ref": "#/$defs/token"
        },
        "availability": {
          "enum": [
            "implemented",
            "reserved",
            "disabled"
          ]
        },
        "feature_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/featureId"
          }
        },
        "administrative_interactions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/interaction"
          }
        },
        "administration_disposition": {
          "enum": [
            "unreviewed",
            "qxctl_required",
            "lifecycle_only",
            "runtime_only",
            "system_orchestrated",
            "prohibited",
            "not_applicable"
          ]
        },
        "input_protocol": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/token"
            }
          ]
        },
        "output_protocol": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/token"
            }
          ]
        },
        "mutability": {
          "enum": [
            "read_only",
            "evidence_only",
            "proposal_only",
            "permission_backed_mutation",
            "prohibited"
          ]
        },
        "idempotency": {
          "enum": [
            "not_applicable",
            "idempotent",
            "idempotent_with_invocation_id",
            "non_idempotent"
          ]
        },
        "expected_state_required": {
          "type": "boolean"
        },
        "authorization_requirement": {
          "enum": [
            "none",
            "target_host_permission",
            "ssiag"
          ]
        },
        "recovery_operation_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/operationId"
            }
          ]
        },
        "direct_invocation": {
          "enum": [
            "supported",
            "diagnostic_only",
            "prohibited"
          ]
        },
        "thermal_path": {
          "enum": [
            "freezing",
            "warm",
            "hot"
          ]
        }
      }
    },
    "interaction": {
      "enum": [
        "discover",
        "inspect",
        "query",
        "validate",
        "configure",
        "propose",
        "invoke",
        "apply",
        "lifecycle",
        "recover"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_bytes",
        "response_bytes",
        "json_depth",
        "json_values",
        "path_bytes",
        "snapshot_files",
        "snapshot_file_bytes",
        "deadline_ahead_ms"
      ],
      "properties": {
        "request_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "json_depth": {
          "type": "integer",
          "minimum": 1
        },
        "json_values": {
          "type": "integer",
          "minimum": 1
        },
        "path_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_files": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "deadline_ahead_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Descriptor": {
      "title": "Symphony knowledge engine descriptor v2",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "format_version",
        "module_id",
        "engine_id",
        "vector_id",
        "engine_version",
        "process_protocols",
        "contract_versions",
        "operations",
        "limits",
        "supported_scopes",
        "language",
        "thermal_path",
        "canonical_apply_enabled",
        "session_mutation_enabled",
        "network_listener",
        "descriptor_digest"
      ],
      "properties": {
        "protocol": {
          "const": "symphony.knowledge.engine-descriptor.v2"
        },
        "format_version": {
          "const": 2
        },
        "module_id": {
          "$ref": "#/$defs/token"
        },
        "engine_id": {
          "$ref": "#/$defs/token"
        },
        "vector_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/token"
            }
          ]
        },
        "engine_version": {
          "$ref": "#/$defs/version"
        },
        "process_protocols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "contract_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "supported_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "user",
              "system",
              "tops"
            ]
          }
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9+.#_-]+$"
        },
        "thermal_path": {
          "enum": [
            "freezing",
            "warm",
            "hot"
          ]
        },
        "canonical_apply_enabled": {
          "type": "boolean"
        },
        "session_mutation_enabled": {
          "type": "boolean"
        },
        "network_listener": {
          "type": "boolean"
        },
        "descriptor_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "Locator": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^https?://[A-Za-z0-9][A-Za-z0-9.-]*(?::[1-9][0-9]{0,4})?(?:[/?][!-~]*)?$"
        },
        "format": {
          "enum": [
            "html",
            "opaque"
          ]
        }
      },
      "required": [
        "id",
        "uri",
        "format"
      ],
      "additionalProperties": false
    },
    "SourceDefinition": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "authority_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "maxItems": 32,
          "minItems": 1,
          "uniqueItems": true
        },
        "locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Locator"
          },
          "maxItems": 16,
          "minItems": 1
        }
      },
      "required": [
        "source_id",
        "publisher",
        "authority_role",
        "subject_ids",
        "locators"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "symphony.shv.source-revision.v1"
        },
        "definition": {
          "$ref": "#/$defs/SourceDefinition"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "previous_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocol",
        "definition",
        "generation",
        "previous_digest",
        "digest"
      ],
      "additionalProperties": false
    },
    "InspectInput": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "SourcePlanInput": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ]
        },
        "desired": {
          "$ref": "#/$defs/SourceDefinition"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "operation_id",
        "current",
        "desired",
        "reason"
      ],
      "additionalProperties": false
    },
    "SourcePlan": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "symphony.shv.source-plan.v1"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "expected_state_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "change_kind": {
          "enum": [
            "onboard",
            "authority_change",
            "relocation"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocol",
        "operation_id",
        "expected_state_digest",
        "change_kind",
        "reason",
        "source",
        "digest"
      ],
      "additionalProperties": false
    },
    "SourceReduceInput": {
      "type": "object",
      "properties": {
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan": {
          "$ref": "#/$defs/SourcePlan"
        }
      },
      "required": [
        "current",
        "plan"
      ],
      "additionalProperties": false
    },
    "SourceTransition": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "symphony.shv.source-transition.v1"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "expected_state_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocol",
        "operation_id",
        "expected_state_digest",
        "source",
        "digest"
      ],
      "additionalProperties": false
    },
    "SourceStatusInput": {
      "type": "object",
      "properties": {
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 32,
          "minItems": 1
        }
      },
      "required": [
        "history"
      ],
      "additionalProperties": false
    },
    "SourceStatus": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "symphony.shv.source-status.v1"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "history_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "maxItems": 32,
          "minItems": 1,
          "uniqueItems": true
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "protocol",
        "source",
        "history_digests",
        "digest"
      ],
      "additionalProperties": false
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "format": {
          "enum": [
            "html",
            "opaque"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "bytes",
        "digest",
        "format"
      ],
      "additionalProperties": false
    },
    "UpstreamRevision": {
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "additionalProperties": false
    },
    "CaptureImportInput": {
      "type": "object",
      "properties": {
        "source_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "locator_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "resolved_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^https?://[A-Za-z0-9][A-Za-z0-9.-]*(?::[1-9][0-9]{0,4})?(?:[/?][!-~]*)?$"
        },
        "redirect_chain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^https?://[A-Za-z0-9][A-Za-z0-9.-]*(?::[1-9][0-9]{0,4})?(?:[/?][!-~]*)?$"
          },
          "maxItems": 8,
          "minItems": 0,
          "uniqueItems": true
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "upstream_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/UpstreamRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest": {
          "$ref": "#/$defs/Manifest"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 32,
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "source_root",
        "source",
        "locator_id",
        "resolved_uri",
        "redirect_chain",
        "observed_at",
        "upstream_revision",
        "manifest",
        "completeness",
        "issues"
      ],
      "additionalProperties": false
    },
    "Capture": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "symphony.shv.source-capture.v1"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "locator_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "resolved_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^https?://[A-Za-z0-9][A-Za-z0-9.-]*(?::[1-9][0-9]{0,4})?(?:[/?][!-~]*)?$"
        },
        "redirect_chain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^https?://[A-Za-z0-9][A-Za-z0-9.-]*(?::[1-9][0-9]{0,4})?(?:[/?][!-~]*)?$"
          },
          "maxItems": 8,
          "minItems": 0,
          "uniqueItems": true
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "upstream_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/UpstreamRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest": {
          "$ref": "#/$defs/Manifest"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 32,
          "minItems": 0,
          "uniqueItems": true
        },
        "digest": {
          "type": "string",
