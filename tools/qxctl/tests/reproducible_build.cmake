cmake_minimum_required(VERSION 3.30)
# This is a build-evidence recipe, not a package publication or activation path.
find_program(QXCTL_GIT NAMES git REQUIRED)
file(REAL_PATH "${QXCTL_MODULE}" module)
if(NOT IS_ABSOLUTE "${QXCTL_WORK}" OR EXISTS "${QXCTL_WORK}" OR IS_SYMLINK "${QXCTL_WORK}")
  message(FATAL_ERROR "Qualification requires a new absolute work directory")
endif()
execute_process(COMMAND "${QXCTL_GIT}" --no-replace-objects -C "${module}" rev-parse --show-toplevel
  RESULT_VARIABLE status OUTPUT_VARIABLE repository OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "A complete Git checkout is required for source identity")
endif()
file(REAL_PATH "${repository}" repository)
get_filename_component(work_parent "${QXCTL_WORK}" DIRECTORY)
get_filename_component(work_name "${QXCTL_WORK}" NAME)
if(NOT IS_DIRECTORY "${work_parent}" OR work_name STREQUAL "" OR work_name MATCHES "^\\.\\.?$")
  message(FATAL_ERROR "Work directory requires an existing parent and a new directory name")
endif()
file(REAL_PATH "${work_parent}" work_parent)
set(work "${work_parent}/${work_name}")
cmake_path(IS_PREFIX repository "${work}" NORMALIZE inside)
if(inside)
  message(FATAL_ERROR "Qualification builds must be outside the source checkout")
endif()
execute_process(COMMAND "${QXCTL_GIT}" --no-replace-objects -C "${repository}" status --porcelain --untracked-files=normal
  RESULT_VARIABLE status OUTPUT_VARIABLE dirty)
if(NOT status EQUAL 0 OR NOT dirty STREQUAL "")
  message(FATAL_ERROR "Candidate source must be clean, including untracked files")
endif()
file(MAKE_DIRECTORY "${work}/logs" "${work}/modules" "${work}/go-tmp" "${work}/telemetry")
file(WRITE "${work}/telemetry/mode" "off\n")
set(ENV{GOMODCACHE} "${work}/modules")
set(ENV{GOTMPDIR} "${work}/go-tmp")
set(ENV{TEST_TELEMETRY_DIR} "${work}/telemetry")

function(run name directory)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${directory}"
    RESULT_VARIABLE result OUTPUT_FILE "${work}/logs/${name}.log" ERROR_FILE "${work}/logs/${name}.log")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${name} failed (${result}); see ${work}/logs/${name}.log")
  endif()
endfunction()
function(git_value output)
  execute_process(COMMAND "${QXCTL_GIT}" --no-replace-objects -C "${repository}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Unable to read source identity: ${ARGN}")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()
git_value(commit rev-parse HEAD)
git_value(tree rev-parse "${commit}^{tree}")
git_value(epoch show -s --format=%ct "${commit}")
if(NOT epoch MATCHES "^(0|[1-9][0-9]*)$")
  message(FATAL_ERROR "Source commit time must be a nonnegative integer")
endif()
set(ENV{SOURCE_DATE_EPOCH} "${epoch}")
file(READ "${module}/go.mod" go_mod)
string(REGEX MATCH "\ngo ([0-9.]+)\n" match "\n${go_mod}")
set(required_go "go${CMAKE_MATCH_1}")
execute_process(COMMAND "${QXCTL_GO}" env GOVERSION GOHOSTOS GOHOSTARCH
  RESULT_VARIABLE status OUTPUT_VARIABLE go_environment OUTPUT_STRIP_TRAILING_WHITESPACE)
string(REPLACE "\n" ";" environment "${go_environment}")
list(LENGTH environment count)
if(NOT status EQUAL 0 OR NOT count EQUAL 3)
  message(FATAL_ERROR "Unable to inspect the selected Go toolchain")
endif()
list(GET environment 0 actual_go)
list(GET environment 1 goos)
list(GET environment 2 goarch)
if(NOT actual_go STREQUAL required_go OR NOT actual_go STREQUAL "go1.26.5")
  message(FATAL_ERROR "Exact Go 1.26.5 required; found ${actual_go}")
endif()
if(NOT goos MATCHES "^(darwin|linux)$" OR NOT goarch MATCHES "^(amd64|arm64)$")
  message(FATAL_ERROR "Qualification recipe admits native macOS/Linux x86_64/ARM64 only")
endif()
foreach(input IN ITEMS mvp-dependencies mvp-release-identities)
  execute_process(COMMAND "${QXCTL_GIT}" --no-replace-objects -C "${repository}" show
    "${commit}:cmake/${input}.json" RESULT_VARIABLE status
    OUTPUT_FILE "${work}/${input}.json" ERROR_FILE "${work}/logs/${input}-source.log")
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot bind committed ${input}.json")
  endif()
endforeach()
set(map "${work}/mvp-dependencies.json")
file(SHA256 "${map}" map_sha256)
file(SHA256 "${work}/mvp-release-identities.json" catalog_sha256)
file(SHA256 "${module}/go.mod" go_mod_sha256)
file(SHA256 "${module}/go.sum" go_sum_sha256)
set(recipe "symphony.qxctl.reproducible-build.v1")
set(package "github.com/QuanuX/Symphony/tools/qxctl/internal/version")
set(ldflags "-buildid= -X ${package}.SourceCommit=${commit} -X ${package}.SourceTree=${tree} -X ${package}.SourceDateEpoch=${epoch} -X ${package}.DependencyMapSHA256=${map_sha256} -X ${package}.BuildRecipe=${recipe}")
run(source-archive "${work}" "${QXCTL_GIT}" --no-replace-objects -C "${repository}" archive
  --format=tar "--output=${work}/source.tar" "${commit}" tools/qxctl)
foreach(copy IN ITEMS first second)
  set(root "${work}/${copy}")
  file(MAKE_DIRECTORY "${root}" "${root}/cache" "${root}/gopath" "${root}/bin")
  run("${copy}-extract" "${root}" "${CMAKE_COMMAND}" -E tar xf "${work}/source.tar")
  set(source "${root}/tools/qxctl")
  file(GLOB_RECURSE source_entries LIST_DIRECTORIES TRUE "${source}/*")
  foreach(entry IN LISTS source_entries)
    if(IS_SYMLINK "${entry}")
      message(FATAL_ERROR "Standalone source copies must not contain symlinks")
    endif()
  endforeach()
  set(ENV{GOCACHE} "${root}/cache")
  set(ENV{GOPATH} "${root}/gopath")
  file(SHA256 "${source}/go.mod" before_mod)
  file(SHA256 "${source}/go.sum" before_sum)
  if(NOT before_mod STREQUAL go_mod_sha256 OR NOT before_sum STREQUAL go_sum_sha256)
    message(FATAL_ERROR "Archived module metadata differs from the clean source")
  endif()
  execute_process(COMMAND "${QXCTL_GO}" list -mod=readonly -m
    -f "{{if .Replace}}{{.Path}} => {{.Replace.Path}} {{.Replace.Version}}{{end}}" all
    WORKING_DIRECTORY "${source}" RESULT_VARIABLE graph_status
    OUTPUT_FILE "${work}/logs/${copy}-replacements.log" ERROR_FILE "${work}/logs/${copy}-graph-diagnostics.log")
  if(NOT graph_status EQUAL 0)
    message(FATAL_ERROR "${copy} module graph failed; see its graph-diagnostics.log")
  endif()
  file(READ "${work}/logs/${copy}-replacements.log" replacements)
  string(STRIP "${replacements}" replacements)
  if(NOT replacements STREQUAL "")
    message(FATAL_ERROR "Standalone identity builds must not select replacements")
  endif()
  set(binary "${root}/bin/qxctl")
  run("${copy}-build" "${source}" "${QXCTL_GO}" build -mod=readonly -trimpath -buildvcs=false
    "-ldflags=${ldflags}" -o "${binary}" ./cmd/qxctl)
  run("${copy}-module-verification" "${source}" "${QXCTL_GO}" mod verify)
  run("${copy}-identity" "${root}" "${binary}" version --json)
  run("${copy}-version" "${root}" "${binary}" --version)
  file(READ "${work}/logs/${copy}-version.log" reported_version)
  if(NOT reported_version STREQUAL "qxctl version 0.1.0-dev\n")
    message(FATAL_ERROR "Compiled qxctl display version differs from the candidate identity")
  endif()
  file(SHA256 "${binary}" binary_sha256)
  file(READ "${work}/logs/${copy}-identity.log" identity)
  foreach(field IN ITEMS source_commit source_tree source_date_epoch dependency_map_sha256 build_recipe go_version goos goarch executable_sha256)
    string(JSON value ERROR_VARIABLE error GET "${identity}" "${field}")
    if(error)
      message(FATAL_ERROR "Build identity lacks ${field}: ${error}")
    endif()
    if(field STREQUAL "source_commit")
      set(expected "${commit}")
    elseif(field STREQUAL "source_tree")
      set(expected "${tree}")
    elseif(field STREQUAL "source_date_epoch")
      set(expected "${epoch}")
    elseif(field STREQUAL "dependency_map_sha256")
      set(expected "${map_sha256}")
    elseif(field STREQUAL "build_recipe")
      set(expected "${recipe}")
    elseif(field STREQUAL "go_version")
      set(expected "${actual_go}")
    elseif(field STREQUAL "executable_sha256")
      set(expected "${binary_sha256}")
    else()
      set(expected "${${field}}")
    endif()
    if(NOT value STREQUAL expected)
      message(FATAL_ERROR "Reported ${field} differs from independent build evidence")
    endif()
  endforeach()
  string(JSON source_state GET "${identity}" source_state)
  string(JSON version GET "${identity}" version)
  string(JSON protocol GET "${identity}" protocol)
  string(JSON component GET "${identity}" component_id)
  if(NOT source_state STREQUAL "stamped" OR NOT protocol STREQUAL "symphony.qxctl.build-info.v1" OR
      NOT component STREQUAL "qxctl" OR NOT version STREQUAL "0.1.0-dev")
    message(FATAL_ERROR "Unexpected current qxctl identity")
  endif()
  file(SHA256 "${source}/go.mod" after_mod)
  file(SHA256 "${source}/go.sum" after_sum)
  if(NOT before_mod STREQUAL after_mod OR NOT before_sum STREQUAL after_sum)
    message(FATAL_ERROR "Candidate build changed module metadata")
  endif()
  set("${copy}_sha256" "${binary_sha256}")
  file(WRITE "${work}/${copy}-build-info.json" "${identity}")
endforeach()
if(NOT first_sha256 STREQUAL second_sha256)
  message(FATAL_ERROR "Two isolated native builds produced different binary hashes")
endif()
git_value(final_head rev-parse HEAD)
git_value(final_status status --porcelain --untracked-files=normal)
if(NOT final_head STREQUAL commit OR NOT final_status STREQUAL "")
  message(FATAL_ERROR "Source checkout changed during qualification")
endif()
# Values interpolated here are fixed identifiers, validated decimal/hex values,
# toolchain versions or enumerated target strings; no unescaped paths are used.
file(WRITE "${work}/artifact-identity.json" "{\n  \"protocol\": \"symphony.artifact-build-identity.v1\",\n  \"component_id\": \"qxctl\",\n  \"version\": \"${version}\",\n  \"binary_name\": \"qxctl\",\n  \"source_commit\": \"${commit}\",\n  \"source_tree\": \"${tree}\",\n  \"source_date_epoch\": \"${epoch}\",\n  \"dependency_map_sha256\": \"${map_sha256}\",\n  \"release_identity_catalog_sha256\": \"${catalog_sha256}\",\n  \"go_mod_sha256\": \"${go_mod_sha256}\",\n  \"go_sum_sha256\": \"${go_sum_sha256}\",\n  \"build_recipe\": \"${recipe}\",\n  \"go_version\": \"${actual_go}\",\n  \"goos\": \"${goos}\",\n  \"goarch\": \"${goarch}\",\n  \"executable_sha256\": \"${first_sha256}\",\n  \"isolated_builds\": 2,\n  \"reproducibility\": \"verified_on_recorded_profile\",\n  \"publication_authorized\": false\n}\n")
message(STATUS "PASS qxctl reproducibility: ${goos}/${goarch}, two isolated paths/caches, SHA256 ${first_sha256}")
