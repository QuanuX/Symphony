cmake_minimum_required(VERSION 3.31)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT IS_ABSOLUTE "${NOTICE_TEST_WORK}" OR EXISTS "${NOTICE_TEST_WORK}")
  message(FATAL_ERROR "Fresh absolute notice-test directory required")
endif()
file(MAKE_DIRECTORY "${NOTICE_TEST_WORK}/source/cmake")
file(COPY "${repo}/cmake/SymphonyDependencyNotices.cmake" "${repo}/cmake/notices" DESTINATION "${NOTICE_TEST_WORK}/source/cmake")
file(WRITE "${NOTICE_TEST_WORK}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.31)
project(NoticeInstall NONE)
include(cmake/SymphonyDependencyNotices.cmake)
symphony_dependency_notice(curl curl_notice)
symphony_dependency_notice(zstd zstd_notice)
install(FILES "${curl_notice}" DESTINATION share/licenses/curl RENAME COPYING)
install(FILES "${zstd_notice}" DESTINATION share/licenses/zstd RENAME LICENSE)
]=])
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${NOTICE_TEST_WORK}/source" -B "${NOTICE_TEST_WORK}/build" -DCMAKE_FIND_USE_SYSTEM_ENVIRONMENT_PATH=OFF -DCMAKE_FIND_USE_CMAKE_SYSTEM_PATH=OFF -DCMAKE_MAKE_PROGRAM=/usr/bin/make RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Clean no-package-manager notice configure failed: ${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${NOTICE_TEST_WORK}/build" --prefix "${NOTICE_TEST_WORK}/prefix" RESULT_VARIABLE result OUTPUT_QUIET)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Notice installation failed")
endif()
foreach(pair "curl-8.7.1.COPYING|curl/COPYING" "zstd-1.5.7.LICENSE|zstd/LICENSE")
  string(REPLACE "|" ";" pair "${pair}")
  list(GET pair 0 source)
  list(GET pair 1 installed)
  file(SHA256 "${repo}/cmake/notices/${source}" expected)
  file(SHA256 "${NOTICE_TEST_WORK}/prefix/share/licenses/${installed}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Installed notice changed")
  endif()
endforeach()
file(APPEND "${NOTICE_TEST_WORK}/source/cmake/notices/zstd-1.5.7.LICENSE" "changed")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${NOTICE_TEST_WORK}/source" -B "${NOTICE_TEST_WORK}/tampered" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Tampered notice was admitted")
endif()
file(REMOVE "${NOTICE_TEST_WORK}/source/cmake/notices/zstd-1.5.7.LICENSE")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${NOTICE_TEST_WORK}/source" -B "${NOTICE_TEST_WORK}/missing" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Missing notice was admitted")
endif()
file(CREATE_LINK "${repo}/cmake/notices/zstd-1.5.7.LICENSE" "${NOTICE_TEST_WORK}/source/cmake/notices/zstd-1.5.7.LICENSE" SYMBOLIC)
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${NOTICE_TEST_WORK}/source" -B "${NOTICE_TEST_WORK}/symlink" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Symlink notice was admitted")
endif()
message(STATUS "Notice regressions: clean configure/install, two exact copies, tamper/missing/symlink refusal passed")
