cmake_minimum_required(VERSION 3.30)
file(READ "${RESULT_JUNIT}" junit)
if(junit MATCHES "<skipped[ >]" OR junit MATCHES "<failure[ >]")
  message(FATAL_ERROR "Selected native tests failed or skipped: ${RESULT_JUNIT}")
endif()
string(REGEX MATCHALL "<testcase[ >]" cases "${junit}")
list(LENGTH cases actual_count)
if(NOT actual_count EQUAL EXPECTED_TEST_COUNT)
  message(FATAL_ERROR "Expected ${EXPECTED_TEST_COUNT} native tests, JUnit recorded ${actual_count}")
endif()
file(STRINGS "${RESULT_LOG}" lines)
set(internal_skips "")
foreach(line IN LISTS lines)
  if(line MATCHES "(^|[ :])SKIP[ :]")
    set(admitted FALSE)
    foreach(pattern IN LISTS ALLOWED_INTERNAL_SKIPS)
      string(FIND "${line}" "${pattern}" found)
      if(NOT found LESS 0)
        set(admitted TRUE)
      endif()
    endforeach()
    if(NOT admitted)
      message(FATAL_ERROR "Unclassified internal native skip: ${line}")
    endif()
    list(APPEND internal_skips "${line}")
  endif()
endforeach()
list(LENGTH ALLOWED_INTERNAL_SKIPS expected_skips)
list(LENGTH internal_skips actual_skips)
if(NOT actual_skips EQUAL expected_skips)
  message(FATAL_ERROR "Expected ${expected_skips} declared historical internal skips, observed ${actual_skips}")
endif()
file(WRITE "${RESULT_LOG}.scope.txt" "Executed CTests: ${actual_count}\nAdmitted historical internal skips (not coverage): ${internal_skips}\n")
message(STATUS "PASS ${actual_count} selected CTests; admitted internal historical skips recorded separately")
