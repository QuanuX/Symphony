include("${CMAKE_CURRENT_LIST_DIR}/../mvp-dependencies/common.cmake")
if(NOT DEFINED RELEASE_MANIFEST)
  set(RELEASE_MANIFEST "${CMAKE_CURRENT_LIST_DIR}/manifest.json")
endif()
file(READ "${RELEASE_MANIFEST}" qualification)
file(READ "${MVP_MAP}" projection)
string(JSON format GET "${qualification}" format_version)
if(NOT format EQUAL 1)
  message(FATAL_ERROR "Unsupported release qualification manifest")
endif()
foreach(field component_roots go_modules)
  set(expected "")
  set(actual "")
  foreach(binding projection qualification)
    mvp_indices(indices "${${binding}}" "${field}")
    foreach(index IN LISTS indices)
      string(JSON path GET "${${binding}}" "${field}" ${index} path)
      if(binding STREQUAL "projection")
        list(APPEND expected "${path}")
      else()
        list(APPEND actual "${path}")
      endif()
    endforeach()
  endforeach()
  list(SORT expected)
  list(SORT actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Release manifest ${field} differs from the dependency projection")
  endif()
endforeach()
set(expected "")
mvp_indices(indices "${projection}" native_components)
foreach(index IN LISTS indices)
  string(JSON path GET "${projection}" native_components ${index} path)
  list(APPEND expected "${path}")
endforeach()
set(actual "")
foreach(field native_suites native_exclusions)
  mvp_indices(indices "${qualification}" ${field})
  foreach(index IN LISTS indices)
    string(JSON path GET "${qualification}" ${field} ${index} path)
    if(path IN_LIST actual)
      message(FATAL_ERROR "Duplicate native qualification entry: ${path}")
    endif()
    list(APPEND actual "${path}")
    if(field STREQUAL "native_exclusions")
      string(JSON reason GET "${qualification}" ${field} ${index} reason)
      if(reason STREQUAL "")
        message(FATAL_ERROR "Excluded native root requires an explicit reason")
      endif()
    else()
      string(JSON group GET "${qualification}" ${field} ${index} group)
      if(NOT group MATCHES "^(knowledge|cloud|quantitative|duckdb|build_support)$")
        message(FATAL_ERROR "Unknown native test group for ${path}")
      endif()
      string(JSON tests LENGTH "${qualification}" ${field} ${index} ctests)
      string(JSON direct LENGTH "${qualification}" ${field} ${index} direct_tests)
      if(tests EQUAL 0 AND direct EQUAL 0)
        string(JSON reason GET "${qualification}" ${field} ${index} no_native_suite_reason)
        if(reason STREQUAL "")
          message(FATAL_ERROR "Unqualified native root lacks a reason: ${path}")
        endif()
      endif()
    endif()
  endforeach()
endforeach()
list(SORT expected)
list(SORT actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Every native root needs a suite or explicit exclusion")
endif()
mvp_indices(indices "${qualification}" optional_go_tests)
foreach(index IN LISTS indices)
  string(JSON path GET "${qualification}" optional_go_tests ${index} source)
  string(JSON name GET "${qualification}" optional_go_tests ${index} test)
  string(JSON classification GET "${qualification}" optional_go_tests ${index} classification)
  if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)" OR classification STREQUAL "")
    message(FATAL_ERROR "Invalid optional Go test declaration")
  endif()
  file(READ "${MVP_REPOSITORY}/${path}" source)
  string(FIND "${source}" "func ${name}(" found)
  if(found LESS 0)
    message(FATAL_ERROR "Optional Go test no longer exists: ${path} ${name}")
  endif()
endforeach()
foreach(field installed_go_suites required_go_tests)
  mvp_indices(indices "${qualification}" ${field})
  foreach(index IN LISTS indices)
    string(JSON module GET "${qualification}" ${field} ${index} module)
    string(JSON package GET "${qualification}" ${field} ${index} package)
    file(GLOB sources "${MVP_REPOSITORY}/${module}/${package}/*_test.go")
    set(declarations "")
    foreach(path IN LISTS sources)
      file(READ "${path}" source)
      string(APPEND declarations "${source}\n")
    endforeach()
    mvp_indices(tests "${qualification}" ${field} ${index} tests)
    foreach(test IN LISTS tests)
      string(JSON name GET "${qualification}" ${field} ${index} tests ${test})
      string(FIND "${declarations}" "func ${name}(" found)
      if(found LESS 0)
        message(FATAL_ERROR "Required Go test no longer exists: ${module} ${package} ${name}")
      endif()
    endforeach()
  endforeach()
endforeach()
message(STATUS "PASS release manifest: all component/native/Go roots accounted for; optional skips remain explicit")
