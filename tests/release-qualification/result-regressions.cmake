cmake_minimum_required(VERSION 3.30)
if(NOT IS_ABSOLUTE "${RESULT_TEST_WORK}" OR EXISTS "${RESULT_TEST_WORK}")
  message(FATAL_ERROR "RESULT_TEST_WORK must be a fresh absolute directory")
endif()
file(MAKE_DIRECTORY "${RESULT_TEST_WORK}")
foreach(case pass missing skipped unexpected_internal historical)
  set(xml "<testsuite><testcase name=\"real\"></testcase></testsuite>")
  set(log "1: PASS real\n")
  set(allowed "")
  if(case STREQUAL "missing")
    set(xml "<testsuite></testsuite>")
  elseif(case STREQUAL "skipped")
    set(xml "<testsuite><testcase name=\"real\"><skipped /></testcase></testsuite>")
  elseif(case STREQUAL "unexpected_internal")
    set(log "1: SKIP missing installation\n")
  elseif(case STREQUAL "historical")
    set(log "1: SKIP provider coverage is an exact .5 addition\n")
    set(allowed "SKIP provider coverage is an exact .5 addition")
  endif()
  file(WRITE "${RESULT_TEST_WORK}/${case}.xml" "${xml}\n")
  file(WRITE "${RESULT_TEST_WORK}/${case}.log" "${log}")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DRESULT_JUNIT=${RESULT_TEST_WORK}/${case}.xml"
    "-DRESULT_LOG=${RESULT_TEST_WORK}/${case}.log" -DEXPECTED_TEST_COUNT=1
    "-DALLOWED_INTERNAL_SKIPS=${allowed}" -P "${CMAKE_CURRENT_LIST_DIR}/check-results.cmake"
    RESULT_VARIABLE status OUTPUT_FILE "${RESULT_TEST_WORK}/${case}-check.log"
    ERROR_FILE "${RESULT_TEST_WORK}/${case}-check.log")
  if(case STREQUAL "pass" OR case STREQUAL "historical")
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Valid result fixture was rejected: ${case}")
    endif()
  elseif(status EQUAL 0)
    message(FATAL_ERROR "Incomplete result fixture was accepted: ${case}")
  endif()
endforeach()
message(STATUS "PASS native result gate: missing execution, skipped tests and unknown internal skips refused")
