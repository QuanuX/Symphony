set(request "${REQUEST_DIRECTORY}/descriptor-request.json")
file(WRITE "${request}" [=[{"protocol":"symphony.knowledge.engine-process.v2","request_id":"installed-sdk","correlation_id":"installed-sdk","operation":"descriptor","target_engine":"symphony-sbv","deadline_unix_ms":null,"payload":{}}]=])
foreach(language C CXX)
  execute_process(COMMAND "${${language}_CONSUMER}" "${request}"
    RESULT_VARIABLE status OUTPUT_VARIABLE response ERROR_VARIABLE diagnostic
    TIMEOUT 30)
  if(NOT status EQUAL 0 OR NOT diagnostic STREQUAL "")
    message(FATAL_ERROR "Installed ${language} SDK consumer failed: ${status}; ${diagnostic}")
  endif()
  foreach(pair "protocol|symphony.knowledge.engine-process.v2" "engine_id|symphony-sbv" "engine_version|0.33.0-dev" "outcome|ok" "operation|descriptor")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 key)
    list(GET fields 1 expected)
    string(JSON actual GET "${response}" "${key}")
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Installed SDK response ${key} differs")
    endif()
  endforeach()
  string(JSON owner GET "${response}" result engine_id)
  string(JSON version GET "${response}" result engine_version)
  if(NOT owner STREQUAL "symphony-sbv" OR NOT version STREQUAL "0.33.0-dev")
    message(FATAL_ERROR "Installed descriptor identity differs")
  endif()
  set(${language}_response "${response}")
endforeach()
if(NOT C_response STREQUAL CXX_response)
  message(FATAL_ERROR "Installed C and C++ SDK results differ")
endif()
message(STATUS "PASS installed C/C++ SDK ABI, release identity, and exact descriptor correspondence")
