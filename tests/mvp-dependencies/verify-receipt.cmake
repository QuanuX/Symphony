include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
include("${MVP_REPOSITORY}/cmake/SymphonyReceiptV2Support.cmake")
file(READ "${MVP_COMPONENT_FILE}" component)
string(JSON component_id GET "${component}" component_id)
string(JSON version GET "${component}" package_release_version)
set(relative "share/symphony/receipts/${component_id}/${version}/install-receipt.json")
symphony_receipt_v2_no_follow("${MVP_SELECTED_PREFIX}" "${relative}")
symphony_receipt_v2_regular_file("${MVP_SELECTED_PREFIX}/${relative}")
file(READ "${MVP_SELECTED_PREFIX}/${relative}" receipt)
symphony_receipt_v2_strict_json("${receipt}")
foreach(field component_id module_id package_id)
  string(JSON identity GET "${receipt}" "${field}")
  if(NOT identity STREQUAL component_id)
    message(FATAL_ERROR "Installed receipt ${field} differs from mapped component")
  endif()
endforeach()
string(JSON actual_version GET "${receipt}" version)
string(JSON protocol GET "${receipt}" protocol)
string(JSON format GET "${receipt}" format_version)
if(NOT actual_version STREQUAL version OR NOT protocol STREQUAL "symphony.knowledge.install-receipt.v2" OR NOT format EQUAL 2)
  message(FATAL_ERROR "Installed receipt version/protocol differs from map")
endif()
string(JSON expected_digest GET "${receipt}" receipt_digest)
string(JSON unsigned REMOVE "${receipt}" receipt_digest)
symphony_receipt_v2_canonical("${unsigned}" OBJECT 0 canonical)
string(SHA256 digest "${canonical}")
if(NOT expected_digest STREQUAL "sha256:${digest}")
  message(FATAL_ERROR "Installed receipt self-digest mismatch")
endif()
mvp_indices(indices "${receipt}" files)
set(owned "")
foreach(index IN LISTS indices)
  string(JSON path GET "${receipt}" files ${index} path)
  string(JSON expected_size GET "${receipt}" files ${index} size)
  string(JSON expected_hash GET "${receipt}" files ${index} digest)
  symphony_receipt_v2_no_follow("${MVP_SELECTED_PREFIX}" "${path}")
  symphony_receipt_v2_regular_file("${MVP_SELECTED_PREFIX}/${path}")
  file(SIZE "${MVP_SELECTED_PREFIX}/${path}" size)
  file(SHA256 "${MVP_SELECTED_PREFIX}/${path}" hash)
  if(NOT size EQUAL expected_size OR NOT expected_hash STREQUAL "sha256:${hash}" OR path IN_LIST owned)
    message(FATAL_ERROR "Installed receipt-owned file mismatch: ${path}")
  endif()
  list(APPEND owned "${path}")
endforeach()
mvp_indices(indices "${receipt}" entry_points)
foreach(index IN LISTS indices)
  string(JSON path GET "${receipt}" entry_points ${index} path)
  string(JSON kind GET "${receipt}" entry_points ${index} kind)
  if(NOT path IN_LIST owned)
    message(FATAL_ERROR "Entry point is not receipt owned: ${path}")
  endif()
  if(kind STREQUAL "executable" OR kind STREQUAL "adapter")
    execute_process(COMMAND /bin/test -x "${MVP_SELECTED_PREFIX}/${path}" RESULT_VARIABLE executable)
    if(NOT executable EQUAL 0)
      message(FATAL_ERROR "Entry point is not executable: ${path}")
    endif()
  endif()
  message(STATUS "Exact entry point: ${path}")
endforeach()
message(STATUS "PASS ${component_id} ${version}: receipt digest and every owned file verified")
