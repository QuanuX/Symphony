cmake_minimum_required(VERSION 3.30)
include_guard(GLOBAL)
if(NOT DEFINED MVP_REPOSITORY)
  get_filename_component(MVP_REPOSITORY "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
endif()
if(NOT DEFINED MVP_MAP)
  set(MVP_MAP "${MVP_REPOSITORY}/cmake/mvp-dependencies.json")
endif()

function(mvp_indices output json)
  string(JSON count LENGTH "${json}" ${ARGN})
  set(indices "")
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      list(APPEND indices "${index}")
    endforeach()
  endif()
  set(${output} "${indices}" PARENT_SCOPE)
endfunction()

function(mvp_component path output)
  get_property(ready GLOBAL PROPERTY MVP_COMPONENT_TABLE_READY)
  if(NOT ready)
    string(JSON components GET "${MVP_MAP_JSON}" native_components)
    mvp_indices(indices "${components}")
    foreach(index IN LISTS indices)
      string(JSON component GET "${components}" ${index})
      string(JSON candidate GET "${component}" path)
      string(SHA256 key "${candidate}")
      set_property(GLOBAL PROPERTY "MVP_COMPONENT_${key}" "${component}")
    endforeach()
    set_property(GLOBAL PROPERTY MVP_COMPONENT_TABLE_READY TRUE)
  endif()
  string(SHA256 key "${path}")
  get_property(component GLOBAL PROPERTY "MVP_COMPONENT_${key}")
  if(NOT component)
    message(FATAL_ERROR "No mapped native component: ${path}")
  endif()
  set(${output} "${component}" PARENT_SCOPE)
endfunction()

function(mvp_require_under path root)
  if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}")
    message(FATAL_ERROR "Expected existing absolute selected-prefix path: ${path}")
  endif()
  file(REAL_PATH "${path}" canonical)
  file(REAL_PATH "${root}" canonical_root)
  cmake_path(IS_PREFIX canonical_root "${canonical}" NORMALIZE inside)
  if(NOT inside)
    message(FATAL_ERROR "Path escapes selected prefix ${canonical_root}: ${canonical}")
  endif()
endfunction()

function(mvp_run label directory)
  set(log "${MVP_WORK}/logs/${label}.log")
  message(STATUS "${label}: ${log}")
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${directory}"
    RESULT_VARIABLE status OUTPUT_FILE "${log}" ERROR_FILE "${log}")
  if(NOT status EQUAL 0)
    file(READ "${log}" diagnostic)
    message(FATAL_ERROR "${label} failed (${status})\n${diagnostic}")
  endif()
  file(APPEND "${MVP_WORK}/completed-steps.txt" "${label}\n")
endfunction()
