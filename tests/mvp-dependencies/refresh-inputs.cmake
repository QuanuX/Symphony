# Explicit maintenance after reviewing/updating semantic entries in the map.
include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
if(NOT MVP_ACCEPT_SOURCE_CHANGES)
  message(FATAL_ERROR "Review dependency/version changes first; pass -DMVP_ACCEPT_SOURCE_CHANGES=ON to refresh existing source hashes only")
endif()
file(READ "${MVP_MAP}" original)
string(JSON inputs GET "${original}" source_inputs)
mvp_indices(indices "${inputs}")
set(replacement "\"source_inputs\": [")
set(separator "")
foreach(index IN LISTS indices)
  string(JSON path GET "${inputs}" ${index} path)
  if(path MATCHES "[\"\\\\\[\]\r\n]" OR IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)" OR NOT EXISTS "${MVP_REPOSITORY}/${path}")
    message(FATAL_ERROR "Existing source-input path needs explicit map editing: ${path}")
  endif()
  file(SHA256 "${MVP_REPOSITORY}/${path}" digest)
  string(APPEND replacement "${separator}\n    {\n      \"path\": \"${path}\",\n      \"sha256\": \"${digest}\"\n    }")
  set(separator ",")
endforeach()
string(APPEND replacement "\n  ]")
string(REGEX MATCH "\"source_inputs\"[ \t\r\n]*:[ \t\r\n]*\\[[^]]*\\]" prior "${original}")
if(prior STREQUAL "")
  message(FATAL_ERROR "Cannot locate flat source-input array")
endif()
string(REPLACE "${prior}" "${replacement}" updated "${original}")
string(JSON count LENGTH "${updated}" source_inputs)
file(WRITE "${MVP_MAP}" "${updated}")
message(STATUS "Refreshed ${count} existing source hashes only; semantic entries and source membership were not inferred. Review the diff and run verify.cmake.")
