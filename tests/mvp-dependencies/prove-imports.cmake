# Injected before project(); deferred until this complete configure has finished.
include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")

function(mvp_check_directory directory root)
  file(REAL_PATH "${directory}" canonical)
  cmake_path(IS_PREFIX root "${canonical}" NORMALIZE own_directory)
  if(NOT own_directory)
    message(FATAL_ERROR "Source dependency fallback added a directory: ${directory}")
  endif()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    mvp_check_directory("${child}" "${root}")
  endforeach()
endfunction()

function(mvp_check_target_sources directory source_root allowed_sources)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(type "${target}" TYPE)
    if(type STREQUAL "INTERFACE_LIBRARY" OR type STREQUAL "UTILITY")
      continue()
    endif()
    get_target_property(sources "${target}" SOURCES)
    get_target_property(target_root "${target}" SOURCE_DIR)
    if(NOT sources OR sources MATCHES "-NOTFOUND$")
      continue()
    endif()
    foreach(source IN LISTS sources)
      if(source MATCHES "[$]<")
        message(FATAL_ERROR "Unresolved target source cannot prove SDK isolation: ${target} ${source}")
      endif()
      file(REAL_PATH "${source}" canonical BASE_DIRECTORY "${target_root}")
      cmake_path(IS_PREFIX source_root "${canonical}" NORMALIZE admitted)
      if(NOT admitted)
        foreach(allowed IN LISTS allowed_sources)
          file(REAL_PATH "${MVP_REPOSITORY}/${allowed}" selected)
          if(IS_DIRECTORY "${selected}")
            cmake_path(IS_PREFIX selected "${canonical}" NORMALIZE admitted)
          elseif(canonical STREQUAL selected)
            set(admitted TRUE)
          endif()
          if(admitted)
            break()
          endif()
        endforeach()
      endif()
      if(NOT admitted)
        message(FATAL_ERROR "Unmapped source dependency compiled by ${target}: ${canonical}")
      endif()
      file(APPEND "${MVP_PROOF_LOG}" "${target} source ${canonical}\n")
    endforeach()
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    mvp_check_target_sources("${child}" "${source_root}" "${allowed_sources}")
  endforeach()
endfunction()

function(mvp_check_package_for_target target)
  get_property(ready GLOBAL PROPERTY MVP_EXPORT_TABLE_READY)
  if(NOT ready)
    file(READ "${MVP_MAP}" projection)
    string(JSON components GET "${projection}" native_components)
    mvp_indices(components_indices "${components}")
    foreach(component_index IN LISTS components_indices)
      string(JSON producer GET "${components}" ${component_index})
      mvp_indices(exports "${producer}" exported_packages)
      foreach(export_index IN LISTS exports)
        string(JSON package GET "${producer}" exported_packages ${export_index})
        mvp_indices(targets "${package}" targets)
        foreach(target_index IN LISTS targets)
          string(JSON exported_target GET "${package}" targets ${target_index})
          string(SHA256 key "${exported_target}")
          set_property(GLOBAL PROPERTY "MVP_EXPORTED_TARGET_${key}" "${package}")
        endforeach()
      endforeach()
    endforeach()
    set_property(GLOBAL PROPERTY MVP_EXPORT_TABLE_READY TRUE)
  endif()
  string(SHA256 key "${target}")
  get_property(export GLOBAL PROPERTY "MVP_EXPORTED_TARGET_${key}")
  if(NOT export)
    message(FATAL_ERROR "Imported first-party target has no mapped SDK export: ${target}")
  endif()
  string(JSON package GET "${export}" package)
  string(JSON version GET "${export}" version)
  string(JSON release GET "${export}" receipt_release)
  string(JSON version_file GET "${export}" cmake_version_file)
  if(version_file)
    set(expected "${version}")
  else()
    set(expected "${release}")
  endif()
  # Preserve any identity available from the owner's original find_package;
  # the proof must not replace an observable incorrect selection with a valid one.
  # project(Package VERSION ...) also creates Package_VERSION. A helper-local
  # find_package may leave that unrelated project value visible here after its
  # own result variables go out of scope.
  if(${package}_FOUND AND DEFINED ${package}_CONFIG AND
     DEFINED ${package}_VERSION AND
     NOT "${${package}_VERSION}" STREQUAL expected)
    message(FATAL_ERROR "Originally selected SDK version differs from map: ${package} ${${package}_VERSION} != ${expected}")
  endif()
  if(DEFINED ${package}_DIR)
    mvp_require_under("${${package}_DIR}" "${MVP_SELECTED_PREFIX}")
    if(NOT version_file)
      file(REAL_PATH "${${package}_DIR}" selected_config)
      file(REAL_PATH "${MVP_SELECTED_PREFIX}/lib/cmake/${package}/${release}" expected_config)
      if(NOT selected_config STREQUAL expected_config)
        message(FATAL_ERROR "Originally selected SDK config differs from exact release directory: ${package}")
      endif()
    endif()
  endif()
  # Some owner helpers call find_package inside functions, so their version
  # variables need not survive to this deferred directory-scope proof.
  if(version_file)
    set(config_search "${MVP_SELECTED_PREFIX}")
    if(DEFINED ${package}_DIR)
      # Re-evaluate the originally selected config; do not replace an old
      # helper-local selection with another version elsewhere in the prefix.
      set(config_search "${${package}_DIR}")
    endif()
    find_package(${package} ${version} EXACT REQUIRED CONFIG
      PATHS "${config_search}" NO_DEFAULT_PATH)
  else()
    # SBV's manually authored contracts expose release variables and exact
    # versioned config directories without ConfigVersion files.
    set(${package}_DIR "${MVP_SELECTED_PREFIX}/lib/cmake/${package}/${release}")
    find_package(${package} REQUIRED CONFIG
      PATHS "${${package}_DIR}" NO_DEFAULT_PATH)
  endif()
  mvp_require_under("${${package}_DIR}" "${MVP_SELECTED_PREFIX}")
  if(NOT "${${package}_VERSION}" STREQUAL expected)
    message(FATAL_ERROR "Evaluated SDK version differs from map: ${package} ${${package}_VERSION} != ${expected}")
  endif()
  if(DEFINED ${package}_RELEASE_VERSION AND
     NOT "${${package}_RELEASE_VERSION}" STREQUAL release)
    message(FATAL_ERROR "Evaluated SDK release differs from map: ${package}")
  endif()
  file(APPEND "${MVP_PROOF_LOG}" "${package} version ${${package}_VERSION} config ${${package}_DIR}\n")
endfunction()

function(mvp_require_under_any path roots)
  if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}")
    message(FATAL_ERROR "Expected existing absolute imported path: ${path}")
  endif()
  file(REAL_PATH "${path}" canonical)
  foreach(root IN LISTS roots)
    if(NOT IS_ABSOLUTE "${root}" OR NOT IS_DIRECTORY "${root}")
      continue()
    endif()
    file(REAL_PATH "${root}" canonical_root)
    cmake_path(IS_PREFIX canonical_root "${canonical}" NORMALIZE inside)
    if(inside)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Imported path escapes selected prefixes ${roots}: ${canonical}")
endfunction()

function(mvp_check_imported_target target prefixes)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "Missing required installed SDK target ${target}")
  endif()
  get_target_property(imported "${target}" IMPORTED)
  if(NOT imported)
    message(FATAL_ERROR "SDK target is not imported: ${target}")
  endif()
  get_target_property(includes "${target}" INTERFACE_INCLUDE_DIRECTORIES)
  if(includes AND NOT includes MATCHES "-NOTFOUND$")
    foreach(path IN LISTS includes)
      mvp_require_under_any("${path}" "${prefixes}")
      file(APPEND "${MVP_PROOF_LOG}" "${target} include ${path}\n")
    endforeach()
  endif()
  get_target_property(configurations "${target}" IMPORTED_CONFIGURATIONS)
  set(properties IMPORTED_LOCATION IMPORTED_IMPLIB)
  foreach(configuration IN LISTS configurations)
    string(TOUPPER "${configuration}" configuration)
    list(APPEND properties "IMPORTED_LOCATION_${configuration}" "IMPORTED_IMPLIB_${configuration}")
  endforeach()
  set(has_location FALSE)
  foreach(property IN LISTS properties)
    get_target_property(location "${target}" "${property}")
    if(location AND NOT location MATCHES "-NOTFOUND$")
      mvp_require_under_any("${location}" "${prefixes}")
      file(APPEND "${MVP_PROOF_LOG}" "${target} ${property} ${location}\n")
      set(has_location TRUE)
    endif()
  endforeach()
  get_target_property(type "${target}" TYPE)
  if(NOT type STREQUAL "INTERFACE_LIBRARY" AND NOT has_location)
    message(FATAL_ERROR "Imported SDK has no installed library location: ${target}")
  endif()
endfunction()

function(mvp_check_complete_configuration)
  file(READ "${MVP_COMPONENT_FILE}" component)
  if(CMAKE_CONFIGURATION_TYPES OR NOT CMAKE_BUILD_TYPE STREQUAL "Release" OR
     NOT CMAKE_POSITION_INDEPENDENT_CODE)
    message(FATAL_ERROR "Qualification requires single-config Release and PIC")
  endif()
  file(REAL_PATH "${CMAKE_SOURCE_DIR}" source_root)
  mvp_check_directory("${CMAKE_SOURCE_DIR}" "${source_root}")
  string(JSON version TYPE "${component}" project_version)
  if(NOT version STREQUAL "NULL")
    string(JSON expected GET "${component}" project_version)
    if(NOT PROJECT_VERSION STREQUAL expected)
      message(FATAL_ERROR "Project version differs from map: ${PROJECT_VERSION} != ${expected}")
    endif()
  endif()
  file(WRITE "${MVP_PROOF_LOG}" "source=${source_root}\nprefix=${MVP_SELECTED_PREFIX}\nproject_version=${PROJECT_VERSION}\n")
  set(allowed_sources "")
  set(allowance_fields allowed_shared_implementation_sources)
  if(BUILD_TESTING)
    list(APPEND allowance_fields allowed_test_implementation_sources)
  endif()
  foreach(field IN LISTS allowance_fields)
    string(JSON allowed_type ERROR_VARIABLE absent TYPE "${component}" ${field})
    if(absent)
      continue()
    endif()
    mvp_indices(indices "${component}" ${field})
    foreach(index IN LISTS indices)
      string(JSON path GET "${component}" ${field} ${index})
      if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)" OR
         NOT EXISTS "${MVP_REPOSITORY}/${path}")
        message(FATAL_ERROR "Invalid shared implementation source allowance: ${path}")
      endif()
      list(APPEND allowed_sources "${path}")
    endforeach()
  endforeach()
  mvp_check_target_sources("${CMAKE_SOURCE_DIR}" "${source_root}" "${allowed_sources}")
  mvp_indices(indices "${component}" artifact_targets)
  foreach(index IN LISTS indices)
    string(JSON target GET "${component}" artifact_targets ${index})
    if(NOT TARGET "${target}")
      message(FATAL_ERROR "Expected artifact target absent: ${target}")
    endif()
    file(APPEND "${MVP_PROOF_LOG}" "artifact_target=${target}\n")
  endforeach()
  mvp_indices(indices "${component}" first_party_sdk_dependencies)
  set(required_targets "")
  foreach(index IN LISTS indices)
    string(JSON scope GET "${component}" first_party_sdk_dependencies ${index} scope)
    if(scope STREQUAL "runtime")
      string(JSON target GET "${component}" first_party_sdk_dependencies ${index} target)
      list(APPEND required_targets "${target}")
    endif()
  endforeach()
  # Include transitive exported first-party targets, not only direct requests.
  get_property(imported_targets DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY IMPORTED_TARGETS)
  foreach(target IN LISTS imported_targets)
    if(target MATCHES "^Symphony::")
      list(APPEND required_targets "${target}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES required_targets)
  foreach(target IN LISTS required_targets)
    mvp_check_package_for_target("${target}")
    mvp_check_imported_target("${target}" "${MVP_SELECTED_PREFIX}")
  endforeach()
  if(DEFINED MVP_EXTERNAL_PREFIX AND NOT MVP_EXTERNAL_PREFIX STREQUAL "")
    # Environment CMAKE_PREFIX_PATH uses ':' on the supported Unix hosts.
    string(REPLACE ":" ";" external_prefixes "${MVP_EXTERNAL_PREFIX}")
    foreach(target CURL::libcurl zstd::libzstd_static)
      if(TARGET "${target}")
        mvp_check_imported_target("${target}" "${external_prefixes}")
        get_target_property(type "${target}" TYPE)
        if(type STREQUAL "INTERFACE_LIBRARY")
          message(FATAL_ERROR "External dependency has no directly provable installed library: ${target}")
        endif()
      endif()
    endforeach()
  endif()
  file(APPEND "${MVP_PROOF_LOG}" "PASS exact imported SDK closure and mapped implementation sources; no source dependency fallback\n")
endfunction()
cmake_language(DEFER CALL mvp_check_complete_configuration)
