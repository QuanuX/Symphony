cmake_minimum_required(VERSION 3.30)
if(NOT MVP_EXTERNAL_PREFIX)
  message(FATAL_ERROR "Loader qualification requires the selected private external prefix")
endif()
string(REPLACE ":" ";" roots "${MVP_EXTERNAL_PREFIX}")
file(STRINGS "${MVP_LOADER_LOG}" lines)
set(loaded_curl FALSE)
foreach(line IN LISTS lines)
  set(path "")
  if(MVP_LOADER_SYSTEM STREQUAL "Darwin")
    if(line MATCHES "^dyld\\[[0-9]+\\]:[ \t]+(<[^>]+>[ \t]+)?(/.*[/]libcurl[^/]*\\.dylib)$")
      set(path "${CMAKE_MATCH_2}")
    elseif(line MATCHES "^dyld: loaded:[ \t]+(/.*[/]libcurl[^/]*\\.dylib)$")
      set(path "${CMAKE_MATCH_1}")
    endif()
  elseif(MVP_LOADER_SYSTEM STREQUAL "Linux")
    if(line MATCHES "^[ \t]*libcurl\\.so[^ \t]*[ \t]+=>[ \t]+(/.*)[ \t]+\\(0x[0-9a-fA-F]+\\)$")
      string(STRIP "${CMAKE_MATCH_1}" path)
    endif()
  else()
    message(FATAL_ERROR "Unsupported loader trace system: ${MVP_LOADER_SYSTEM}")
  endif()
  if(path STREQUAL "")
    continue()
  endif()
  if(MVP_LOADER_SYSTEM STREQUAL "Darwin" AND path STREQUAL "/usr/lib/libcurl.4.dylib")
    # Apple's framework dependencies can also load their system curl from the
    # dyld shared cache. That additional load is not private-dependency proof.
    message(STATUS "Additional Apple framework curl load: ${path}")
    continue()
  endif()
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Loader reported an absent curl library: ${path}")
  endif()
  file(REAL_PATH "${path}" canonical)
  set(admitted FALSE)
  foreach(root IN LISTS roots)
    if(NOT IS_ABSOLUTE "${root}" OR NOT IS_DIRECTORY "${root}")
      continue()
    endif()
    file(REAL_PATH "${root}" selected)
    cmake_path(IS_PREFIX selected "${canonical}" NORMALIZE inside)
    if(inside)
      set(admitted TRUE)
      break()
    endif()
  endforeach()
  if(NOT admitted)
    message(FATAL_ERROR "SDK consumer loaded ambient curl outside the selected external prefix: ${canonical}")
  endif()
  set(loaded_curl TRUE)
  message(STATUS "Selected curl loaded: ${canonical}")
endforeach()
if(NOT loaded_curl)
  message(FATAL_ERROR "No actual selected curl load was observed; search attempts are not loader evidence")
endif()
message(STATUS "PASS SDK consumer loads curl from the selected private external prefix")
