include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
file(READ "${MVP_MAP}" projection)
string(JSON modules GET "${projection}" go_modules)
mvp_indices(indices "${modules}")
foreach(index IN LISTS indices)
  string(JSON module GET "${modules}" ${index})
  string(JSON path GET "${module}" path)
  string(REPLACE "/" "-" label "${path}")
  file(SHA256 "${MVP_REPOSITORY}/${path}/go.mod" before_mod)
  if(EXISTS "${MVP_REPOSITORY}/${path}/go.sum")
    file(SHA256 "${MVP_REPOSITORY}/${path}/go.sum" before_sum)
  else()
    set(before_sum absent)
  endif()
  execute_process(COMMAND go list -m -mod=readonly -f "{{.Path}}@{{.Version}}{{if .Replace}}=REPLACED{{end}}" all
    WORKING_DIRECTORY "${MVP_REPOSITORY}/${path}" RESULT_VARIABLE status OUTPUT_VARIABLE actual
    ERROR_FILE "${MVP_WORK}/logs/${label}.stderr.log")
  file(WRITE "${MVP_WORK}/logs/${label}.txt" "${actual}")
  if(NOT status EQUAL 0 OR actual MATCHES "=REPLACED")
    message(FATAL_ERROR "Standalone Go graph failed or selected a replacement: ${path}; see ${MVP_WORK}/logs/${label}.stderr.log")
  endif()
  string(STRIP "${actual}" actual)
  string(REPLACE "\n" ";" actual "${actual}")
  set(expected "")
  mvp_indices(nodes "${module}" resolved_graph)
  foreach(node IN LISTS nodes)
    string(JSON name GET "${module}" resolved_graph ${node} Path)
    string(JSON version ERROR_VARIABLE absent GET "${module}" resolved_graph ${node} Version)
    if(absent)
      set(version "")
    endif()
    list(APPEND expected "${name}@${version}")
  endforeach()
  list(SORT actual)
  list(SORT expected)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Resolved Go graph differs from map: ${path}\nExpected: ${expected}\nActual: ${actual}")
  endif()
  set(binary_directory "${MVP_WORK}/binaries/${label}")
  file(MAKE_DIRECTORY "${binary_directory}")
  execute_process(COMMAND go list -mod=readonly -f "{{if eq .Name \"main\"}}{{.ImportPath}}{{end}}" ./...
    WORKING_DIRECTORY "${MVP_REPOSITORY}/${path}" RESULT_VARIABLE status OUTPUT_VARIABLE main_packages
    ERROR_FILE "${MVP_WORK}/logs/${label}-packages.stderr.log")
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Standalone package discovery failed: ${path}")
  endif()
  string(STRIP "${main_packages}" main_packages)
  file(WRITE "${MVP_WORK}/logs/${label}-main-packages.txt" "${main_packages}\n")
  if(main_packages)
    mvp_run("${label}-build" "${MVP_REPOSITORY}/${path}"
      go build -mod=readonly -trimpath -o "${binary_directory}/" ./...)
  else()
    # Go rejects -o <directory> when no main package exists. Library archives
    # remain in the private GOCACHE; this form writes no checkout artifacts.
    mvp_run("${label}-build" "${MVP_REPOSITORY}/${path}"
      go build -mod=readonly -trimpath ./...)
  endif()
  mvp_indices(commands "${module}" executable_packages)
  foreach(command IN LISTS commands)
    string(JSON binary_name GET "${module}" executable_packages ${command} binary_name)
    if(NOT EXISTS "${binary_directory}/${binary_name}")
      message(FATAL_ERROR "Declared standalone command was not built: ${path}/${binary_name}")
    endif()
  endforeach()
  file(SHA256 "${MVP_REPOSITORY}/${path}/go.mod" after_mod)
  if(EXISTS "${MVP_REPOSITORY}/${path}/go.sum")
    file(SHA256 "${MVP_REPOSITORY}/${path}/go.sum" after_sum)
  else()
    set(after_sum absent)
  endif()
  if(NOT before_mod STREQUAL after_mod OR NOT before_sum STREQUAL after_sum)
    message(FATAL_ERROR "Read-only graph resolution or standalone build modified a module manifest: ${path}")
  endif()
  list(LENGTH expected count)
  message(STATUS "PASS ${path}: ${count} exact selected graph nodes, standalone build, no replacement or manifest mutation")
endforeach()
