include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
file(READ "${MVP_MAP}" MVP_MAP_JSON)
string(JSON format GET "${MVP_MAP_JSON}" format_version)
if(NOT format EQUAL 1)
  message(FATAL_ERROR "Unsupported dependency projection format")
endif()

set(actual_roots "")
set(actual_native_paths "")
set(actual_go_paths "")
foreach(category modules libraries tools)
  file(GLOB children RELATIVE "${MVP_REPOSITORY}" "${MVP_REPOSITORY}/${category}/*")
  foreach(path IN LISTS children)
    if(IS_DIRECTORY "${MVP_REPOSITORY}/${path}")
      list(APPEND actual_roots "${path}")
      if(EXISTS "${MVP_REPOSITORY}/${path}/CMakeLists.txt")
        list(APPEND actual_native_paths "${path}")
      endif()
      if(EXISTS "${MVP_REPOSITORY}/${path}/go.mod")
        list(APPEND actual_go_paths "${path}")
      endif()
    endif()
  endforeach()
endforeach()
set(mapped_roots "")
string(JSON roots GET "${MVP_MAP_JSON}" component_roots)
mvp_indices(indices "${roots}")
foreach(index IN LISTS indices)
  string(JSON path GET "${roots}" ${index} path)
  if(path IN_LIST mapped_roots)
    message(FATAL_ERROR "Duplicate mapped component root: ${path}")
  endif()
  list(APPEND mapped_roots "${path}")
endforeach()
list(SORT actual_roots)
list(SORT mapped_roots)
if(NOT actual_roots STREQUAL mapped_roots)
  message(FATAL_ERROR "Component-root coverage differs; update the semantic map explicitly\nActual: ${actual_roots}\nMapped: ${mapped_roots}")
endif()

string(JSON inputs GET "${MVP_MAP_JSON}" source_inputs)
mvp_indices(indices "${inputs}")
foreach(index IN LISTS indices)
  string(JSON path GET "${inputs}" ${index} path)
  string(JSON expected GET "${inputs}" ${index} sha256)
  if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)" OR
     NOT EXISTS "${MVP_REPOSITORY}/${path}")
    message(FATAL_ERROR "Invalid/missing mapped source input: ${path}")
  endif()
  file(SHA256 "${MVP_REPOSITORY}/${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Source input changed: ${path}. Review semantic version/dependency edits before running refresh-inputs.cmake.")
  endif()
endforeach()
list(LENGTH indices input_count)

string(JSON natives GET "${MVP_MAP_JSON}" native_components)
mvp_indices(indices "${natives}")
set(native_paths "")
foreach(index IN LISTS indices)
  string(JSON component GET "${natives}" ${index})
  string(JSON path GET "${component}" path)
  if(NOT path IN_LIST mapped_roots OR path IN_LIST native_paths)
    message(FATAL_ERROR "Invalid native component coverage: ${path}")
  endif()
  list(APPEND native_paths "${path}")
  file(READ "${MVP_REPOSITORY}/${path}/CMakeLists.txt" source)
  string(JSON type TYPE "${component}" project_version)
  if(NOT type STREQUAL "NULL")
    string(JSON version GET "${component}" project_version)
    string(REGEX MATCH "project\\([^)]*VERSION[ \t\r\n]+([0-9]+\\.[0-9]+\\.[0-9]+)" declaration "${source}")
    if(declaration AND NOT CMAKE_MATCH_1 STREQUAL version)
      message(FATAL_ERROR "CMake project version disagrees with map: ${path}")
    elseif(NOT declaration)
      # Generated owner-version variables are bound by the source hashes and
      # checked after actual project() evaluation by prove-imports.cmake.
      string(REGEX MATCH "project\\([^)]*VERSION[ \t\r\n]+[$][{][A-Za-z0-9_]+[}]" generated "${source}")
      if(NOT generated)
        message(FATAL_ERROR "No literal/generated project version declaration: ${path}")
      endif()
    endif()
  endif()
endforeach()
set(sorted_native_paths "${native_paths}")
list(SORT sorted_native_paths)
list(SORT actual_native_paths)
if(NOT sorted_native_paths STREQUAL actual_native_paths)
  message(FATAL_ERROR "Native CMake-root coverage differs from the dependency map")
endif()

# SDK package versions are distinct from receipt release identities. Every
# mapped dependency must name an exact export of the selected producer.
set(exported_package_names "")
foreach(path IN LISTS native_paths)
  mvp_component("${path}" component)
  string(JSON project_version GET "${component}" project_version)
  string(JSON release GET "${component}" package_release_version)
  mvp_indices(exports "${component}" exported_packages)
  foreach(index IN LISTS exports)
    string(JSON package GET "${component}" exported_packages ${index} package)
    string(JSON version GET "${component}" exported_packages ${index} version)
    string(JSON package_release GET "${component}" exported_packages ${index} receipt_release)
    if(package IN_LIST exported_package_names OR NOT version STREQUAL project_version OR
       NOT package_release STREQUAL release)
      message(FATAL_ERROR "SDK export version/identity differs from producer ${path}: ${package}")
    endif()
    list(APPEND exported_package_names "${package}")
  endforeach()
  mvp_indices(dependencies "${component}" first_party_sdk_dependencies)
  foreach(index IN LISTS dependencies)
    string(JSON dependency GET "${component}" first_party_sdk_dependencies ${index})
    string(JSON producer_path GET "${dependency}" path)
    string(JSON package GET "${dependency}" package)
    string(JSON version GET "${dependency}" version)
    string(JSON target GET "${dependency}" target)
    string(JSON exact GET "${dependency}" exact)
    string(JSON scope GET "${dependency}" scope)
    if(NOT exact OR NOT scope MATCHES "^(runtime|test)$")
      message(FATAL_ERROR "SDK dependency lacks an exact version or valid scope: ${path} ${package}")
    endif()
    mvp_component("${producer_path}" producer)
    mvp_indices(producer_exports "${producer}" exported_packages)
    set(matched FALSE)
    foreach(export IN LISTS producer_exports)
      string(JSON producer_package GET "${producer}" exported_packages ${export} package)
      string(JSON producer_version GET "${producer}" exported_packages ${export} version)
      if(producer_package STREQUAL package AND producer_version STREQUAL version)
        mvp_indices(targets "${producer}" exported_packages ${export} targets)
        foreach(target_index IN LISTS targets)
          string(JSON exported_target GET "${producer}" exported_packages ${export} targets ${target_index})
          if(exported_target STREQUAL target)
            set(matched TRUE)
          endif()
        endforeach()
      endif()
    endforeach()
    if(NOT matched)
      message(FATAL_ERROR "SDK dependency version/target differs from producer export: ${path} ${package} ${version}")
    endif()
  endforeach()
endforeach()
set(ordered "")
mvp_indices(indices "${MVP_MAP_JSON}" native_build_order)
foreach(index IN LISTS indices)
  string(JSON path GET "${MVP_MAP_JSON}" native_build_order ${index})
  if(NOT path IN_LIST native_paths OR path IN_LIST ordered)
    message(FATAL_ERROR "Unknown/duplicate native build-order entry: ${path}")
  endif()
  mvp_component("${path}" component)
  mvp_indices(dependencies "${component}" first_party_sdk_dependencies)
  foreach(dependency IN LISTS dependencies)
    string(JSON scope GET "${component}" first_party_sdk_dependencies ${dependency} scope)
    string(JSON dependency_path GET "${component}" first_party_sdk_dependencies ${dependency} path)
    if(scope STREQUAL "runtime" AND NOT dependency_path IN_LIST ordered)
      message(FATAL_ERROR "Runtime SDK ${dependency_path} must precede ${path}")
    endif()
  endforeach()
  list(APPEND ordered "${path}")
endforeach()
list(LENGTH ordered ordered_count)
list(LENGTH native_paths native_count)
if(NOT ordered_count EQUAL native_count)
  message(FATAL_ERROR "Native build order omits components")
endif()

string(JSON modules GET "${MVP_MAP_JSON}" go_modules)
mvp_indices(indices "${modules}")
set(mapped_go_paths "")
foreach(index IN LISTS indices)
  string(JSON path GET "${modules}" ${index} path)
  string(JSON module GET "${modules}" ${index} module)
  string(JSON version GET "${modules}" ${index} go)
  file(READ "${MVP_REPOSITORY}/${path}/go.mod" source)
  string(REGEX MATCH "(^|\n)[ \t]*module[ \t]+([^ \t\r\n]+)" declaration "${source}")
  set(actual_module "${CMAKE_MATCH_2}")
  string(REGEX MATCH "(^|\n)[ \t]*go[ \t]+([^ \t\r\n]+)" declaration "${source}")
  set(actual_go_version "${CMAKE_MATCH_2}")
  if(NOT actual_module STREQUAL module OR NOT actual_go_version STREQUAL version OR
     NOT path IN_LIST mapped_roots OR path IN_LIST mapped_go_paths)
    message(FATAL_ERROR "Go module/toolchain identity differs: ${path}")
  endif()
  list(APPEND mapped_go_paths "${path}")
endforeach()
list(SORT mapped_go_paths)
list(SORT actual_go_paths)
if(NOT mapped_go_paths STREQUAL actual_go_paths)
  message(FATAL_ERROR "Go module-root coverage differs from the dependency map")
endif()

string(JSON interfaces GET "${MVP_MAP_JSON}" owner_interfaces)
mvp_indices(indices "${interfaces}")
foreach(index IN LISTS indices)
  string(JSON path GET "${interfaces}" ${index} path)
  string(JSON expected GET "${interfaces}" ${index} current_package_version)
  file(READ "${MVP_REPOSITORY}/${path}" source)
  string(JSON current ERROR_VARIABLE absent GET "${source}" current_version)
  if(absent)
    string(JSON current GET "${source}" current_release)
  endif()
  if(NOT current STREQUAL expected)
    message(FATAL_ERROR "Owner-interface package identity differs: ${path}")
  endif()
endforeach()
string(JSON projections GET "${MVP_MAP_JSON}" generated_go_owner_interface_versions)
mvp_indices(indices "${projections}")
foreach(index IN LISTS indices)
  string(JSON evidence GET "${projections}" ${index} evidence)
  string(REGEX REPLACE ":[0-9]+$" "" path "${evidence}")
  string(JSON symbol GET "${projections}" ${index} symbol)
  string(JSON version GET "${projections}" ${index} version)
  file(READ "${MVP_REPOSITORY}/${path}" source)
  string(FIND "${source}" "const ${symbol} = \"${version}\"" found)
  if(found LESS 0)
    message(FATAL_ERROR "Generated Go interface version differs: ${path}")
  endif()
endforeach()

string(JSON schemas GET "${MVP_MAP_JSON}" schema_catalog records)
mvp_indices(indices "${schemas}")
foreach(index IN LISTS indices)
  string(JSON path GET "${schemas}" ${index} path)
  file(READ "${MVP_REPOSITORY}/${path}" source)
  string(JSON ids GET "${schemas}" ${index} schema_ids)
  mvp_indices(id_indices "${ids}")
  foreach(id_index IN LISTS id_indices)
    string(JSON pointer GET "${ids}" ${id_index} json_pointer)
    string(JSON expected GET "${ids}" ${id_index} id)
    string(REGEX REPLACE "^/" "" pointer "${pointer}")
    string(REPLACE "/" ";" keys "${pointer}")
    set(decoded "")
    foreach(key IN LISTS keys)
      string(REPLACE "~1" "/" key "${key}")
      string(REPLACE "~0" "~" key "${key}")
      list(APPEND decoded "${key}")
    endforeach()
    string(JSON actual GET "${source}" ${decoded})
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Schema identity differs: ${path} ${pointer}")
    endif()
  endforeach()
endforeach()
string(JSON swift GET "${MVP_MAP_JSON}" swift_provider)
string(JSON manifest GET "${swift}" package_manifest)
string(JSON swift_version GET "${swift}" swift_tools_version)
file(READ "${MVP_REPOSITORY}/${manifest}" source)
string(FIND "${source}" "swift-tools-version: ${swift_version}" toolchain)
string(FIND "${source}" "platforms: [.macOS(.v13)]" platform)
if(toolchain LESS 0 OR platform LESS 0)
  message(FATAL_ERROR "Swift toolchain/platform differs from map")
endif()
list(LENGTH mapped_roots root_count)
message(STATUS "PASS dependency source projection: ${root_count} roots, ${native_count} native components, ${input_count} source hashes; Go/Swift/interface/schema identities checked")
