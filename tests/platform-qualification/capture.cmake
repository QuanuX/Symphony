cmake_minimum_required(VERSION 3.25)
function(json_string input output)
  string(REPLACE "\\" "\\\\" value "${input}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()
file(READ "${PLATFORM_REPOSITORY}/cmake/mvp-platform-profiles.json" catalog)
string(JSON count LENGTH "${catalog}" profiles)
math(EXPR last "${count} - 1")
set(profile "")
foreach(index RANGE 0 ${last})
  string(JSON id GET "${catalog}" profiles ${index} profile_id)
  if(id STREQUAL PLATFORM_PROFILE)
    string(JSON profile GET "${catalog}" profiles ${index})
  endif()
endforeach()
if(NOT profile)
  message(FATAL_ERROR "Unknown declared platform profile: ${PLATFORM_PROFILE}")
endif()
foreach(field os architecture release commit tree)
  file(READ "${PLATFORM_WORK}/raw/${field}.txt" ${field})
  string(STRIP "${${field}}" ${field})
endforeach()
if(os STREQUAL "Darwin")
  set(os macos)
elseif(os STREQUAL "Linux")
  set(os linux)
endif()
if(architecture MATCHES "^(x86_64|amd64)$")
  set(architecture amd64)
elseif(architecture MATCHES "^(arm64|aarch64)$")
  set(architecture arm64)
endif()
foreach(field os architecture)
  string(JSON expected GET "${profile}" "${field}")
  if(NOT "${${field}}" STREQUAL expected)
    message(FATAL_ERROR "Observed ${field} differs from declared profile")
  endif()
endforeach()
string(JSON expected_release GET "${profile}" os_release)
if(os STREQUAL "linux")
  file(READ "${PLATFORM_WORK}/raw/distribution.txt" distribution)
  string(STRIP "${distribution}" distribution)
  if(NOT distribution STREQUAL "ubuntu" OR NOT release STREQUAL expected_release)
    message(FATAL_ERROR "Observed distribution release differs from profile")
  endif()
else()
  string(REGEX MATCH "^[0-9]+" major "${release}")
  if(NOT major STREQUAL expected_release)
    message(FATAL_ERROR "Observed macOS release differs from profile")
  endif()
endif()
if(PLATFORM_PROFILE STREQUAL "dgx-spark-dgxos7-arm64")
  file(READ "${PLATFORM_WORK}/raw/dgx-release.txt" dgx)
  file(READ "${PLATFORM_WORK}/raw/gpu.txt" gpu)
  file(READ "${PLATFORM_WORK}/raw/virtualization.txt" virtual)
  if(NOT dgx MATCHES "7\\.[0-9]+" OR NOT gpu MATCHES "(GB10|DGX Spark)" OR NOT virtual MATCHES "^none")
    message(FATAL_ERROR "Spark observation requires DGX OS7 metadata, GB10 GPU and no detected virtualization")
  endif()
endif()
file(SHA256 "${PLATFORM_REPOSITORY}/cmake/mvp-platform-profiles.json" catalog_hash)
set(result "{\"protocol\":\"symphony.platform-observation.v1\",\"status\":\"observed\",\"qualification_status\":\"evidence_only\",\"hardware_attestation\":false,\"gpu_workload_tested\":false,\"power_loss_tested\":false}")
foreach(pair "profile_id|${PLATFORM_PROFILE}" "os|${os}" "architecture|${architecture}" "source_commit|${commit}" "source_tree|${tree}" "profile_catalog_sha256|${catalog_hash}")
  string(REPLACE "|" ";" parts "${pair}")
  list(GET parts 0 key)
  list(GET parts 1 value)
  json_string("${value}" quoted)
  string(JSON result SET "${result}" "${key}" "${quoted}")
endforeach()
set(observations "{}")
file(GLOB raw_files "${PLATFORM_WORK}/raw/*.txt")
foreach(path IN LISTS raw_files)
  get_filename_component(name "${path}" NAME_WE)
  file(READ "${path}" value)
  file(SHA256 "${path}" hash)
  json_string("${value}" quoted)
  string(JSON observation SET "{}" value "${quoted}")
  string(JSON observation SET "${observation}" sha256 "\"${hash}\"")
  string(JSON observations SET "${observations}" "${name}" "${observation}")
endforeach()
string(JSON result SET "${result}" observations "${observations}")
string(TIMESTAMP observed_at "%Y-%m-%dT%H:%M:%SZ" UTC)
string(JSON result SET "${result}" observed_at_utc "\"${observed_at}\"")
file(WRITE "${PLATFORM_WORK}/platform-evidence.json" "${result}\n")
message(STATUS "Captured ${PLATFORM_PROFILE}; evidence only, no qualification assertion")
