foreach(domain shv scv)
  file(READ "${ADMISSION_WORK}/${domain}.json" result)
  string(JSON protocol GET "${result}" protocol)
  if(domain STREQUAL "shv")
    string(JSON outcome GET "${result}" outcome)
    string(JSON version GET "${result}" result engine_version)
    if(NOT outcome STREQUAL "ok" OR NOT version STREQUAL "0.4.0-dev")
      message(FATAL_ERROR "SHV CLI did not execute the exact installed owner")
    endif()
  else()
    string(JSON operation GET "${result}" operation)
    string(JSON version GET "${result}" connector_result engine_version)
    if(NOT protocol STREQUAL "symphony.qxctl.scv-graph-index-result.v1" OR
       NOT operation STREQUAL "inspect" OR NOT version STREQUAL "0.2.0-dev")
      message(FATAL_ERROR "SCV CLI did not execute the exact installed owner")
    endif()
  endif()
endforeach()
file(SHA256 "${ADMISSION_WORK}/qxctl" cli_hash)
file(WRITE "${ADMISSION_WORK}/evidence.txt" "PASS two actual qxctl installed connector inspections\nqxctl_sha256=${cli_hash}\nprefix=${ADMISSION_PREFIX}\n")
message(STATUS "PASS both installed DuckDB owners through qxctl receipt admission")
