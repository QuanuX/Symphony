cmake_minimum_required(VERSION 3.30)
set(caller_data "${DUCKDB_WORK}/caller-data")
file(MAKE_DIRECTORY "${caller_data}")
file(WRITE "${caller_data}/retained" "caller-owned data survives package removal\n")
file(SHA256 "${caller_data}/retained" caller_hash)
foreach(domain scv shv)
  if(domain STREQUAL "scv")
    set(version 0.2.0-dev)
  else()
    set(version 0.4.0-dev)
  endif()
  set(id "${domain}-graph-duckdb-connector")
  set(runtime "${DUCKDB_PREFIX}/libexec/symphony/${id}/${version}")
  set(executable "${runtime}/symphony-${id}")
  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    set(library "${runtime}/libduckdb.dylib")
    set(environment DYLD_PRINT_LIBRARIES=1)
  else()
    set(library "${runtime}/libduckdb.so")
    set(environment LD_TRACE_LOADED_OBJECTS=1)
  endif()
  set(request "${DUCKDB_WORK}/${domain}-inspect.json")
  string(TIMESTAMP seconds "%s" UTC)
  math(EXPR deadline "${seconds} * 1000 + 30000")
  file(WRITE "${request}" "{\"protocol\":\"symphony.knowledge.engine-process.v1\",\"request_id\":\"loader\",\"correlation_id\":\"loader\",\"target_engine\":\"symphony-${id}\",\"operation\":\"inspect\",\"deadline_unix_ms\":${deadline},\"payload\":{}}")
  set(clean_loader "${CMAKE_COMMAND}" -E env --unset=LD_LIBRARY_PATH --unset=LD_PRELOAD
    --unset=DYLD_LIBRARY_PATH --unset=DYLD_FALLBACK_LIBRARY_PATH --unset=DYLD_INSERT_LIBRARIES)
  execute_process(COMMAND ${clean_loader} "${environment}" "${executable}"
    INPUT_FILE "${request}" OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE status)
  file(WRITE "${DUCKDB_WORK}/logs/${domain}-installed-loader.log" "${output}\n${error}")
  string(FIND "${output}\n${error}" "${library}" found)
  if(NOT status EQUAL 0 OR found LESS 0)
    message(FATAL_ERROR "Installed loader did not select the receipt-owned DuckDB library")
  endif()
  # A clean qualification environment must fail when the adjacent library is
  # absent. OS loader overrides and arbitrary ambient installations are not
  # constrained by this test or by an RPATH declaration.
  file(RENAME "${library}" "${library}.held")
  execute_process(COMMAND ${clean_loader} "${executable}" INPUT_FILE "${request}" OUTPUT_VARIABLE missing_output
    ERROR_VARIABLE missing_error RESULT_VARIABLE missing_status)
  file(RENAME "${library}.held" "${library}")
  file(WRITE "${DUCKDB_WORK}/logs/${domain}-missing-library.log" "${missing_output}\n${missing_error}")
  if(missing_status EQUAL 0)
    message(FATAL_ERROR "Missing adjacent DuckDB did not fail in the clean qualification environment")
  endif()
  set(receipt "${DUCKDB_PREFIX}/share/symphony/receipts/${id}/${version}/install-receipt.json")
  file(READ "${receipt}" receipt_json)
  file(MAKE_DIRECTORY "${DUCKDB_WORK}/evidence/receipts")
  file(COPY_FILE "${receipt}" "${DUCKDB_WORK}/evidence/receipts/${id}-${version}.json")
  set(database_root "${DUCKDB_WORK}/caller-databases/${domain}")
  file(GLOB_RECURSE database_files RELATIVE "${database_root}" "${database_root}/*")
  if(NOT "index.duckdb" IN_LIST database_files)
    message(FATAL_ERROR "Recovery consumer did not retain an actual caller database")
  endif()
  set(database_hashes "")
  foreach(path IN LISTS database_files)
    file(SHA256 "${database_root}/${path}" hash)
    list(APPEND database_hashes "${path}|${hash}")
  endforeach()
  string(JSON count LENGTH "${receipt_json}" files)
  math(EXPR last "${count} - 1")
  file(WRITE "${runtime}/caller-owned" "not owned by the receipt\n")
  set(license "${DUCKDB_PREFIX}/share/licenses/symphony-${id}/${version}/DuckDB-LICENSE.MIT")
  file(READ "${license}" original_license)
  file(APPEND "${license}" "tampered\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DINSTALL_PREFIX=${DUCKDB_PREFIX}"
    -P "${DUCKDB_WORK}/build/${id}/uninstall.cmake" RESULT_VARIABLE refused OUTPUT_VARIABLE refusal ERROR_VARIABLE refusal_error)
  file(WRITE "${license}" "${original_license}")
  file(WRITE "${DUCKDB_WORK}/logs/${domain}-uninstall-refusal.log" "${refusal}\n${refusal_error}")
  if(refused EQUAL 0 OR NOT EXISTS "${executable}" OR NOT EXISTS "${receipt}")
    message(FATAL_ERROR "Tampered receipt-owned content was not refused before removal")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DINSTALL_PREFIX=${DUCKDB_PREFIX}"
    -P "${DUCKDB_WORK}/build/${id}/uninstall.cmake" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(WRITE "${DUCKDB_WORK}/logs/${domain}-uninstall.log" "${output}\n${error}")
  if(NOT status EQUAL 0 OR EXISTS "${receipt}")
    message(FATAL_ERROR "Exact receipt-owned uninstall failed: ${error}")
  endif()
  foreach(index RANGE 0 ${last})
    string(JSON path GET "${receipt_json}" files ${index} path)
    if(EXISTS "${DUCKDB_PREFIX}/${path}" OR IS_SYMLINK "${DUCKDB_PREFIX}/${path}")
      message(FATAL_ERROR "Receipt-owned file remains after uninstall: ${path}")
    endif()
  endforeach()
  file(READ "${runtime}/caller-owned" caller_owned)
  file(SHA256 "${caller_data}/retained" after_hash)
  if(NOT caller_owned STREQUAL "not owned by the receipt\n" OR NOT after_hash STREQUAL caller_hash)
    message(FATAL_ERROR "Package removal changed caller-owned data")
  endif()
  foreach(binding IN LISTS database_hashes)
    string(REPLACE "|" ";" parts "${binding}")
    list(GET parts 0 path)
    list(GET parts 1 expected)
    file(SHA256 "${database_root}/${path}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Package removal changed retained caller database: ${path}")
    endif()
  endforeach()
  file(WRITE "${DUCKDB_WORK}/evidence/${domain}-retained-database-hashes.txt" "${database_hashes}\n")
  message(STATUS "PASS ${id}: adjacent loader, missing-library refusal, tamper refusal, exact removal and caller-data preservation")
endforeach()
