cmake_minimum_required(VERSION 3.25)
foreach(key DUCKDB_ROOT DUCKDB_LIBRARY)
  file(STRINGS "${DUCKDB_CONFIGURED_BUILD}/CMakeCache.txt" declaration REGEX "^${key}:[^=]+=")
  string(REGEX REPLACE "^[^=]+=" "" ${key} "${declaration}")
endforeach()
file(MAKE_DIRECTORY "${DUCKDB_NEGATIVE_WORK}/source" "${DUCKDB_NEGATIVE_WORK}/inputs")
file(COPY "${DUCKDB_ROOT}/duckdb.h" "${DUCKDB_ROOT}/LICENSE" "${DUCKDB_ROOT}/THIRD_PARTY_LICENSES.txt"
  DESTINATION "${DUCKDB_NEGATIVE_WORK}/inputs")
file(COPY "${DUCKDB_REPOSITORY}/modules/scv-graph-duckdb-connector/DUCKDB-PROVENANCE.json"
  DESTINATION "${DUCKDB_NEGATIVE_WORK}/source")
file(WRITE "${DUCKDB_NEGATIVE_WORK}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.25)
project(DependencyAdmission LANGUAGES NONE)
set(CMAKE_SYSTEM_NAME "${TEST_SYSTEM}")
set(CMAKE_SYSTEM_PROCESSOR "${TEST_PROCESSOR}")
include("${TEST_HELPER}")
symphony_duckdb_dependency(pinned)
]=])
execute_process(COMMAND uname -m OUTPUT_VARIABLE processor OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
function(check name expected pattern)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${DUCKDB_NEGATIVE_WORK}/source"
    -B "${DUCKDB_NEGATIVE_WORK}/${name}" "-DTEST_SYSTEM=${CMAKE_HOST_SYSTEM_NAME}"
    "-DTEST_PROCESSOR=${processor}" "-DTEST_HELPER=${DUCKDB_REPOSITORY}/cmake/SymphonyDuckDBDependency.cmake"
    "-DDUCKDB_ROOT=${DUCKDB_NEGATIVE_WORK}/inputs" "-DDUCKDB_LIBRARY=${DUCKDB_LIBRARY}" ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(WRITE "${DUCKDB_NEGATIVE_WORK}/${name}.log" "${output}\n${error}")
  if(expected STREQUAL "pass")
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Valid pinned input failed: ${error}")
    endif()
  elseif(status EQUAL 0 OR NOT "${output}\n${error}" MATCHES "${pattern}")
    message(FATAL_ERROR "Expected dependency refusal ${name} absent: ${output}\n${error}")
  endif()
  message(STATUS "PASS dependency admission: ${name}")
endfunction()
check(valid pass "")
check(windows refuse "native macOS and Linux only" -DTEST_SYSTEM=Windows)
check(unknown-architecture refuse "Unreviewed DuckDB architecture" -DTEST_PROCESSOR=riscv64)
if(processor MATCHES "^(arm64|aarch64)$")
  set(other x86_64)
else()
  set(other arm64)
endif()
check(wrong-architecture refuse "Pinned DuckDB library differs" "-DTEST_PROCESSOR=${other}")
file(APPEND "${DUCKDB_NEGATIVE_WORK}/inputs/duckdb.h" "tamper")
check(changed-header refuse "Pinned DuckDB dependency differs: duckdb.h")
file(COPY_FILE "${DUCKDB_ROOT}/duckdb.h" "${DUCKDB_NEGATIVE_WORK}/inputs/duckdb.h")
file(REMOVE "${DUCKDB_NEGATIVE_WORK}/inputs/THIRD_PARTY_LICENSES.txt")
check(missing-notices refuse "Missing regular pinned DuckDB input: THIRD_PARTY_LICENSES.txt")
file(COPY_FILE "${DUCKDB_ROOT}/THIRD_PARTY_LICENSES.txt" "${DUCKDB_NEGATIVE_WORK}/inputs/THIRD_PARTY_LICENSES.txt")
file(REMOVE "${DUCKDB_NEGATIVE_WORK}/inputs/duckdb.h")
execute_process(COMMAND mkfifo "${DUCKDB_NEGATIVE_WORK}/inputs/duckdb.h" COMMAND_ERROR_IS_FATAL ANY)
check(fifo-header refuse "not a regular non-symlink file")
file(REMOVE "${DUCKDB_NEGATIVE_WORK}/inputs/duckdb.h")
file(COPY_FILE "${DUCKDB_ROOT}/duckdb.h" "${DUCKDB_NEGATIVE_WORK}/inputs/duckdb.h")
file(CREATE_LINK "${DUCKDB_LIBRARY}" "${DUCKDB_NEGATIVE_WORK}/library-link" SYMBOLIC)
check(symlink-library refuse "exact regular DuckDB shared library" "-DDUCKDB_LIBRARY=${DUCKDB_NEGATIVE_WORK}/library-link")
message(STATUS "PASS 8 pinned dependency admission cases")
