cmake_minimum_required(VERSION 3.30)
# A source-bound inventory for human scope review, never a release approval.
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
find_package(Git REQUIRED)

function(read_source output_commit output_tree)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${repo}" status --porcelain --untracked-files=all
    RESULT_VARIABLE status OUTPUT_VARIABLE dirty ERROR_VARIABLE error)
  if(NOT status EQUAL 0 OR NOT dirty STREQUAL "")
    message(FATAL_ERROR "Release review requires a clean committed checkout")
  endif()
  foreach(kind commit tree)
    if(kind STREQUAL "commit")
      set(revision HEAD)
    else()
      set(revision "HEAD^{tree}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${repo}" rev-parse --verify "${revision}"
      RESULT_VARIABLE status OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_VARIABLE error)
    if(NOT status EQUAL 0 OR NOT value MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "Cannot bind source ${kind}")
    endif()
    set(${output_${kind}} "${value}" PARENT_SCOPE)
  endforeach()
endfunction()

if(NOT DEFINED RELEASE_REVIEW_OUTPUT OR NOT IS_ABSOLUTE "${RELEASE_REVIEW_OUTPUT}")
  message(FATAL_ERROR "Select an absolute new RELEASE_REVIEW_OUTPUT outside the checkout")
endif()
get_filename_component(parent "${RELEASE_REVIEW_OUTPUT}" DIRECTORY)
if(NOT IS_DIRECTORY "${parent}")
  message(FATAL_ERROR "Review output parent must already exist")
endif()
file(REAL_PATH "${parent}" parent)
get_filename_component(name "${RELEASE_REVIEW_OUTPUT}" NAME)
set(destination "${parent}/${name}")
cmake_path(IS_PREFIX repo "${destination}" NORMALIZE inside)
if(inside OR EXISTS "${destination}" OR IS_SYMLINK "${destination}")
  message(FATAL_ERROR "Review output must be new and outside the checkout")
endif()
read_source(source_commit source_tree)
foreach(check mvp-dependencies release-qualification)
  execute_process(COMMAND "${CMAKE_COMMAND}" -P "${repo}/tests/${check}/verify.cmake"
    WORKING_DIRECTORY "${repo}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Source map verification failed: ${check}")
  endif()
endforeach()
file(READ "${repo}/cmake/mvp-dependencies.json" map)
file(SHA256 "${repo}/cmake/mvp-dependencies.json" map_digest)
file(READ "${CMAKE_CURRENT_LIST_DIR}/plan.json" plan)
file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/plan.json" plan_digest)
set(packet "{\"format_version\":1,\"state\":\"scope_review_only\",\"release_acceptance_complete\":false,\"publication_authorized\":false,\"selected_components\":null,\"promised_provider_operations\":null,\"reviewer\":null,\"reviewed_at\":null}")
string(JSON packet SET "${packet}" source_commit "\"${source_commit}\"")
string(JSON packet SET "${packet}" source_tree "\"${source_tree}\"")
string(JSON packet SET "${packet}" dependency_map_sha256 "\"${map_digest}\"")
string(JSON packet SET "${packet}" acceptance_plan_sha256 "\"${plan_digest}\"")
foreach(field component_roots native_components native_build_order go_modules swift_provider external_dependencies)
  string(JSON value GET "${map}" "${field}")
  string(JSON packet SET "${packet}" "${field}" "${value}")
endforeach()
string(JSON profile_path GET "${map}" platform_profile_catalog)
if(NOT profile_path STREQUAL "cmake/mvp-platform-profiles.json")
  message(FATAL_ERROR "Unexpected platform catalog path; review the selected source contract")
endif()
file(READ "${repo}/${profile_path}" profiles)
file(SHA256 "${repo}/${profile_path}" profiles_digest)
string(JSON packet SET "${packet}" platform_profile_catalog "${profiles}")
string(JSON packet SET "${packet}" platform_profile_catalog_sha256 "\"${profiles_digest}\"")
foreach(field required_profiles required_scenarios report_fields)
  string(JSON value GET "${plan}" "${field}")
  string(JSON packet SET "${packet}" "${field}" "${value}")
endforeach()
string(JSON inputs GET "${plan}" required_inputs)
string(JSON count LENGTH "${inputs}")
set(required "{}")
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
  string(JSON name GET "${inputs}" ${index})
  string(JSON required SET "${required}" "${name}" null)
endforeach()
string(JSON packet SET "${packet}" required_inputs "${required}")
read_source(final_commit final_tree)
if(NOT final_commit STREQUAL source_commit OR NOT final_tree STREQUAL source_tree)
  message(FATAL_ERROR "Source changed during review preparation")
endif()
file(WRITE "${destination}" "${packet}\n")
message(STATUS "Prepared scope review for ${source_commit}; no acceptance or publication approval")
