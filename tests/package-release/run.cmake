function(run name expected)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
    OUTPUT_FILE "${work}/logs/${name}.log" ERROR_FILE "${work}/logs/${name}.log")
  if(expected STREQUAL "pass" AND NOT result STREQUAL "0")
    message(FATAL_ERROR "${name} failed; see ${work}/logs/${name}.log")
  elseif(expected STREQUAL "fail" AND result STREQUAL "0")
    message(FATAL_ERROR "${name} unexpectedly succeeded")
  endif()
  set(cases "${cases};${name}" PARENT_SCOPE)
  string(JSON count LENGTH "${case_results}")
  string(JSON updated SET "${case_results}" ${count}
    "{\"name\":\"${name}\",\"expected\":\"${expected}\",\"passed\":true}")
  set(case_results "${updated}" PARENT_SCOPE)
endfunction()
function(expect_log name diagnostic)
  file(READ "${work}/logs/${name}.log" output)
  if(NOT output MATCHES "${diagnostic}")
    message(FATAL_ERROR "${name} did not report its intended refusal: ${diagnostic}")
  endif()
endfunction()
