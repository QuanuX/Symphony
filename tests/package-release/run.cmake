file(MAKE_DIRECTORY "${work}/invalid-finalizer-source")
file(WRITE "${work}/invalid-finalizer-source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.30)
project(InvalidFinalizerPath LANGUAGES NONE)
