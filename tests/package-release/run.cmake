file(READ "${work}/candidate/candidate.json" inventory)
# A valid signature authenticates bytes, not a valid descriptor. Sign these
# malformed fixtures directly so the normal signing helper cannot mask a
# missing verifier admission check. Each refusal must name the shape defect.
foreach(malformed IN ITEMS source-injection boolean-string boolean-null size-fraction
    size-string wrong-hash invalid-target duplicate-file duplicate-component unknown-field)
  set(diagnostic "Candidate digest/source identity is malformed")
  if(malformed STREQUAL "source-injection")
    release_quote("bad\",\"publication_authorized\":true,\"source_commit\":\"bad" injected)
    string(JSON malformed_inventory SET "${inventory}" source commit "${injected}")
  elseif(malformed STREQUAL "boolean-string")
    string(JSON malformed_inventory SET "${inventory}" publication_authorized "\"false\"")
    set(diagnostic "must have JSON type BOOLEAN")
  elseif(malformed STREQUAL "boolean-null")
    string(JSON malformed_inventory SET "${inventory}" publication_authorized null)
    set(diagnostic "must have JSON type BOOLEAN")
  elseif(malformed STREQUAL "size-fraction")
    string(JSON malformed_inventory SET "${inventory}" artifact size 1.5)
    set(diagnostic "Candidate byte size must be a portable nonnegative integer")
  elseif(malformed STREQUAL "size-string")
    string(JSON malformed_inventory SET "${inventory}" artifact size "\"4096\"")
    set(diagnostic "must have JSON type NUMBER")
  elseif(malformed STREQUAL "wrong-hash")
    string(JSON malformed_inventory SET "${inventory}" artifact sha256 "\"not-a-sha256\"")
  elseif(malformed STREQUAL "invalid-target")
    string(JSON malformed_inventory SET "${inventory}" platform os "\"windows\"")
    set(diagnostic "Candidate platform identity is invalid")
  elseif(malformed STREQUAL "unknown-field")
    string(JSON malformed_inventory SET "${inventory}" unexpected false)
    set(diagnostic "Candidate object has unexpected/missing fields")
  else()
    if(malformed STREQUAL "duplicate-file")
      set(array files)
    else()
      set(array components)
    endif()
    string(JSON row GET "${inventory}" "${array}" 0)
    string(JSON length LENGTH "${inventory}" "${array}")
    string(JSON malformed_inventory SET "${inventory}" "${array}" ${length} "${row}")
    set(diagnostic "Candidate inventory has a duplicate identity/path")
  endif()
  set(malformed_root "${work}/malformed-${malformed}")
  file(MAKE_DIRECTORY "${malformed_root}")
  file(WRITE "${malformed_root}/candidate.json" "${malformed_inventory}\n")
  if(malformed STREQUAL "source-injection")
    run(sign-refuses-malformed fail "${CMAKE_COMMAND}" "-DRELEASE_CANDIDATE=${malformed_root}"
      "-DRELEASE_SIGN_KEY=${work}/test-key" -P "${repository}/cmake/release/SignCandidate.cmake")
    expect_log(sign-refuses-malformed "${diagnostic}")
    if(EXISTS "${malformed_root}/candidate.json.sig")
      message(FATAL_ERROR "Signing helper signed a malformed descriptor")
    endif()
  endif()
  run("sign-malformed-${malformed}" pass "${keygen}" -Y sign -f "${work}/test-key"
    -n symphony-release "${malformed_root}/candidate.json")
  run("verify-malformed-${malformed}" fail ${verify}
    "-DRELEASE_CANDIDATE=${malformed_root}"
    "-DRELEASE_VERIFICATION_OUTPUT=${work}/logs/rejected-${malformed}.json"
    -P "${repository}/cmake/release/VerifyCandidate.cmake")
  expect_log("verify-malformed-${malformed}" "${diagnostic}")
  if(EXISTS "${work}/logs/rejected-${malformed}.json")
    message(FATAL_ERROR "Malformed signed descriptor produced a verification record")
  endif()
endforeach()
foreach(field IN ITEMS os architecture)
  # Re-sign the deliberately wrong target: this must fail target admission,
  # not signature verification, even when the same fixture key attests it.
  file(COPY "${work}/candidate/" DESTINATION "${work}/signed-wrong-${field}")
  string(JSON wrong_inventory SET "${inventory}" platform "${field}" "\"${other_${field}}\"")
  file(WRITE "${work}/signed-wrong-${field}/candidate.json" "${wrong_inventory}\n")
  file(REMOVE "${work}/signed-wrong-${field}/candidate.json.sig")
  run("sign-wrong-${field}" pass "${CMAKE_COMMAND}" "-DRELEASE_CANDIDATE=${work}/signed-wrong-${field}"
    "-DRELEASE_SIGN_KEY=${work}/test-key" -P "${repository}/cmake/release/SignCandidate.cmake")
  run("verify-wrong-${field}" fail ${verify} "-DRELEASE_CANDIDATE=${work}/signed-wrong-${field}"
    "-DRELEASE_UNPACKED_ROOT=${unpacked}" -P "${repository}/cmake/release/VerifyCandidate.cmake")
  expect_log("verify-wrong-${field}" "Unpacked receipt target differs from signed platform")
endforeach()
