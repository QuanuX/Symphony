run(managed-root-install fail "${CMAKE_COMMAND}" "-DSYMPHONY_PACKAGE_STAGE_ROOT=${stage}" "-DCMAKE_INSTALL_PREFIX=${stage}" -P "${work}/build-1.0.0/cmake_install.cmake")
